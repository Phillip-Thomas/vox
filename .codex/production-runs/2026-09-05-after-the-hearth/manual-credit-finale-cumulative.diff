+// --- Ordered physical coverage --------------------------------------------------------
+//
+// ONE defect, one correction, and it is NOT a bank. The frontier rule credited a
+// frame only when the body's whole projection fell under `previousUnits +
+// displacement`, so an ordinary rounded corner — walk through the vertex,
+// overshoot it, turn onto the next leg already a little way along — left a
+// residual that no later frame could ever clear, because from then on both the
+// projection and the ceiling advanced at exactly the same rate. Measured live
+// (`producer-common-entry-crossing-review.json`, call 298 of
+// `verifier/captures/common-entry-crossing/run1`): credit exactly 6 at vertex
+// (-44, 51.05, 16), foot 0.2742 past it, projection 6.2944830004 against a
+// ceiling of 6.1635971455, frozen from there on.
+//
+// The correction is to measure what the body PHYSICALLY COVERED, in order, from
+// its real previous foot to its real current foot, rather than to hand it an
+// allowance it may spend anywhere:
+//
+//   * A vertex is REACHED only by an actual motion that crosses its incoming
+//     plane — previous foot strictly short of it, current foot at or past it —
+//     AND that passes within the unchanged 0.35 vertex reach of the vertex
+//     itself. Both facts come from the two real feet. Standing on the far side
+//     proves nothing; being the nearest vertex proves nothing.
+//   * Vertices are reached STRICTLY IN ORDER, one route index at a time. A body
+//     that cut a corner has not reached it, so nothing beyond it can be covered
+//     however far or long it walks afterwards, and the z 15.82 refusal and its
+//     walk-back-and-re-traverse repair are exactly preserved.
+//   * Within the leg it has actually reached, credit is the body's own position
+//     on that leg, clamped to the leg and to the corridor, and monotone. It is
+//     the ground under the body, so it cannot be pumped: a stationary, lateral,
+//     late-leg or far-end body projects to the same arc however long it wiggles,
+//     and nothing at all can be earned past the next unreached vertex.
+//   * A motion is only usable while the chain of real feet is unbroken. An
+//     unsupported, unreferenced, reset, respawned or freshly seeded frame drops
+//     the previous foot, and a null previous foot is never replaced by the
+//     current one — a gap is a gap, and no crossing may be claimed across it.
+//
+// Nothing is granted, no timer, tolerance, corridor, vertex, C or arrival rule
+// changes here, and `routeProgressUnits` above is untouched.
+
+/** Unchanged route-vertex reach: how close the body must pass to round a vertex. */
+const ROUTE_VERTEX_REACH_UNITS = 0.35;
+
+/**
+ * Live, non-persisted physical coverage of the common route.
+ *
+ * `units` mirrors the credited span, `reachedVertex` is the last route vertex
+ * the body actually crossed and passed, and `foot` is its real last position.
+ * None of it is stored, restored or trusted across a break: see
+ * `syncedRouteCoverage`.
+ */
+export interface RouteCoverage {
+  readonly units: number;
+  readonly reachedVertex: number;
+  readonly foot: CommonGroundPoint | null;
+}
+
+export const NO_ROUTE_COVERAGE: RouteCoverage = Object.freeze({
+  units: 0,
+  reachedVertex: 0,
+  foot: null
+});
+
+/** Arc length from the head of the route to `index`. */
+function arcAtVertex(route: readonly CommonGroundPoint[], index: number): number {
+  let arc = 0;
+  for (let i = 1; i <= index && i < route.length; i += 1) {
+    arc += distanceBetween(route[i - 1], route[i]);
+  }
+  return arc;
+}
+
+/**
+ * The last vertex a span of `units` PROVES was rounded.
+ *
+ * Strictly below the credit, deliberately. Credit sitting exactly on a vertex's
+ * arc does not prove that vertex was passed — the recorded early cut pins at
+ * exactly 4 without ever coming within 0.35 of (-42, ., 16) — so a span that has
+ * to be re-derived, rather than carried live, always re-derives the conservative
+ * answer and makes the body cross the corner again.
+ */
+function provenVertex(route: readonly CommonGroundPoint[], units: number): number {
+  let proven = 0;
+  let arc = 0;
+  for (let index = 1; index < route.length; index += 1) {
+    arc += distanceBetween(route[index - 1], route[index]);
+    if (arc + 1e-9 < units) proven = index;
+  }
+  return proven;
+}
+
+/**
+ * Coverage re-seeded against the authoritative credited span.
+ *
+ * The snapshot owns the units. Whenever they differ from what this state last
+ * saw — a resumed leg, a migrated save, a rewritten span, an actor or world
+ * swap — the reached vertex is re-derived conservatively and the foot chain is
+ * dropped, so nothing earned elsewhere is inherited as permission to move on.
+ */
+export function syncedRouteCoverage(
+  route: readonly CommonGroundPoint[],
+  coverage: RouteCoverage,
+  units: number
+): RouteCoverage {
+  if (Math.abs(coverage.units - units) <= 1e-9) return coverage;
+  return { units, reachedVertex: provenVertex(route, units), foot: null };
+}
+
+/** Signed distance along the incoming leg, measured from `route[index]`. */
+function planeOffset(
+  route: readonly CommonGroundPoint[],
+  index: number,
+  body: CommonGroundPoint
+): number {
+  const from = route[index - 1];
+  const at = route[index];
+  const length = distanceBetween(from, at);
+  if (!(length > 0)) return 0;
+  return ((body.x - at.x) * (at.x - from.x)
+    + (body.y - at.y) * (at.y - from.y)
+    + (body.z - at.z) * (at.z - from.z)) / length;
+}
+
+/** Closest approach of the real motion `from`->`to` to `point`. */
+function segmentApproach(
+  from: CommonGroundPoint,
+  to: CommonGroundPoint,
+  point: CommonGroundPoint
+): number {
+  const dx = to.x - from.x;
+  const dy = to.y - from.y;
+  const dz = to.z - from.z;
+  const lengthSq = dx * dx + dy * dy + dz * dz;
+  if (!(lengthSq > 0)) return distanceBetween(from, point);
+  const t = Math.max(0, Math.min(1,
+    ((point.x - from.x) * dx + (point.y - from.y) * dy + (point.z - from.z) * dz) / lengthSq));
+  return distanceBetween(point, {
+    x: from.x + dx * t,
+    y: from.y + dy * t,
+    z: from.z + dz * t
+  });
+}
+
+/**
+ * Position on the leg out of `reachedVertex`, or null when the body is not on it.
+ *
+ * The arc can never leave that leg: the far vertex bounds it until an actual
+ * crossing reaches it, which is why no amount of movement beyond an unreached
+ * corner is worth anything.
+ */
+function coveredOnReachedLeg(
+  route: readonly CommonGroundPoint[],
+  reachedVertex: number,
+  body: CommonGroundPoint,
+  corridorRadius: number
+): number | null {
+  const next = reachedVertex + 1;
+  if (next >= route.length) return arcAtVertex(route, reachedVertex);
+  const from = route[reachedVertex];
+  const to = route[next];
+  const segment = distanceBetween(from, to);
+  if (!(segment > 0)) return null;
+  const dx = to.x - from.x;
+  const dy = to.y - from.y;
+  const dz = to.z - from.z;
+  const t = Math.max(0, Math.min(1,
+    ((body.x - from.x) * dx + (body.y - from.y) * dy + (body.z - from.z) * dz)
+      / (segment * segment)));
+  const closest = { x: from.x + dx * t, y: from.y + dy * t, z: from.z + dz * t };
+  if (distanceBetween(body, closest) > corridorRadius) return null;
+  return arcAtVertex(route, reachedVertex) + segment * t;
+}
+
+/**
+ * Next credited span, from the body's ACTUAL motion over the route.
+ *
+ * `coverage.foot` is the real previous foot and is never synthesised from the
+ * current one. With no previous foot the motion is unknown, so this update
+ * records the foot and credits nothing at all.
+ */
+export function nextRouteCoverage(
+  route: readonly CommonGroundPoint[],
+  body: CommonGroundPoint,
+  displacementUnits: number,
+  coverage: RouteCoverage,
+  corridorRadius = 2.5,
+  vertexReach = ROUTE_VERTEX_REACH_UNITS
+): RouteCoverage {
+  const foot = { x: body.x, y: body.y, z: body.z };
+  const previous = coverage.foot;
+  // NO MOTION, NO COVERAGE, and no chain either: a body that has not moved has
+  // covered nothing, however long it stands there and however often it is
+  // sampled. Standing at C is still worth exactly zero.
+  if (!previous || !(displacementUnits > 0)) {
+    return { units: coverage.units, reachedVertex: coverage.reachedVertex, foot };
+  }
+
+  // ONE VERTEX AT A TIME, IN ORDER, each by an actual crossing of its incoming
+  // plane made by this very motion, each within the unchanged vertex reach, AND
+  // each with the incoming leg ACTUALLY COVERED up to that vertex under the same
+  // strict frontier accounting. Crossing a corner is not a receipt for the leg
+  // that led to it: a body that was dropped onto the last metre of the leg, or
+  // that carries a saved half unit from somewhere else entirely, crosses the
+  // plane just as convincingly as one that walked, so the crossing is refused
+  // here and the corner is simply not certified.
+  let reachedVertex = coverage.reachedVertex;
+  let certifiedUnits = coverage.units;
+  let certifiedCorner = false;
+  while (reachedVertex + 1 < route.length) {
+    const next = reachedVertex + 1;
+    const crossed = planeOffset(route, next, previous) < 0
+      && planeOffset(route, next, foot) >= 0;
+    if (!crossed) break;
+    if (segmentApproach(previous, foot, route[next]) > vertexReach) break;
+    const incomingArc = arcAtVertex(route, next);
+    if (certifiedUnits + displacementUnits + 1e-9 < incomingArc) break;
+    reachedVertex = next;
+    certifiedUnits = Math.max(certifiedUnits, incomingArc);
+    certifiedCorner = true;
+  }
+
+  // ORDINARY LEG MOVEMENT STAYS STRICT. The body's projection on the leg is only
+  // credited when the frontier could honestly have advanced that far in this one
+  // update; an arbitrary later projection neither maxes nor creeps toward the
+  // frontier, which is what keeps a seeded foot at (-42, ., 13) worth 0 until the
+  // start of the leg is physically returned to and re-traversed.
+  //
+  // The ONE exception is the corner just certified above, where the incoming leg
+  // was covered to the vertex and the vertex was really rounded: there the
+  // outgoing projection settles the LOCAL residual that corner-cutting geometry
+  // creates (call 298: credit 6 at (-44, 51.05, 16), projection 6.2944830004
+  // against a per-update ceiling of 6.1635971455). It is bounded by the next
+  // unreached vertex, and the very next ordinary update is strict again.
+  const onLeg = coveredOnReachedLeg(route, reachedVertex, foot, corridorRadius);
+  let covered = certifiedUnits;
+  if (onLeg !== null && onLeg > covered
+    && (certifiedCorner || onLeg <= coverage.units + displacementUnits + 1e-9)) {
+    covered = onLeg;
+  }
+  return { units: covered, reachedVertex, foot };
 }
 
