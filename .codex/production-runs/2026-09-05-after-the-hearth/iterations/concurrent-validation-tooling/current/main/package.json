{
  "name": "voxel-game",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@react-three/drei": "^10.2.0",
    "@react-three/fiber": "^9.1.2",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.1.0",
    "firebase": "^12.15.0",
    "n8ao": "^1.10.2",
    "postprocessing": "^6.38.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.5.2",
    "playwright-core": "^1.61.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run catalog:check && npm run scene:av:check && npm run creative:workflow:check && npm run chapter:registry:check && npm run chapter:journey:check && npm run typecheck && npm run preview:check && npm run audio:diagnostic-check && npm run story:ladder:check && npm run guidance:target-check && npm run story:authority && npm run test && npm run audio:check && npm run build",
    "catalog:check": "node ../scripts/generate-economy-catalog.mjs --check",
    "scene:av:generate": "node tools/generate-scene-av-runtime.mjs",
    "scene:av:check": "node tools/generate-scene-av-runtime.mjs --check",
    "score:soak:pure": "node tools/run-pure-soak.mjs",
    "score:soak": "node score-soak-probe.mjs soak",
    "score:audition": "node score-soak-probe.mjs excerpts",
    "score:fps": "node fps-score-probe.mjs",
    "audio:check": "node tools/audio-check-probe.mjs",
    "audio:diagnostic-check": "node --test tools/lib/audioDiagnosticIdentity.test.mjs",
    "audio:baseline": "node tools/audio-check-probe.mjs baseline",
    "atlas:smoke": "node tools/procedural-atlas.mjs --mode=smoke",
    "atlas:showcase": "node tools/procedural-atlas.mjs --mode=showcase",
    "atlas:baseline": "node tools/procedural-atlas.mjs --mode=baseline",
    "atlas:perf": "node tools/procedural-atlas.mjs --mode=perf",
    "atlas:fauna": "node tools/fauna-atlas.mjs",
    "fauna:budget": "vite-node tools/fauna-geometry-budget.ts",
    "primitive:probe": "node tools/primitive-loop-probe.mjs",
    "primitive:probe:headed": "node tools/primitive-loop-probe.mjs --headed",
    "story:emergent:probe": "node tools/emergent-story-runtime-probe.mjs",
    "story:objective-hud:probe": "node tools/objective-hud-probe.mjs",
    "story:mobile-hud:capture": "node tools/mobile-hud-capture.mjs",
    "story:hud:sweep": "node tools/hud-overlap-sweep.mjs",
    "verify:visual": "node tools/visual-gate.mjs",
    "perf:boot": "node tools/boot-stall-probe.mjs",
    "perf:boot:attrib": "node tools/boot-attribution.mjs",
    "perf:seams": "node tools/beat-seam-probe.mjs",
    "story:ladder:trace": "node tools/story-ladder-trace.mjs",
    "story:ux:check": "vitest run src/story/ux",
    "chapter:registry:check": "node tools/chapter-registry-generate.mjs --check && node tools/chapter-registry-gate.mjs",
    "chapter:registry:smoke": "node tools/chapter-registry-gate.mjs --self-test",
    "chapter:journey:check": "node tools/chapter-journey-contract-gate.mjs",
    "chapter:journey:smoke": "node tools/chapter-journey-contract-gate.mjs --self-test",
    "chapter:journey:probe": "node tools/chapter-journey-probe.mjs",
    "chapter:journey:probe:smoke": "node tools/chapter-journey-probe.mjs --self-test",
    "chapter:accept": "node tools/chapter-acceptance.mjs",
    "chapter:evidence": "node tools/chapter-evidence.mjs",
    "deploy": "node tools/deploy.mjs",
    "chapter:accept:smoke": "node tools/chapter-acceptance.mjs --self-test",
    "chapter:accept:workflow": "node tools/creative-chapter-acceptance-workflow.mjs",
    "chapter:accept:workflow:smoke": "node tools/creative-chapter-acceptance-workflow-smoke.mjs",
    "creative:gate": "node tools/creative-triad-gate.mjs",
    "creative:smoke": "node tools/creative-triad-gate.mjs --self-test",
    "creative:workflow:check": "node tools/creative-workflow-config-gate.mjs",
    "creative:workflow:smoke": "node tools/creative-workflow-config-gate.mjs --self-test",
    "story:authority": "node tools/story-authority-gate.mjs",
    "story:authority:smoke": "node tools/story-authority-gate.mjs --self-test",
    "chapter:registry:generate": "node tools/chapter-registry-generate.mjs",
    "preview:check": "node --test tools/lib/previewSnapshot.test.mjs tools/lib/previewServer.test.mjs",
    "story:ladder:check": "node --test tools/lib/storyLadderDiff.test.mjs",
    "guidance:target-check": "node --test tools/lib/guidanceTargets.test.mjs",
    "creative:repair:check": "node tools/repair-check.mjs",
    "creative:repair:test": "node --test tools/repair-check.test.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "pointerlock-controls",
    "game",
    "minecraft"
  ],
  "description": "Mini Minecraft implementation."
}
