+    slot.walkedUnits = MAX_TRACE_LENGTH_UNITS;
+    slot.pendingUnits = MAX_TRACE_LENGTH_UNITS - slot.samples[slot.samples.length - 1].walkedAt;
+    slot.atCapacity = true;
+    return;
+  }
+  slot.walkedUnits = next;
+  slot.pendingUnits += displacement;
