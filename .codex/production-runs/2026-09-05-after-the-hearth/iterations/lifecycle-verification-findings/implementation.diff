+/** The heading a bar is drawn along, folded onto [0, pi) so ±direction agree. */
+function heading(glyph: { angle: number }): number {
+  const wrapped = ((glyph.angle % Math.PI) + Math.PI) % Math.PI;
+  return Math.round(wrapped * 1e6) / 1e6;
+}
