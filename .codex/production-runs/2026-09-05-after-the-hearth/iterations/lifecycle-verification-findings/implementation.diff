+    _scale.set(glyph.lengthUnits, TRACE_GLYPH_THICKNESS, glyph.widthUnits);
+    mesh.setMatrixAt(index, _matrix.compose(_position, _quaternion, _scale));
+    index += 1;
+  }
+  return index;
+}
