+      phase: 'idle',
+      accepted: null,
+      working: null,
+      witness: null,
+      hold: { reason: null, atIndex: -1 },
+      approached: false,
+      testedIndex: -1,
+      workerPose: null,
+      revisionReady: false
+    },
+    common: {
+      stage: 'none',
+      terraUnits: 0,
+      comparisonProved: false,
