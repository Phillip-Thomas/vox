+    // The hardware sample: centre 52.79 over an authored plane of 51.05.
+    standCapsuleCentreAt({ x: -26.13, y: 52.79, z: 12 });
+    const feet = commonGroundPlayerPose();
+    expect(feet.y).toBeCloseTo(51.05 - MEASURED_REST_RESIDUAL, 6);
