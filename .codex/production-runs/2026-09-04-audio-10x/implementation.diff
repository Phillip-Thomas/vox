diff --git a/main/tools/audio-band-edge-probe.mjs b/main/tools/audio-band-edge-probe.mjs
new file mode 100644
index 0000000..117b245
--- /dev/null
+++ b/main/tools/audio-band-edge-probe.mjs
@@ -0,0 +1,185 @@
+// Stage 2 repair (S2-J2): band-energy over time across a submergence edge.
+//
+//   node tools/audio-band-edge-probe.mjs <file.wav> [--from 6] [--to 12]
+//        [--step 0.1] [--out <json>]
+//
+// A blind listener read the dive render's 8 s edge as a "brick-wall lowpass
+// switching in". The music path's submerge filter is slewed (0.42 s entering,
+// 0.65 s leaving, audioCore rampParamAt), so the claim is testable: sample the
+// energy in four bands every `--step` seconds and look at how many steps the
+// high band takes to fall. A switch falls in one step; a slew takes four.
+//
+// Pure Node — no ffmpeg, no numpy. Reads 16-bit or 32-bit-float PCM WAV.
+import fs from 'node:fs';
+
+const args = process.argv.slice(2);
+const file = args.find((a) => !a.startsWith('--'));
+if (!file) {
+  console.error('usage: audio-band-edge-probe.mjs <file.wav> [--from s] [--to s] [--step s] [--out json]');
+  process.exit(2);
+}
+const flag = (name, fallback) => {
+  const i = args.indexOf(`--${name}`);
+  return i >= 0 ? args[i + 1] : fallback;
+};
+const fromS = Number(flag('from', '6'));
+const toS = Number(flag('to', '12'));
+const stepS = Number(flag('step', '0.1'));
+const outFile = flag('out', undefined);
+
+/** Minimal WAV reader: mono-sums every channel, returns Float32 + sample rate. */
+function readWav(path) {
+  const buf = fs.readFileSync(path);
+  if (buf.toString('ascii', 0, 4) !== 'RIFF' || buf.toString('ascii', 8, 12) !== 'WAVE') {
+    throw new Error(`${path} is not a RIFF/WAVE file`);
+  }
+  let offset = 12;
+  let fmt = null;
+  let data = null;
+  while (offset + 8 <= buf.length) {
+    const id = buf.toString('ascii', offset, offset + 4);
+    const size = buf.readUInt32LE(offset + 4);
+    const body = buf.subarray(offset + 8, offset + 8 + size);
+    if (id === 'fmt ') {
+      fmt = {
+        format: body.readUInt16LE(0),
+        channels: body.readUInt16LE(2),
+        sampleRate: body.readUInt32LE(4),
+        bits: body.readUInt16LE(14)
+      };
+    } else if (id === 'data') {
+      data = body;
+    }
+    offset += 8 + size + (size % 2);
+  }
+  if (!fmt || !data) throw new Error('missing fmt or data chunk');
+  const bytes = fmt.bits / 8;
+  const frames = Math.floor(data.length / (bytes * fmt.channels));
+  const out = new Float32Array(frames);
+  for (let f = 0; f < frames; f++) {
+    let sum = 0;
+    for (let c = 0; c < fmt.channels; c++) {
+      const at = (f * fmt.channels + c) * bytes;
+      sum += fmt.format === 3 ? data.readFloatLE(at) : bytes === 2 ? data.readInt16LE(at) / 32768 : data.readInt32LE(at) / 2147483648;
+    }
+    out[f] = sum / fmt.channels;
+  }
+  return { samples: out, sampleRate: fmt.sampleRate };
+}
+
+/** In-place iterative radix-2 FFT on separate real/imag arrays. */
+function fft(re, im) {
+  const n = re.length;
+  for (let i = 1, j = 0; i < n; i++) {
+    let bit = n >> 1;
+    for (; j & bit; bit >>= 1) j ^= bit;
+    j ^= bit;
+    if (i < j) {
+      [re[i], re[j]] = [re[j], re[i]];
+      [im[i], im[j]] = [im[j], im[i]];
+    }
+  }
+  for (let len = 2; len <= n; len <<= 1) {
+    const ang = (-2 * Math.PI) / len;
+    const wr = Math.cos(ang);
+    const wi = Math.sin(ang);
+    for (let i = 0; i < n; i += len) {
+      let cr = 1;
+      let ci = 0;
+      for (let k = 0; k < len / 2; k++) {
+        const ur = re[i + k];
+        const ui = im[i + k];
+        const vr = re[i + k + len / 2] * cr - im[i + k + len / 2] * ci;
+        const vi = re[i + k + len / 2] * ci + im[i + k + len / 2] * cr;
+        re[i + k] = ur + vr;
+        im[i + k] = ui + vi;
+        re[i + k + len / 2] = ur - vr;
+        im[i + k + len / 2] = ui - vi;
+        const nr = cr * wr - ci * wi;
+        ci = cr * wi + ci * wr;
+        cr = nr;
+      }
+    }
+  }
+}
+
+const BANDS = [
+  ['lo', 0, 500],
+  ['mid', 500, 2000],
+  ['hi', 2000, 8000],
+  ['air', 8000, 22050]
+];
+const N = 4096;
+
+const { samples, sampleRate } = readWav(file);
+const window = new Float32Array(N);
+for (let i = 0; i < N; i++) window[i] = 0.5 - 0.5 * Math.cos((2 * Math.PI * i) / (N - 1));
+
+const rows = [];
+for (let t = fromS; t <= toS + 1e-9; t += stepS) {
+  const start = Math.round(t * sampleRate);
+  if (start + N > samples.length) break;
+  const re = new Float64Array(N);
+  const im = new Float64Array(N);
+  for (let i = 0; i < N; i++) re[i] = samples[start + i] * window[i];
+  fft(re, im);
+  const energy = {};
+  for (const [name] of BANDS) energy[name] = 0;
+  for (let k = 1; k < N / 2; k++) {
+    const hz = (k * sampleRate) / N;
+    const mag2 = re[k] * re[k] + im[k] * im[k];
+    for (const [name, lo, hi] of BANDS) {
+      if (hz >= lo && hz < hi) energy[name] += mag2;
+    }
+  }
+  const db = {};
+  for (const [name] of BANDS) db[name] = 10 * Math.log10(Math.max(1e-20, energy[name]));
+  rows.push({ tS: Math.round(t * 1000) / 1000, db });
+}
+
+// Fall time of the `hi` band: from its pre-edge plateau to within 1 dB of its
+// post-edge plateau. That is the number the "brick wall" claim is about.
+const hi = rows.map((r) => r.db.hi);
+const before = hi.slice(0, Math.max(1, Math.floor(rows.length * 0.15)));
+const after = hi.slice(Math.floor(rows.length * 0.75));
+const mean = (a) => a.reduce((s, v) => s + v, 0) / a.length;
+const plateauBefore = mean(before);
+const plateauAfter = mean(after);
+let fellFromS = null;
+let fellToS = null;
+for (const r of rows) {
+  if (fellFromS == null && r.db.hi <= plateauBefore - 1) fellFromS = r.tS;
+  if (fellFromS != null && fellToS == null && r.db.hi <= plateauAfter + 1) fellToS = r.tS;
+}
+const summary = {
+  file,
+  sampleRate,
+  windowSamples: N,
+  windowS: N / sampleRate,
+  stepS,
+  fromS,
+  toS,
+  bands: BANDS.map(([n, lo, h]) => ({ name: n, loHz: lo, hiHz: h })),
+  hiBandPlateauBeforeDb: Math.round(plateauBefore * 100) / 100,
+  hiBandPlateauAfterDb: Math.round(plateauAfter * 100) / 100,
+  hiBandDropDb: Math.round((plateauBefore - plateauAfter) * 100) / 100,
+  hiBandFellFromS: fellFromS,
+  hiBandFellToS: fellToS,
+  hiBandFallS: fellFromS != null && fellToS != null ? Math.round((fellToS - fellFromS) * 1000) / 1000 : null,
+  rows
+};
+
+for (const r of rows) {
+  console.log(
+    `${r.tS.toFixed(2)}s  lo ${r.db.lo.toFixed(1)}  mid ${r.db.mid.toFixed(1)}  hi ${r.db.hi.toFixed(1)}  air ${r.db.air.toFixed(1)}`
+  );
+}
+console.log(
+  `[fall] hi band ${summary.hiBandPlateauBeforeDb} → ${summary.hiBandPlateauAfterDb} dB (${summary.hiBandDropDb} dB) ` +
+    `between ${summary.hiBandFellFromS}s and ${summary.hiBandFellToS}s = ${summary.hiBandFallS}s over ${summary.stepS}s steps ` +
+    `(analysis window ${(summary.windowS * 1000).toFixed(0)} ms)`
+);
+if (outFile) {
+  fs.writeFileSync(outFile, JSON.stringify(summary, null, 2));
+  console.log(`[out] ${outFile}`);
+}
diff --git a/main/tools/audio-check-probe.mjs b/main/tools/audio-check-probe.mjs
new file mode 100644
index 0000000..693a769
--- /dev/null
+++ b/main/tools/audio-check-probe.mjs
@@ -0,0 +1,167 @@
+// Stage 0 audio gate: drives the /score-soak.html harness headless and asserts
+// the combined music+SFX render's health.
+//
+//   node tools/audio-check-probe.mjs            -> the `audio:check` verify step
+//   node tools/audio-check-probe.mjs baseline   -> bed / combined / sfx baselines
+//
+// Owns a fresh HMR-off vite server on an ephemeral port (the machine's inotify
+// budget cannot carry a watching dev server). Exit code 0 = PASS.
+import { chromium } from 'playwright-core';
+import { spawn } from 'node:child_process';
+import os from 'node:os';
+import path from 'node:path';
+import fs from 'node:fs';
+import net from 'node:net';
+
+const mode = process.argv[2] ?? 'check';
+const root = path.dirname(path.dirname(new URL(import.meta.url).pathname));
+/**
+ * Wall budget for the whole gate, seconds. Stage 0 measured ~17 s and set 25;
+ * the Stage 1 instrument (5 pad voices × 6 saws, three drives, LR4 crossover,
+ * stereo rooms) renders 90 s in ~13 s per pass and the two-pass gate measured
+ * 25.5 s on a loaded box, so the advisory budget is 40 s. The binding checks
+ * are true-peak, finiteness, smoothness, silence and replay determinism.
+ */
+const WALL_BUDGET_S = 40;
+const PAGE_READY_TIMEOUT_MS = 20000;
+const RENDER_TIMEOUT_MS = 180000;
+
+async function serverUp(port) {
+  try {
+    const res = await fetch(`http://localhost:${port}/score-soak.html`);
+    return res.ok;
+  } catch {
+    return false;
+  }
+}
+
+let viteProc = null;
+process.once('exit', () => {
+  if (viteProc && !viteProc.killed) viteProc.kill();
+});
+
+async function freshPort() {
+  return await new Promise((resolve, reject) => {
+    const server = net.createServer();
+    server.unref();
+    server.on('error', reject);
+    server.listen(0, '127.0.0.1', () => {
+      const address = server.address();
+      const port = typeof address === 'object' && address ? address.port : 0;
+      server.close((error) => (error ? reject(error) : resolve(port)));
+    });
+  });
+}
+
+async function startServer(port) {
+  const viteScript = [
+    "import { createServer } from 'vite'",
+    "import react from '@vitejs/plugin-react'",
+    `const server = await createServer({ configFile: false, root: process.cwd(), plugins: [react()], server: { port: ${port}, strictPort: true, hmr: false, watch: null } })`,
+    'await server.listen()',
+    'await new Promise(() => {})'
+  ].join(';');
+  viteProc = spawn(process.execPath, ['--input-type=module', '--eval', viteScript], {
+    cwd: root,
+    stdio: 'ignore',
+    env: { ...process.env, PROBE_NO_HMR: '1' }
+  });
+  for (let i = 0; i < 100; i++) {
+    if (await serverUp(port)) return;
+    await new Promise((r) => setTimeout(r, 300));
+  }
+  throw new Error('vite dev server did not come up');
+}
+
+function fmtLoudness(l) {
+  return (
+    `I=${l.integratedLufs.toFixed(2)} LUFS  S-max=${l.shortTermMaxLufs.toFixed(2)}  ` +
+    `M-max=${l.momentaryMaxLufs.toFixed(2)}  LRA=${l.loudnessRangeLu.toFixed(2)} LU  ` +
+    `TP=${l.truePeakDbtp.toFixed(2)} dBTP  SP=${l.samplePeakDbfs.toFixed(2)} dBFS  ` +
+    `corr=${l.correlation.toFixed(3)}`
+  );
+}
+
+function fmtBands(l) {
+  return `bands=[${l.spectral.bandFractions.map((b) => b.toFixed(3)).join(', ')}] zcr=${l.spectral.meanZeroCrossingRate.toFixed(0)}Hz`;
+}
+
+const pwDir = path.join(os.homedir(), '.cache/ms-playwright');
+const chromeDir = fs
+  .readdirSync(pwDir)
+  .filter((d) => /^chromium-\d+$/.test(d))
+  .sort()
+  .pop();
+const executablePath = path.join(pwDir, chromeDir, 'chrome-linux/chrome');
+
+let pass = true;
+const startedAt = Date.now();
+const probePort = await freshPort();
+await startServer(probePort);
+const browser = await chromium.launch({
+  executablePath,
+  headless: true,
+  args: [
+    '--enable-unsafe-swiftshader',
+    '--use-gl=angle',
+    '--autoplay-policy=no-user-gesture-required',
+    '--mute-audio'
+  ]
+});
+try {
+  const page = await browser.newPage();
+  page.on('pageerror', (e) => {
+    pass = false;
+    console.log(`[pageerror] ${e.message}`);
+  });
+  page.on('console', (m) => {
+    if (m.text().startsWith('[soak-page]')) console.log(m.text());
+  });
+  await page.goto(`http://localhost:${probePort}/score-soak.html`, { waitUntil: 'load' });
+  await page.waitForFunction(() => Boolean(window.__scoreSoak), null, {
+    timeout: PAGE_READY_TIMEOUT_MS
+  });
+
+  if (mode === 'baseline') {
+    // Stage 0 §7 baselines: what the current floor measures, stem by stem.
+    for (const stem of ['bed', 'combined', 'sfx']) {
+      const r = await page.evaluate(
+        (s) => window.__scoreSoak.renderAudioCheckStem(s),
+        stem
+      );
+      console.log(`\n[${stem}] ${r.seconds.toFixed(1)}s, ${r.bars} bars, ${r.sfxCuesFired} sfx cues`);
+      console.log(`    ${fmtLoudness(r.loudness)}`);
+      console.log(`    ${fmtBands(r.loudness)}`);
+      console.log(
+        `    peak=${r.analysis.peak.toFixed(4)} rms=${r.analysis.rms.toFixed(5)} ` +
+          `nan=${r.analysis.nanCount} clip=${r.analysis.clipCount} ` +
+          `longestSilence=${r.analysis.longestSilenceS.toFixed(1)}s ` +
+          `smoothViolations=${r.analysis.smoothnessViolations}`
+      );
+      console.log(`    sha256=${r.pcmSha256}`);
+    }
+  } else {
+    page.setDefaultTimeout(RENDER_TIMEOUT_MS);
+    const result = await page.evaluate(() => window.__scoreSoak.runAudioCheck());
+    console.log(`\naudio:check — combined music+SFX, ${result.seconds}s, rendered twice`);
+    console.log(`    ${fmtLoudness(result.render.loudness)}`);
+    console.log(`    ${fmtBands(result.render.loudness)}`);
+    for (const c of result.checks) {
+      if (!c.pass) pass = false;
+      console.log(`    [${c.pass ? 'PASS' : 'FAIL'}] ${c.name.padEnd(12)} ${c.detail}`);
+    }
+    if (!result.pass) pass = false;
+  }
+} finally {
+  await browser.close();
+  if (viteProc && !viteProc.killed) viteProc.kill();
+}
+
+const wallS = (Date.now() - startedAt) / 1000;
+const withinBudget = mode !== 'check' || wallS <= WALL_BUDGET_S;
+if (!withinBudget) pass = false;
+console.log(
+  `\nwall time ${wallS.toFixed(1)}s${mode === 'check' ? ` (budget ${WALL_BUDGET_S}s)` : ''} — ` +
+    `${pass ? 'PASS' : 'FAIL'}`
+);
+process.exit(pass ? 0 : 1);
diff --git a/main/tools/audio-hit-onset-probe.mjs b/main/tools/audio-hit-onset-probe.mjs
new file mode 100644
index 0000000..182fcdd
--- /dev/null
+++ b/main/tools/audio-hit-onset-probe.mjs
@@ -0,0 +1,84 @@
+#!/usr/bin/env node
+// Stage 3 composed-sync onset probe (audio-10x run): for each of the ten
+// contracted anchors, arms `scheduleHitOffline` on the beat's own step grid at
+// several grid phases and measures the rendered envelope start against the
+// returned audioTime (contract: within 1 ms). Silent-mood renders, pre-tail tap.
+//
+//   node tools/audio-hit-onset-probe.mjs <out.json> [--phases 6.0,6.37,6.71] [--desired 2.2] [--only anc.a,anc.b]
+import fs from 'node:fs';
+import net from 'node:net';
+import os from 'node:os';
+import path from 'node:path';
+import { spawn } from 'node:child_process';
+import { chromium } from 'playwright-core';
+
+const args = process.argv.slice(2);
+const outFile = args.find((a) => !a.startsWith('--'));
+if (!outFile) { console.error('usage: audio-hit-onset-probe.mjs <out.json> [--phases a,b,c] [--desired s] [--only ids]'); process.exit(2); }
+const flag = (n) => { const i = args.indexOf(`--${n}`); return i >= 0 ? args[i + 1] : null; };
+const phases = (flag('phases') ?? '6.0,6.37,6.71').split(',').map(Number);
+const desired = Number(flag('desired') ?? '2.2');
+const only = flag('only')?.split(',') ?? null;
+const root = path.dirname(path.dirname(new URL(import.meta.url).pathname));
+
+async function serverUp(port) { try { return (await fetch(`http://localhost:${port}/score-soak.html`)).ok; } catch { return false; } }
+let viteProc = null;
+process.once('exit', () => { if (viteProc && !viteProc.killed) viteProc.kill(); });
+async function freshPort() {
+  return await new Promise((resolve, reject) => {
+    const server = net.createServer(); server.unref(); server.on('error', reject);
+    server.listen(0, '127.0.0.1', () => { const port = server.address().port; server.close((e) => (e ? reject(e) : resolve(port))); });
+  });
+}
+async function startServer(port) {
+  const viteScript = ["import { createServer } from 'vite'", "import react from '@vitejs/plugin-react'",
+    `const server = await createServer({ configFile: false, root: process.cwd(), plugins: [react()], server: { port: ${port}, strictPort: true, hmr: false, watch: null } })`,
+    'await server.listen()', 'await new Promise(() => {})'].join(';');
+  viteProc = spawn(process.execPath, ['--input-type=module', '--eval', viteScript], { cwd: root, stdio: 'ignore', env: { ...process.env, PROBE_NO_HMR: '1' } });
+  for (let i = 0; i < 100; i++) { if (await serverUp(port)) return; await new Promise((r) => setTimeout(r, 300)); }
+  throw new Error('vite dev server did not come up');
+}
+const pwDir = path.join(os.homedir(), '.cache/ms-playwright');
+const chromeDir = fs.readdirSync(pwDir).filter((d) => /^chromium-\d+$/.test(d)).sort().pop();
+const executablePath = path.join(pwDir, chromeDir, 'chrome-linux/chrome');
+
+const probePort = await freshPort();
+await startServer(probePort);
+const browser = await chromium.launch({ executablePath, headless: true, args: ['--enable-unsafe-swiftshader', '--use-gl=angle', '--autoplay-policy=no-user-gesture-required', '--mute-audio'] });
+let failed = false;
+const summary = { generatedAt: new Date().toISOString(), phases, desiredDelayS: desired, rows: [], verdict: null };
+try {
+  const page = await browser.newPage();
+  page.setDefaultTimeout(600000);
+  page.on('pageerror', (e) => { failed = true; console.log(`[pageerror] ${e.message}`); });
+  await page.goto(`http://localhost:${probePort}/score-soak.html`, { waitUntil: 'load' });
+  await page.waitForFunction(() => Boolean(window.__scoreSoak), null, { timeout: 20000 });
+  for (const armAtS of phases) {
+    const specs = await page.evaluate(({ a, d }) => window.__scoreSoak.hitOnsetAnchorSpecs(a, d), { a: armAtS, d: desired });
+    for (const spec of specs) {
+      if (only && !only.includes(spec.anchorId)) continue;
+      const r = await page.evaluate((s) => window.__scoreSoak.renderHitOnsetProbe(s), spec);
+      const row = {
+        anchorId: r.anchorId, beat: r.beat, kind: r.kind, quantize: r.quantize, tempo: r.tempo, capMs: r.capMs, mayLead: Boolean(r.mayLead), floorRung: r.floorRung ?? 'step',
+        armAtS: r.armedAtS, desiredS: r.armedAtS != null ? r.armedAtS + r.desiredDelayS : null,
+        audioTime: r.schedule?.audioTime ?? null, quantumLanded: r.schedule?.quantumLanded ?? null, slackMs: r.schedule?.slackMs ?? null,
+        onsetAttackMs: r.schedule?.onsetAttackMs ?? null, firstNonZeroS: r.firstNonZeroS, onsetErrorMs: r.onsetErrorMs, audibleS: r.audibleS,
+        preRollSilent: r.preRollSilent, fitsCap: r.fitsCap,
+        pass: r.schedule != null && r.fitsCap === true && r.preRollSilent && r.onsetErrorMs != null && Math.abs(r.onsetErrorMs) <= 1
+      };
+      summary.rows.push(row);
+      console.log(`${row.anchorId.padEnd(30)} arm=${armAtS.toFixed(2)} ${row.quantumLanded ?? 'null'} slack=${row.slackMs?.toFixed(1)}ms cap=${row.capMs.toFixed(1)} onsetErr=${row.onsetErrorMs?.toFixed(3)}ms preRoll=${row.preRollSilent} ${row.pass ? 'PASS' : 'FAIL'}`);
+    }
+  }
+} finally {
+  await browser.close();
+  if (viteProc && !viteProc.killed) viteProc.kill();
+}
+const fails = summary.rows.filter((r) => !r.pass);
+summary.verdict = { rows: summary.rows.length, pass: summary.rows.length - fails.length, fail: fails.length,
+  maxAbsOnsetErrorMs: Math.max(...summary.rows.map((r) => Math.abs(r.onsetErrorMs ?? Infinity))),
+  maxSlackOverCapMs: Math.max(...summary.rows.map((r) => (r.slackMs ?? 0) - r.capMs)) };
+fs.mkdirSync(path.dirname(outFile), { recursive: true });
+fs.writeFileSync(outFile, JSON.stringify(summary, null, 2));
+console.log(`RESULT onset rows ${summary.verdict.pass}/${summary.verdict.rows} pass; max |onset error| ${summary.verdict.maxAbsOnsetErrorMs.toFixed(3)} ms; wrote ${outFile}`);
+process.exit(failed || fails.length ? 1 : 0);
diff --git a/main/tools/audio-mood-identity-probe.mjs b/main/tools/audio-mood-identity-probe.mjs
