+      metrics: lumaMetrics(file)
+    });
+  }
+  await page.evaluate(() => window.__spaceStationWalk?.(0, 0));
+
+  // Frame-exact ramp record from the lighting component's own history.
+  const diag = await page.evaluate(() => window.__spaceStationFill?.() ?? null);
+  const samples = (diag?.samples ?? []).filter(sample => sample.elapsedSeconds <= 1.4 + 1e-6 || sample.progress < 1);
+  // Isolate the concourse ramp: from the last sample with elapsed 0 onward.
+  const start = samples.map(sample => sample.elapsedSeconds).lastIndexOf(0);
+  const ramp = start >= 0 ? samples.slice(start) : samples;
+  strip.samples = ramp;
+  strip.district = diag?.district ?? null;
+  strip.durationSeconds = diag?.durationSeconds ?? null;
+
+  const assert = (ok, message) => {
+    strip.assertions.push({ ok, message });
+    check(ok, `${tag} strip: ${message}`);
+  };
+  assert(diag?.district === 'concourse', `ramp destination is concourse (got ${diag?.district})`);
+  assert(diag?.durationSeconds === 1.4, `THRESHOLD_FADE_SECONDS.concourse is 1.4 (got ${diag?.durationSeconds})`);
+  assert(ramp.length > 0 && ramp[0].elapsedSeconds === 0 && ramp[0].progress === 0, `progress 0 at the t=0 frame (got ${ramp[0]?.progress} at ${ramp[0]?.elapsedSeconds}s)`);
+  const monotone = ramp.every((sample, i) => i === 0 || sample.progress >= ramp[i - 1].progress);
+  assert(monotone, 'ramp is monotone across every frame');
+  assert(ramp.every(sample => sample.progress <= 1), 'ramp never overshoots 1');
+  const at12 = ramp.find(sample => sample.elapsedSeconds >= 1.2);
+  assert(at12 !== undefined && at12.progress >= 0.95, `progress ≥ 0.95 at the first frame at or after +1.2 s (got ${at12?.progress} at ${at12?.elapsedSeconds}s)`);
+  const at14 = ramp.find(sample => sample.elapsedSeconds >= 1.4);
+  assert(at14 !== undefined && at14.progress === 1, `progress exactly 1 at +1.4 s (got ${at14?.progress} at ${at14?.elapsedSeconds}s)`);
+  const wall12 = strip.frames.find(frame => frame.label === '+1.2');
+  assert(wall12?.at.progress >= 0.9, `wall-clock +1.2 s sample has progress ≥ 0.9 (got ${wall12?.at.progress} at ramp ${wall12?.at.elapsedSeconds}s)`);
+  const wall14 = strip.frames.find(frame => frame.label === '+1.4');
+  const concourse = TARGETS.concourse;
+  assert(
+    wall14 !== undefined && wall14.metrics.median >= concourse.median[0] && wall14.metrics.median <= concourse.median[1],
+    `concourse median inside ${concourse.median.join('–')} at +1.4 s (got ${wall14?.metrics.median})`
+  );
+  const lowLine = strip.frames.some(frame => frame.at.lowLinePresent);
+  if (lowLine) {
+    for (const frame of strip.frames) {
+      if (frame.label === 'pre') continue;
+      const offset = Number(frame.label);
+      if (offset <= 0.8) assert(frame.at.lowLineOpacity === 0, `low line opacity 0 at ${frame.label} s (got ${frame.at.lowLineOpacity})`);
+      if (offset >= 1.2) assert(frame.at.lowLineOpacity === 1, `low line opacity 1 at ${frame.label} s (got ${frame.at.lowLineOpacity})`);
+    }
+  } else {
+    strip.note = 'no story HUD on this route: low-line opacity not measurable (needs --story-url with a seeded story save)';
+  }
+
+  console.log(`\nT-concourse-open (${tag})`);
+  for (const frame of strip.frames) {
+    console.log(
+      `  ${frame.label.padEnd(5)} wall ${String(frame.offsetSeconds).padStart(5)}s  ramp ${String(frame.at.elapsedSeconds?.toFixed?.(2) ?? '—').padStart(5)}s  progress ${String(frame.at.progress?.toFixed?.(3) ?? '—').padStart(5)}  ` +
+        `median ${String(frame.metrics.median).padStart(3)}  <16 ${String(frame.metrics.pctUnder16).padStart(5)}%  lowLine ${frame.at.lowLineOpacity ?? 'n/a'}`
+    );
+  }
+  console.log(`  ramp frames: ${ramp.map(sample => `${sample.elapsedSeconds.toFixed(2)}→${sample.progress.toFixed(3)}`).join(' ')}`);
+  for (const entry of strip.assertions) console.log(`  ${entry.ok ? 'PASS' : 'FAIL'}  ${entry.message}`);
+  return strip;
+}
+
+const strips = [];
+if (!SKIP_STRIP) {
+  strips.push(await walkConcourseStrip('sandbox'));
+  if (STORY_URL) {
+    await openStation(STORY_URL);
+    strips.push(await walkConcourseStrip('story'));
+  }
+}
+
+// --- report ---------------------------------------------------------------------------
+
+writeFileSync(
+  resolve(OUT, 'luma.json'),
+  JSON.stringify(
+    {
+      schema: 'paravoxia.stationLuma.v1',
+      url: BASE,
+      identity: 'Paravoxia',
+      viewport: `${WIDTH}x${HEIGHT}`,
+      renderer: 'headless chromium, ANGLE/SwiftShader, dpr 1',
+      capturedAt: new Date().toISOString(),
+      targets: TARGETS,
+      legibilityFloor: LEGIBILITY_FLOOR,
