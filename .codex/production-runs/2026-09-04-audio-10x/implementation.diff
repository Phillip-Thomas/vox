index 0000000..df58ab6
--- /dev/null
+++ b/main/tools/run-pure-soak.mjs
@@ -0,0 +1,24 @@
+// No-watch runner for the pure (symbolic) score soak.
+//
+//   npm run score:soak:pure -- --minutes 45 --seed 123
+//
+// `vite-node` starts a Vite server, and Vite's default watcher walks the whole
+// repo — including captures/ and renders/ — which exceeds this machine's
+// inotify budget and kills the run with ENOSPC before a single bar is planned
+// (audit 1 §7). PROBE_NO_HMR=1 selects the no-watch server config in
+// vite.config.ts, so the soak runs anywhere the watcher limit is tight.
+import { spawnSync } from 'node:child_process';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const toolsDir = path.dirname(fileURLToPath(import.meta.url));
+const root = path.dirname(toolsDir);
+const viteNode = path.join(root, 'node_modules', 'vite-node', 'vite-node.mjs');
+const cli = path.join(toolsDir, 'score-soak-cli.ts');
+
+const result = spawnSync(process.execPath, [viteNode, cli, ...process.argv.slice(2)], {
+  cwd: root,
+  stdio: 'inherit',
+  env: { ...process.env, PROBE_NO_HMR: '1' }
+});
+process.exit(result.status ?? 1);
diff --git a/main/tools/score-stage5-soak-stats.ts b/main/tools/score-stage5-soak-stats.ts
new file mode 100644
index 0000000..ee27e86
--- /dev/null
+++ b/main/tools/score-stage5-soak-stats.ts
@@ -0,0 +1,182 @@
+// --- Stage 5 long-form soak statistics (audio-10x run) ----------------------------------------------
+//
+// Runs the pure 32-minute fullSoak for the three reference planets and reports
+// the long-form numbers the Stage 5 terms name: barNovelty, distinctChords,
+// melodyStatements, tabuBypasses, the arrangement histogram, BLOOM episode
+// count / lengths, the duplicate-bar breakdown by arrangement state, and (when
+// the log carries them) the section planner's (statementSchedule, registerArc)
+// pairs and the bloom-payment audit. Same numbers before and after: the tool
+// reads optional fields defensively so one script measures both trees.
+//
+//   PROBE_NO_HMR=1 node node_modules/vite-node/vite-node.mjs tools/score-stage5-soak-stats.ts --out <dir> [--minutes 32]
+//
+import fs from 'node:fs';
+import path from 'node:path';
+import type { ArchetypeId } from '../src/game/data/planetArchetypes.ts';
+import { fnv1a32 } from '../src/utils/worldCoordinates.ts';
+import {
+  formatSoakReport,
+  runPureSoak,
+  SOAK_CONTRAST_ARCHETYPE_A,
+  SOAK_CONTRAST_ARCHETYPE_B,
+  SOAK_CONTRAST_SEED_A,
+  SOAK_CONTRAST_SEED_B,
+  SOAK_HOME_ARCHETYPE,
+  SOAK_HOME_SEED,
+  type SoakBarRecord
+} from '../src/audio/generative/soak.ts';
+import { PHRASE_BARS } from '../src/audio/generative/tuning.ts';
+
+const args = process.argv.slice(2);
+const flag = (name: string): string | null => {
+  const i = args.indexOf(`--${name}`);
+  return i >= 0 && i + 1 < args.length ? args[i + 1] : null;
+};
+const minutes = Number(flag('minutes') ?? 32);
+const outDir = flag('out');
+if (outDir) fs.mkdirSync(outDir, { recursive: true });
+
+interface Planet {
+  seed: number;
+  archetype: ArchetypeId;
+}
+const planets: Planet[] = [
+  { seed: SOAK_HOME_SEED, archetype: SOAK_HOME_ARCHETYPE },
+  { seed: SOAK_CONTRAST_SEED_A, archetype: SOAK_CONTRAST_ARCHETYPE_A },
+  { seed: SOAK_CONTRAST_SEED_B, archetype: SOAK_CONTRAST_ARCHETYPE_B }
+];
+
+/** The soak's whole-bar fingerprint (mirrors auditSoakLog's barNovelty hash). */
+function barFingerprint(r: SoakBarRecord): number {
+  const x = r as SoakBarRecord & { levels?: Record<string, number>; uppers?: number[] };
+  const levels = x.levels
+    ? Object.values(x.levels)
+        .map((v) => Math.round(v * 20) / 20)
+        .join(',')
+    : '';
+  return fnv1a32(
+    `${r.chordId}|${r.uppers.join('.')}|${r.arrangement}|${r.melodyChain}|${r.ostinato
+      .map((n) => n.slot + ':' + n.semis)
+      .join(',')}|${r.percussion.join(',')}|${levels}`
+  );
+}
+
+interface Episode {
+  startBar: number;
+  phrases: number;
+}
+
+function episodes(bars: readonly SoakBarRecord[], state: string): Episode[] {
+  const out: Episode[] = [];
+  let cur: Episode | null = null;
+  for (const r of bars) {
+    if (r.arrangement === state) {
+      if (!cur) {
+        cur = { startBar: r.barIndex, phrases: 0 };
+        out.push(cur);
+      }
+      if (r.phrasePos === 0) cur.phrases += 1;
+    } else {
+      cur = null;
+    }
+  }
+  return out;
+}
+
+const summary: Record<string, unknown> = { minutes, planets: {} };
+const lines: string[] = [];
+for (const planet of planets) {
+  const { log, report } = runPureSoak({
+    planetSeed: planet.seed,
+    archetype: planet.archetype,
+    minutes,
+    scenario: 'fullSoak'
+  });
+  const bars = log.bars;
+  lines.push(formatSoakReport(`fullSoak ${minutes}min seed=${planet.seed} (${planet.archetype})`, report));
+
+  // Duplicate breakdown by state (global, whole run).
+  const seen = new Map<number, number>();
+  const dupByState: Record<string, { bars: number; dup: number }> = {};
+  for (const r of bars) {
+    const h = barFingerprint(r);
+    const st = (dupByState[r.arrangement] ??= { bars: 0, dup: 0 });
+    st.bars += 1;
+    if (seen.has(h)) st.dup += 1;
+    seen.set(h, (seen.get(h) ?? 0) + 1);
+  }
+  const globalNovelty = seen.size / bars.length;
+
+  // Windowed novelty: bars whose fingerprint recurs inside the last 32 bars.
+  let windowRepeats = 0;
+  const recent: number[] = [];
+  for (const r of bars) {
+    const h = barFingerprint(r);
+    if (recent.includes(h)) windowRepeats += 1;
+    recent.push(h);
+    while (recent.length > 32) recent.shift();
+  }
+
+  const blooms = episodes(bars, 'BLOOM');
+  const builds = episodes(bars, 'BUILD');
+  const statements = bars.filter((r) => r.melodyChain !== null);
+  const statementGapsPhrases: number[] = [];
+  for (let i = 1; i < statements.length; i++) {
+    statementGapsPhrases.push((statements[i].barIndex - statements[i - 1].barIndex) / PHRASE_BARS);
+  }
+  const bloomGapsMin: number[] = [];
+  const barSec = (minutes * 60) / bars.length;
+  for (let i = 1; i < blooms.length; i++) {
+    bloomGapsMin.push(((blooms[i].startBar - blooms[i - 1].startBar) * barSec) / 60);
+  }
+
+  // Section planner fields (after only).
+  const sections = new Map<number, { pair: string; bloomBudget: number; withheld: string | null; arc: string }>();
+  for (const r of bars as Array<SoakBarRecord & Record<string, unknown>>) {
+    if (typeof r.sectionIndex === 'number' && !sections.has(r.sectionIndex)) {
+      sections.set(r.sectionIndex, {
+        pair: `${String(r.statementSchedule)}|${String(r.registerArc)}`,
+        bloomBudget: Number(r.bloomBudget),
+        withheld: (r.withheldLayer as string | null) ?? null,
+        arc: String(r.registerArc)
+      });
+    }
+  }
+  const pairs = [...sections.values()].map((s) => s.pair);
+  const repeatedPairs = pairs.length - new Set(pairs).size;
+
+  const planetSummary = {
+    seed: planet.seed,
+    archetype: planet.archetype,
+    pass: report.pass,
+    stats: report.stats,
+    checks: report.checks.map((c) => `${c.name}:${c.pass ? 'PASS' : 'FAIL'}:${c.violations}`),
+    globalBarNovelty: Number(globalNovelty.toFixed(3)),
+    windowRepeats32: windowRepeats,
+    dupByState,
+    blooms: { count: blooms.length, lengthsPhrases: blooms.map((b) => b.phrases), gapsMin: bloomGapsMin.map((g) => Number(g.toFixed(2))) },
+    builds: { count: builds.length, lengthsPhrases: builds.map((b) => b.phrases) },
+    statements: { count: statements.length, gapsPhrases: statementGapsPhrases },
+    sections: { count: sections.size, repeatedPairs, pairs, bloomBudgets: [...sections.values()].map((s) => s.bloomBudget), withheld: [...sections.values()].map((s) => s.withheld) }
+  };
+  (summary.planets as Record<string, unknown>)[String(planet.seed)] = planetSummary;
+  lines.push(
+    `  · globalBarNovelty(+voicing,+levels): ${planetSummary.globalBarNovelty}  windowRepeats32: ${windowRepeats}`,
+    `  · dupByState: ${JSON.stringify(dupByState)}`,
+    `  · BLOOM episodes: ${blooms.length} lengths(phrases)=[${blooms.map((b) => b.phrases).join(',')}] gaps(min)=[${bloomGapsMin.map((g) => g.toFixed(1)).join(',')}]`,
+    `  · BUILD episodes: ${builds.length} lengths(phrases)=[${builds.map((b) => b.phrases).join(',')}]`,
+    `  · statements: ${statements.length} gaps(phrases)=[${statementGapsPhrases.join(',')}]`,
+    `  · sections: ${sections.size} repeatedPairs=${repeatedPairs} bloomBudgets=[${planetSummary.sections.bloomBudgets.join(',')}] withheld=[${planetSummary.sections.withheld.join(',')}]`,
+    ''
+  );
+  if (outDir) {
+    fs.writeFileSync(path.join(outDir, `soak-log-seed${planet.seed}.json`), JSON.stringify(log));
+  }
+}
+
+const text = lines.join('\n');
+console.log(text);
+if (outDir) {
+  fs.writeFileSync(path.join(outDir, 'pure-soak-stats.txt'), text);
+  fs.writeFileSync(path.join(outDir, 'pure-soak-stats.json'), JSON.stringify(summary, null, 2));
+}
diff --git a/main/tools/story-ladder-diff.mjs b/main/tools/story-ladder-diff.mjs
new file mode 100644
index 0000000..bf16490
--- /dev/null
+++ b/main/tools/story-ladder-diff.mjs
@@ -0,0 +1,71 @@
+// --- Ladder diff classifier ----------------------------------------------------------
+//
+// `story:ladder:trace -- --compare` says WHICH beats differ from the baseline.
+// This says WHETHER each difference is the kind a batch is allowed to make.
+//
+// Rule for the marker-gate batches (PARAVOXIA_STORY_PIPELINE_REFACTOR_PLAN.md
+// §2.3): publishing a mandatory rung one frame LATER, once its target exists,
+// may turn an entry state's `health` from `missing-marker` into `ready` and
+// may drop a leading state that was identical except for that field. Nothing
+// else may change, and no objective the baseline shows may be absent now — an
+// absent objective is a rung with no findable target, which is exactly the
+// defect the gate exists to expose.
+//
+//   node tools/story-ladder-diff.mjs                 # baseline vs captures/story-ladder
+//   node tools/story-ladder-diff.mjs --allow-health  # apply the marker-gate rule
+
+import { readFileSync } from 'node:fs';
+import path from 'node:path';
+import process from 'node:process';
+
+const allowHealth = process.argv.includes('--allow-health');
+const baseline = JSON.parse(readFileSync(path.resolve('..', '.codex/production-runs/2026-09-story-pipeline/ladder-baseline.json'), 'utf8')).trace;
+const now = JSON.parse(readFileSync(path.resolve('captures/story-ladder/ladder-trace.json'), 'utf8')).trace;
+
+const strip = state => ({ ...state, objective: state.objective && { ...state.objective, health: undefined } });
+const same = (a, b) => JSON.stringify(a) === JSON.stringify(b);
+
+let disallowed = 0;
+for (const beat of Object.keys(baseline)) {
+  const a = baseline[beat] ?? [];
+  const b = now[beat] ?? [];
+  if (same(a, b)) continue;
+
+  const objectivesA = new Set(a.map(s => s.objective?.id).filter(Boolean));
+  const objectivesB = new Set(b.map(s => s.objective?.id).filter(Boolean));
+  const missing = [...objectivesA].filter(id => !objectivesB.has(id));
+
+  // Allowed shape: after ignoring `health`, `now` equals `baseline` with at
+  // most its leading states dropped (they were the pre-target frames).
+  let allowedShape = false;
+  if (allowHealth) {
+    const sa = a.map(strip), sb = b.map(strip);
+    for (let drop = 0; drop <= sa.length - sb.length && drop <= 2; drop++) {
+      if (same(sa.slice(drop), sb)) { allowedShape = true; break; }
+    }
+    // Also allow: identical length, only health flipped missing-marker -> ready.
+    if (!allowedShape && sa.length === sb.length && same(sa, sb)) {
+      allowedShape = a.every((s, i) => {
+        const h0 = s.objective?.health, h1 = b[i].objective?.health;
+        return h0 === h1 || (h0 === 'missing-marker' && h1 === 'ready');
+      });
+    }
+  }
+
+  const verdict = missing.length > 0 ? 'DISALLOWED (objective missing)' : allowedShape ? 'allowed' : 'DISALLOWED';
+  if (verdict !== 'allowed') disallowed++;
+  console.log(`${verdict.padEnd(30)} ${beat.padEnd(14)} baseline=${a.length} now=${b.length}${missing.length ? '  missing: ' + missing.join(',') : ''}`);
+  if (verdict !== 'allowed') {
+    const n = Math.max(a.length, b.length);
+    for (let i = 0; i < n; i++) {
+      if (same(a[i], b[i])) continue;
+      for (const k of new Set([...Object.keys(a[i] ?? {}), ...Object.keys(b[i] ?? {})])) {
+        const va = JSON.stringify(a[i]?.[k]), vb = JSON.stringify(b[i]?.[k]);
+        if (va !== vb) console.log(`    state[${i}].${k}: base=${String(va).slice(0, 110)}  now=${String(vb).slice(0, 110)}`);
+      }
+      break;
+    }
+  }
+}
+console.log(`\n${disallowed} disallowed difference(s)`);
+process.exit(disallowed > 0 ? 1 : 0);
diff --git a/main/tools/story-ladder-trace.mjs b/main/tools/story-ladder-trace.mjs
new file mode 100644
index 0000000..df576a2
--- /dev/null
+++ b/main/tools/story-ladder-trace.mjs
@@ -0,0 +1,183 @@
+// --- The story ladder trace ----------------------------------------------------------
+//
+// Records, per beat, everything the player is told and allowed: the published
+// objective (id, marker label, work order, health, marker requirement), the
+// marker text actually rendered, and the input policy — sampled over a short
+// deep-link entry and de-duplicated into a list of distinct states.
+//
+// It is the determinism fingerprint for PARAVOXIA_STORY_PIPELINE_REFACTOR_PLAN.md,
+// in the same role `proceduralWorldGeneratorDeterminism.test.ts` plays for
+// terrain: a refactor that moves every table into one contract must leave this
+// byte-identical. A diff here is a defect, not a refactor.
+//
+//   npm run story:ladder:trace                 # trace, write JSON, print hash
+//   npm run story:ladder:trace -- --baseline   # record as the baseline
+//   npm run story:ladder:trace -- --compare    # fail on any difference
+//   PARAVOXIA_LADDER_BEATS=ch1-fixed,ch1-raster npm run story:ladder:trace
+
+import { createHash } from 'node:crypto';
+import { mkdir, readFile, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import process from 'node:process';
+import { chromium } from 'playwright-core';
+import { CHROMIUM_ARGS, assertHardwareGl, chromePath, startParavoxiaPreview } from './lib/previewServer.mjs';
+
+// Mirrors STORY_BEAT_ORDER minus `done` (not deep-linkable as play).
+const ALL_BEATS = [
+  'crawl', 'manifest', 'voyage', 'deflect', 'crash',
+  'descent', 'ch1-fixed', 'ch1-track', 'ch1-raster',
+  'ch1-depth', 'ch1-nav', 'ch1-iso',
+  'ch1-lift', 'ch1-anomaly', 'a1-ramp',
+  'ch2-color', 'ch2-approach', 'a2-awakening',
+  'ch3-gather', 'ch3-dusk', 'ch3-await-rest', 'a3-dawn',
+  'ch3-thirst', 'ch3-forage', 'ch3-signal',
+  'ch4-vigil', 'ch4-arrival', 'ch4-audit', 'ch4-comply', 'ch4-defy', 'a4-exhale',
+  'ch5-maw', 'ch6-dive',
+  'ch7-reconstruct', 'ch7-board',
+  'ch8-launch', 'ch8-crossing', 'ch8-landfall',
+  'ch9-settle', 'ch9-hearth',
+  'ch10-cold', 'ch10-ask', 'ch10-transit'
+];
+
+const args = process.argv.slice(2);
+const baselineMode = args.includes('--baseline');
+const compareMode = args.includes('--compare');
+const beats = process.env.PARAVOXIA_LADDER_BEATS
+  ? process.env.PARAVOXIA_LADDER_BEATS.split(',').map(v => v.trim()).filter(Boolean)
+  : ALL_BEATS;
+const sampleMs = Number(process.env.PARAVOXIA_LADDER_SAMPLE_MS ?? 100);
+const windowMs = Number(process.env.PARAVOXIA_LADDER_WINDOW_MS ?? 6_000);
+const outputDir = path.resolve(process.env.PARAVOXIA_LADDER_OUTPUT ?? 'captures/story-ladder');
+// Extra query for every deep link, e.g. `worldprep=sync` to trace the ladder on
+// the legacy synchronous boot regardless of the world-gen plan's progress.
+const extraQuery = process.env.PARAVOXIA_LADDER_QUERY ? `&${process.env.PARAVOXIA_LADDER_QUERY}` : '';
+// Production runs live at the REPO root's `.codex/`, one level above `main/`.
+const baselinePath = path.resolve('..', '.codex/production-runs/2026-09-story-pipeline/ladder-baseline.json');
+
+/** One sample of "what the player is told and allowed", read in the page. */
+const SAMPLE = () => {
+  const text = selector => {
+    const node = document.querySelector(selector);
+    if (!node) return null;
+    const style = window.getComputedStyle(node);
+    if (style.display === 'none' || style.visibility === 'hidden') return null;
+    return (node.textContent ?? '').replace(/\s+/g, ' ').trim() || null;
+  };
+  const objective = window.__storyObjective ?? null;
+  const policy = window.__storyInputPolicy ?? null;
+  return {
+    beat: window.__storyBeat ?? null,
+    objective: objective && {
+      id: objective.id, kind: objective.kind, markerLabel: objective.markerLabel,
+      workOrder: objective.workOrder, requiresMarker: objective.requiresMarker, health: objective.health
+    },
+    feedMarker: text('[data-regulation-objective-marker="true"]'),
+    freeMarker: text('[data-hud-surface="free-marker"]'),
+    feedWorkOrder: text('[data-hud-surface="feed-work-order"]'),
+    policy: policy && {
+      lookMode: policy.lookMode, moveSpeedScale: policy.moveSpeedScale,
+      allowJump: policy.allowJump, allowSprint: policy.allowSprint, allowMine: policy.allowMine,
+      allowBuild: policy.allowBuild, allowCraft: policy.allowCraft
+    }
+  };
+};
+
+await mkdir(outputDir, { recursive: true });
+const preview = await startParavoxiaPreview({ build: !process.env.PARAVOXIA_URL });
+const browser = await chromium.launch({ headless: true, executablePath: chromePath(), args: CHROMIUM_ARGS });
+{
+  // Fail fast on a software renderer: see CHROMIUM_ARGS.
+  const check = await browser.newPage();
+  await check.goto(preview.url, { waitUntil: 'domcontentloaded' });
+  await assertHardwareGl(check);
+  await check.close();
+}
+
+const trace = {};
+const failures = [];
+try {
+  for (const beat of beats) {
+    const context = await browser.newContext({ viewport: { width: 1280, height: 720 }, deviceScaleFactor: 1 });
+    const page = await context.newPage();
+    const states = [];
+    try {
+      // AUTOPILOT OFF. With `movie=1` the screening acts inside the sample window and
+      // the trace records WHEN it happened to act — a first compare diffed four
+      // non-ch1 beats purely on that timing (campfire douse vs relay samples,
+      // hatch entering vs boarding). The ladder is what the player is told and
+      // allowed on ENTERING a beat; the rail's behaviour is the parity/rail tests' job.
+      const url = `${preview.url}?story=${beat}&movie=0&profile=LOW${extraQuery}`;
+      let attempt = 0;
+      for (;;) {
+        try {
+          await page.goto(url, { waitUntil: 'domcontentloaded', timeout: 30_000 });
+          break;
+        } catch (error) {
+          // The preview intermittently answers a navigation with a non-2xx
+          // (ERR_HTTP_RESPONSE_CODE_FAILURE); retry rather than record a beat as empty.
+          if (++attempt >= 3) throw error;
+          await new Promise(resolve => setTimeout(resolve, 1_500));
+        }
+      }
+      // Readiness is "the story is on this beat", not "the app is playing":
+      // the prologue beats run over the menu and never reach `playing`, so a
+      // phase wait burned the full timeout on each of them. Deep links set
+      // `__storyBeat` synchronously; a beat that never appears is a failure
+      // worth recording quickly, not a minute and a half of waiting.
+      await page.waitForFunction(
+        expected => window.__storyBeat === expected || window.__paravoxiaAppState?.phase === 'playing',
+        beat,
+        { timeout: 30_000 }
+      );
+      const deadline = Date.now() + windowMs;
+      let last = null;
+      while (Date.now() < deadline) {
+        const sample = await page.evaluate(SAMPLE);
+        // Marker distance suffixes ("· 12m") change every frame; strip them so
+        // the trace records WHAT is designated, not how far away it happened to be.
+        for (const key of ['feedMarker', 'freeMarker']) {
+          if (sample[key]) sample[key] = sample[key].replace(/\s*·\s*\d+m\b/g, '');
+        }
+        const encoded = JSON.stringify(sample);
+        if (encoded !== last) { states.push(sample); last = encoded; }
+        await page.waitForTimeout(sampleMs);
+      }
+    } catch (error) {
+      failures.push({ beat, error: String(error?.message ?? error) });
+    }
+    trace[beat] = states;
+    console.log(`[ladder] ${beat.padEnd(14)} ${states.length} distinct state(s)`);
+    await context.close();
+  }
+} finally {
+  await browser.close();
+  preview.stop();
+}
+
+const canonical = JSON.stringify(trace);
+const hash = createHash('sha256').update(canonical).digest('hex').slice(0, 16);
+const report = { generatedAt: new Date().toISOString(), beats, hash, failures, trace };
+await writeFile(path.join(outputDir, 'ladder-trace.json'), JSON.stringify(report, null, 2));
+console.log(`\n[ladder] hash ${hash}  (${beats.length} beats, ${failures.length} failure(s))`);
+
+let exitCode = failures.length > 0 ? 1 : 0;
+if (baselineMode) {
+  await mkdir(path.dirname(baselinePath), { recursive: true });
+  await writeFile(baselinePath, JSON.stringify({ generatedAt: report.generatedAt, hash, trace }, null, 2));
+  console.log(`[ladder] baseline written: ${baselinePath}`);
+}
+if (compareMode) {
+  const baseline = JSON.parse(await readFile(baselinePath, 'utf8'));
+  for (const beat of beats) {
+    const before = JSON.stringify(baseline.trace?.[beat] ?? null);
+    const after = JSON.stringify(trace[beat] ?? null);
+    if (before !== after) {
+      console.error(`[ladder] DIFF ${beat}`);
+      console.error(`  baseline: ${before.slice(0, 400)}`);
+      console.error(`  now:      ${after.slice(0, 400)}`);
+      exitCode = 1;
+    }
+  }
+  if (exitCode === 0) console.log('[ladder] identical to baseline');
+}
+process.exit(exitCode);
