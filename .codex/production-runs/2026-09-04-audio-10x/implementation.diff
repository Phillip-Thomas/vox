+        id, file, cell, u, turn: turn ?? -Math.PI / 2, pitch: pitch ?? 0, district, inOrdering: ordering !== false, note, state, fill, metrics
+      })),
+      districts: districtStats,
+      ordering: ordering.map(([label, ok]) => ({ label, ok })),
+      strips,
+      failures,
+      problems
+    },
