+    const name = LABEL ? `T-concourse-open-${label}-${LABEL}.png` : `T-concourse-open-${label}.png`;
+    if (tag !== 'sandbox') return name.replace('.png', `-${tag}.png`);
+    return name;
+  };
+
+  const readDiag = () =>
+    page.evaluate(() => {
+      const fill = window.__spaceStationFill?.() ?? null;
+      const state = window.__spaceStationState?.() ?? null;
+      const line = document.querySelector('[data-testid="spaceStation-low-line"]');
+      return {
+        now: performance.now(),
+        cellId: state?.cellId ?? null,
+        x: state?.position?.[0] ?? null,
+        district: fill?.district ?? null,
+        from: fill?.from ?? null,
+        progress: fill?.progress ?? null,
+        elapsedSeconds: fill?.elapsedSeconds ?? null,
+        durationSeconds: fill?.durationSeconds ?? null,
+        ambientIntensity: fill?.ambientIntensity ?? null,
+        fogDensity: fill?.fogDensity ?? null,
+        lowLineOpacity: line ? Number(getComputedStyle(line).opacity) : null,
+        lowLinePresent: line !== null
+      };
+    });
+
+  await page.evaluate(() => window.__spaceStationWalk?.(1, 0));
+
+  // The "-0.5 s" frame: taken when the walker is ~half a second from the plane.
+  let pre = null;
+  let t0 = null;
+  let preShot = false;
+  for (let i = 0; i < 400; i++) {
+    const diag = await readDiag();
+    if (!preShot && diag.x !== null && diag.x >= 201 - 2.4) {
+      preShot = true;
+      const name = await shot('pre');
+      const file = resolve(OUT, name);
+      await page.screenshot({ path: file });
+      pre = { label: 'pre', file: name, at: diag, metrics: lumaMetrics(file) };
+    }
+    if (diag.cellId === 'concourse') {
+      t0 = diag.now;
+      break;
+    }
+    await page.waitForTimeout(25);
+  }
+  if (t0 === null) throw new Error('walker never reached the concourse');
+  if (pre) {
+    pre.offsetSeconds = Number(((pre.at.now - t0) / 1000).toFixed(2));
+    strip.frames.push(pre);
+  }
+
+  for (const offset of STRIP_OFFSETS) {
+    // Sample on the first read at or after the offset, never the one before.
+    for (;;) {
+      const now = await page.evaluate(() => performance.now());
+      if (now >= t0 + offset * 1000) break;
+      await page.waitForTimeout(10);
+    }
+    const at = await readDiag();
+    const label = `+${offset.toFixed(1)}`;
+    const name = await shot(label.replace('+', 'p').replace('.', '_'));
+    const file = resolve(OUT, name);
+    await page.screenshot({ path: file });
+    const after = await readDiag();
+    strip.frames.push({
+      label,
