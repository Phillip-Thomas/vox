@@ -0,0 +1,94 @@
+// --- The beat-seam probe -------------------------------------------------------------
+//
+// One continuous movie run, every frame timestamped, every beat change logged.
+// For each beat boundary it reports the longest single frame gap within ±2s of
+// the cut — the "not seamless" candidates. This is the gate for Batches 4 and 5
+// of PARAVOXIA_WORLD_GEN_OFFTHREAD_PLAN.md.
+//
+// Baseline measured 2026-09-04 (warm, continuous): only five boundaries over
+// 100ms — (load)->crawl 1767ms, ch8-crossing->ch8-landfall 283ms,
+// ch4-arrival->ch4-audit 183ms, crash->descent 167ms, descent->ch1-fixed 150ms.
+//
+// A full run is ~25 minutes. Use PARAVOXIA_SEAM_CAP_SECONDS to stop earlier
+// (the table covers whatever boundaries were reached).
+//
+// It also prints every rail BACKSTOP the screening fired (an item granted, a
+// milestone seeded or a beat advanced on the player's behalf, see
+// `railBackstop` in autopilot.ts). A backstop is not a seam defect, but each
+// one is a rail that could not finish its beat honestly — the evidence Batch 5
+// of PARAVOXIA_STORY_PIPELINE_REFACTOR_PLAN.md deletes them against.
+//
+//   npm run perf:seams
+//   PARAVOXIA_SEAM_CAP_SECONDS=600 npm run perf:seams
+
+import { mkdir, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import process from 'node:process';
+import { chromium } from 'playwright-core';
+import { CHROMIUM_ARGS, assertHardwareGl, chromePath, startParavoxiaPreview } from './lib/previewServer.mjs';
+
+const capMs = Number(process.env.PARAVOXIA_SEAM_CAP_SECONDS ?? 1500) * 1000;
+const profile = process.env.PARAVOXIA_SEAM_PROFILE ?? 'LOW';
+const outputDir = path.resolve(process.env.PARAVOXIA_SEAM_OUTPUT ?? 'captures/beat-seams');
+const threshold = Number(process.env.PARAVOXIA_SEAM_THRESHOLD_MS ?? 100);
+
+const INIT = `
+window.__frames = []; window.__beatLog = [];
+(function tick(t) {
+  window.__frames.push(t);
+  const b = window.__storyBeat ?? null;
+  const L = window.__beatLog;
+  if (!L.length || L[L.length - 1].beat !== b) L.push({ beat: b, t });
+  requestAnimationFrame(tick);
+})(performance.now());
+`;
+
+await mkdir(outputDir, { recursive: true });
+const preview = await startParavoxiaPreview({ build: !process.env.PARAVOXIA_URL });
+const browser = await chromium.launch({ headless: true, executablePath: chromePath(), args: CHROMIUM_ARGS });
+let data = { frames: [], beatLog: [], backstops: [] };
+try {
+  const context = await browser.newContext({ viewport: { width: 1280, height: 720 }, deviceScaleFactor: 1 });
+  await context.addInitScript(INIT);
+  const page = await context.newPage();
+  await page.goto(preview.url, { waitUntil: 'domcontentloaded' });
+  await assertHardwareGl(page);
+  await page.goto(`${preview.url}?story=1&movie=1&profile=${profile}`, { waitUntil: 'domcontentloaded', timeout: 60_000 });
+  const startedAt = Date.now();
+  let lastBeat = null;
+  while (Date.now() - startedAt < capMs) {
+    await page.waitForTimeout(5_000);
+    const beat = await page.evaluate(() => window.__storyBeat ?? null).catch(() => null);
+    if (beat !== lastBeat) { console.log(`[seams] ${Math.round((Date.now() - startedAt) / 1000)}s  ${beat}`); lastBeat = beat; }
+    if (beat === 'done') break;
+  }
+  data = await page.evaluate(() => ({
+    frames: window.__frames,
+    beatLog: window.__beatLog,
+    backstops: window.__railBackstops ?? []
+  }));
+  await context.close();
+} finally {
+  await browser.close();
+  preview.stop();
+}
+
+const rows = [];
+for (let i = 1; i < data.beatLog.length; i++) {
+  const from = data.beatLog[i - 1], to = data.beatLog[i];
+  let max = 0;
+  for (let f = 1; f < data.frames.length; f++) {
+    const t = data.frames[f];
+    if (t > to.t - 2000 && t < to.t + 2000) max = Math.max(max, t - data.frames[f - 1]);
+  }
+  rows.push({ from: from.beat ?? '(load)', to: to.beat, maxGapMs: Math.round(max), at: Math.round(to.t) });
+}
+rows.sort((a, b) => b.maxGapMs - a.maxGapMs);
+await writeFile(path.join(outputDir, 'beat-seams.json'), JSON.stringify({ generatedAt: new Date().toISOString(), profile, threshold, rows, backstops: data.backstops }, null, 2));
+console.log(`\n[seams] rail backstops fired: ${data.backstops.length}`);
+for (const b of data.backstops) console.log(`  ${b.beat} @${b.beatSeconds}s  ${b.kind}`);
+console.log(`\n[seams] ${rows.length} boundaries; over ${threshold}ms:`);
+const over = rows.filter(r => r.maxGapMs > threshold);
+for (const r of over) console.log(`  ${String(r.maxGapMs).padStart(5)}ms  ${r.from} -> ${r.to}`);
+if (over.length === 0) console.log('  (none)');
+process.exit(over.filter(r => r.from !== '(load)').length > 0 ? 1 : 0);
diff --git a/main/tools/boot-attribution.mjs b/main/tools/boot-attribution.mjs
new file mode 100644
index 0000000..1fccf01
--- /dev/null
+++ b/main/tools/boot-attribution.mjs
@@ -0,0 +1,117 @@
+// --- Boot attribution ---------------------------------------------------------------
+//
+// CPU attribution of a cold boot, legacy synchronous world-gen vs the worker
+// path, on the SAME build (via `?worldprep=sync`). Prints top self-time
+// functions resolved through sourcemaps, plus the caller chains of the
+// heaviest sampled nodes, so a long task can be named rather than guessed.
+//
+// This tool is how a 20-second cold-boot "stall" was identified as SwiftShader
+// shader compilation rather than an application bug: the profile named
+// `(program)` at 85% with no JS frame under it, and the renderer string said
+// why. Run it before drawing conclusions from any boot-stall number.
+//
+//   npm run perf:boot:attrib
+//   ATTRIB_WINDOW_MS=20000 PARAVOXIA_ATTRIB_BEAT=ch3-dusk npm run perf:boot:attrib
+import { readdirSync, readFileSync } from 'node:fs';
+import { chromium } from 'playwright-core';
+import { CHROMIUM_ARGS, assertHardwareGl, chromePath, run, startParavoxiaPreview } from './lib/previewServer.mjs';
+
+const WINDOW_MS = Number(process.env.ATTRIB_WINDOW_MS ?? 32_000);
+// Build WITH sourcemaps so minified frames (ENe, L, vI…) resolve to real names.
+if (process.env.ATTRIB_BUILD !== '0') {
+  const code = await run('npx', ['vite', 'build', '--sourcemap']);
+  if (code !== 0) throw new Error('build failed');
+}
+const preview = await startParavoxiaPreview({ build: false });
+const browser = await chromium.launch({ headless: true, executablePath: chromePath(), args: CHROMIUM_ARGS });
+
+// Source-map resolver for dist/assets/*.js (graceful if the lib is missing).
+let resolveFrame = frame => frame;
+try {
+  const { TraceMap, originalPositionFor } = await import('@jridgewell/trace-mapping');
+  const maps = new Map();
+  for (const file of readdirSync('dist/assets')) {
+    if (!file.endsWith('.js.map')) continue;
+    maps.set(file.replace(/\.map$/, ''), new TraceMap(JSON.parse(readFileSync(`dist/assets/${file}`, 'utf8'))));
+  }
+  resolveFrame = frame => {
+    // Native frames ((program), (root), (idle), (garbage collector)) carry no
+    // url and line -1; trace-mapping throws on line 0.
+    if (!frame.url || frame.lineNumber < 0) return frame;
+    const file = (frame.url || '').split('/').pop();
+    const map = maps.get(file);
+    if (!map) return frame;
+    const pos = originalPositionFor(map, { line: frame.lineNumber + 1, column: frame.columnNumber });
+    if (!pos.source) return frame;
+    return { ...frame, functionName: pos.name || frame.functionName, url: pos.source, lineNumber: pos.line };
+  };
+  console.log(`[attrib] sourcemaps loaded: ${[...maps.keys()].join(', ')}`);
+} catch (error) {
+  console.log(`[attrib] no sourcemap resolution: ${error.message}`);
+}
+
+function flatten(profile) {
+  const byId = new Map(profile.nodes.map(n => [n.id, n]));
+  const parent = new Map();
+  for (const n of profile.nodes) for (const c of n.children ?? []) parent.set(c, n.id);
+  const self = new Map();
+  const deltas = profile.timeDeltas ?? [];
+  const samples = profile.samples ?? [];
+  const perNode = new Map();
+  for (let i = 0; i < samples.length; i++) {
+    perNode.set(samples[i], (perNode.get(samples[i]) ?? 0) + (deltas[i] ?? 0));
+  }
+  let total = 0;
+  for (const [id, us] of perNode) {
+    const n = byId.get(id);
+    const cf = resolveFrame(n.callFrame);
+    const name = `${cf.functionName || '(anon)'} @${(cf.url || '').split('/').pop()}:${cf.lineNumber}`;
+    self.set(name, (self.get(name) ?? 0) + us);
+    total += us;
+  }
+  const chainOf = id => {
+    const out = [];
+    let cur = id;
+    while (cur !== undefined && out.length < 14) {
+      const n = byId.get(cur);
+      const cf = resolveFrame(n.callFrame);
+      out.push(`${cf.functionName || '(anon)'}${cf.url && !cf.url.includes('index-') ? `[${cf.url.split('/').pop()}]` : ''}`);
+      cur = parent.get(cur);
+    }
+    return out.join(' <- ');
+  };
+  // Heaviest sampled nodes with their caller chain (names the 20s task's owner).
+  const heavy = [...perNode.entries()].sort((a, b) => b[1] - a[1]).slice(0, 6)
+    .map(([id, us]) => `${(us / 1000).toFixed(0)}ms  ${chainOf(id)}`);
+  const top = [...self.entries()].sort((a, b) => b[1] - a[1]).slice(0, 14)
+    .map(([name, us]) => `${String((us / 1000).toFixed(0)).padStart(6)}ms ${(100 * us / total).toFixed(1).padStart(5)}%  ${name}`);
+  return { totalMs: total / 1000, top, heavy };
+}
+
+try {
+  for (const mode of ['sync', 'worker']) {
+    const ctx = await browser.newContext({ viewport: { width: 1280, height: 720 }, deviceScaleFactor: 1 });
+    await ctx.addInitScript(`window.__longTasks=[];new PerformanceObserver(l=>{for(const e of l.getEntries())window.__longTasks.push([Math.round(e.startTime),Math.round(e.duration)])}).observe({entryTypes:['longtask']});`);
+    const page = await ctx.newPage();
+    if (mode === 'sync') { await page.goto(preview.url, { waitUntil: 'domcontentloaded' }); await assertHardwareGl(page); }
+    const cdp = await ctx.newCDPSession(page);
+    await cdp.send('Profiler.enable');
+    await cdp.send('Profiler.setSamplingInterval', { interval: 500 });
+    await cdp.send('Profiler.start');
+    const q = mode === 'sync' ? '&worldprep=sync' : '';
+    const t0 = Date.now();
+    await page.goto(`${preview.url}?story=${process.env.PARAVOXIA_ATTRIB_BEAT ?? 'descent'}&movie=1&profile=LOW${q}`, { waitUntil: 'domcontentloaded' });
+    await page.waitForTimeout(WINDOW_MS);
+    const { profile } = await cdp.send('Profiler.stop');
+    const tasks = await page.evaluate(() => window.__longTasks);
+    const { totalMs, top, heavy } = flatten(profile);
+    console.log(`\n===== mode=${mode}  wall ${Date.now() - t0}ms  sampled ${totalMs.toFixed(0)}ms`);
+    console.log('long tasks:', JSON.stringify(tasks));
+    console.log('--- top self time ---'); for (const l of top) console.log(l);
+    console.log('--- heaviest nodes with caller chain ---'); for (const l of heavy) console.log(l);
+    await ctx.close();
+  }
+} finally {
+  await browser.close();
+  preview.stop();
+}
diff --git a/main/tools/boot-stall-probe.mjs b/main/tools/boot-stall-probe.mjs
new file mode 100644
index 0000000..8f7f36e
--- /dev/null
+++ b/main/tools/boot-stall-probe.mjs
@@ -0,0 +1,158 @@
+// --- The boot-stall probe ------------------------------------------------------------
+//
+// Measures main-thread long tasks during a cold entry to a story beat. This is
+// the gate for PARAVOXIA_WORLD_GEN_OFFTHREAD_PLAN.md: every batch must move the
+// numbers it prints, and none may move the terrain fingerprint.
+//
+// Baseline measured 2026-09-04 (LOW, 1280x720, real GB10 GPU): every cold entry
+// costs 2.9-3.6s of long tasks, one ~1.75s block plus 3-4 of 300-650ms, from
+// synchronous procedural generation on the main thread.
+//
+//   npm run perf:boot                       # measure, print, write JSON
+//   npm run perf:boot -- --baseline         # also record as the baseline
+//   npm run perf:boot -- --compare          # fail if worse than the baseline
+//   PARAVOXIA_BOOT_BEATS=descent,ch5-maw npm run perf:boot
+
+import { mkdir, readFile, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import process from 'node:process';
+import { chromium } from 'playwright-core';
+import { CHROMIUM_ARGS, assertHardwareGl, chromePath, startParavoxiaPreview } from './lib/previewServer.mjs';
+
+const args = process.argv.slice(2);
+const baselineMode = args.includes('--baseline');
+const compareMode = args.includes('--compare');
+// `--baseline` measures the LEGACY synchronous boot on the same build via the
+// `?worldprep=sync` probe affordance, so baseline and candidate are an honest
+// A/B rather than two checkouts. PARAVOXIA_BOOT_MODE=sync forces it for any run.
+const bootMode = baselineMode ? 'sync' : (process.env.PARAVOXIA_BOOT_MODE ?? 'worker');
+const extraQuery = bootMode === 'sync' ? '&worldprep=sync' : '';
+const beats = (process.env.PARAVOXIA_BOOT_BEATS ?? 'descent,ch3-dusk,ch8-crossing')
+  .split(',').map(v => v.trim()).filter(Boolean);
+const runs = Number(process.env.PARAVOXIA_BOOT_RUNS ?? 3);
+const profile = process.env.PARAVOXIA_BOOT_PROFILE ?? 'LOW';
+const settleMs = Number(process.env.PARAVOXIA_BOOT_SETTLE_MS ?? 8_000);
+const outputDir = path.resolve(process.env.PARAVOXIA_BOOT_OUTPUT ?? 'captures/boot-stall');
+const baselinePath = path.resolve('tools/baselines/boot-stall.json');
+
+/** Regressions smaller than this are noise on a shared machine. */
+const COMPARE_TOLERANCE = 0.15;
+
+const INIT = `
+window.__longTasks = [];
+new PerformanceObserver(list => {
+  for (const entry of list.getEntries()) {
+    window.__longTasks.push([Math.round(entry.startTime), Math.round(entry.duration)]);
+  }
+}).observe({ entryTypes: ['longtask'] });
+`;
+
+await mkdir(outputDir, { recursive: true });
+const preview = await startParavoxiaPreview({ build: !process.env.PARAVOXIA_URL });
+const browser = await chromium.launch({ headless: true, executablePath: chromePath(), args: CHROMIUM_ARGS });
+{
+  // Fail fast on a software renderer: see CHROMIUM_ARGS.
+  const check = await browser.newPage();
+  await check.goto(preview.url, { waitUntil: 'domcontentloaded' });
+  await assertHardwareGl(check);
+  await check.close();
+}
+
+const results = [];
+try {
+  for (const beat of beats) {
+    for (let run = 0; run < runs; run++) {
+      const context = await browser.newContext({ viewport: { width: 1280, height: 720 }, deviceScaleFactor: 1 });
+      await context.addInitScript(INIT);
+      const page = await context.newPage();
+      const url = `${preview.url}?story=${beat}&movie=1&profile=${profile}${extraQuery}`;
+      const startedAt = Date.now();
+      let failure = null;
+      let tasks = [];
+      const badResponses = [];
+      page.on('response', response => {
+        if (response.status() >= 400) badResponses.push(`${response.status()} ${response.url().slice(-80)}`);
+      });
+      try {
+        // A transient non-2xx from the preview showed up once as
+        // ERR_HTTP_RESPONSE_CODE_FAILURE; retry rather than record a bogus zero.
+        let attempt = 0;
+        for (;;) {
+          try {
+            await page.goto(url, { waitUntil: 'domcontentloaded', timeout: 30_000 });
+            break;
+          } catch (error) {
+            if (++attempt >= 3) throw error;
+            console.warn(`[boot-stall] goto retry ${attempt} for ${beat}: ${String(error?.message ?? error).slice(0, 90)}`);
+            await new Promise(resolve => setTimeout(resolve, 1_500));
+          }
+        }
+        await page.waitForFunction(
+          () => window.__paravoxiaAppState?.phase === 'playing',
+          undefined,
+          { timeout: 90_000 }
+        );
+        await page.waitForTimeout(settleMs);
+        tasks = await page.evaluate(() => window.__longTasks);
+      } catch (error) {
+        failure = String(error?.message ?? error);
+      }
+      const totalMs = tasks.reduce((sum, [, d]) => sum + d, 0);
+      const largestMs = tasks.reduce((max, [, d]) => Math.max(max, d), 0);
+      if (badResponses.length) failure = (failure ? failure + '; ' : '') + `bad responses: ${badResponses.slice(0, 3).join(', ')}`;
+      results.push({ beat, run, mode: bootMode, totalMs, largestMs, count: tasks.length, tasks, failure, wallMs: Date.now() - startedAt });
+      console.log(
+        `[boot-stall] ${beat.padEnd(14)} run ${run}: total ${String(totalMs).padStart(5)}ms`
+        + `  largest ${String(largestMs).padStart(5)}ms  (${tasks.length} tasks)${failure ? `  FAILED: ${failure}` : ''}`
+      );
+      await context.close();
+    }
+  }
+} finally {
+  await browser.close();
+  preview.stop();
+}
+
+/** Median across runs, per beat — the number the plan's gates compare. */
+function summarise(entries) {
+  const byBeat = {};
+  for (const beat of beats) {
+    const own = entries.filter(e => e.beat === beat && !e.failure);
+    const median = key => {
+      const sorted = own.map(e => e[key]).sort((a, b) => a - b);
+      return sorted.length ? sorted[Math.floor(sorted.length / 2)] : null;
+    };
+    byBeat[beat] = { totalMs: median('totalMs'), largestMs: median('largestMs'), runs: own.length };
+  }
+  return byBeat;
+}
+
+const summary = summarise(results);
+const report = { generatedAt: new Date().toISOString(), mode: bootMode, profile, viewport: '1280x720', beats, runs, summary, results };
+await writeFile(path.join(outputDir, 'boot-stall.json'), JSON.stringify(report, null, 2));
+console.log(`\n[boot-stall] mode=${bootMode} median per beat:`);
+for (const [beat, s] of Object.entries(summary)) {
+  console.log(`  ${beat.padEnd(14)} total ${String(s.totalMs).padStart(5)}ms  largest ${String(s.largestMs).padStart(5)}ms  (${s.runs} runs)`);
+}
+
+if (baselineMode) {
+  await mkdir(path.dirname(baselinePath), { recursive: true });
+  await writeFile(baselinePath, JSON.stringify({ generatedAt: report.generatedAt, mode: bootMode, profile, summary }, null, 2));
+  console.log(`[boot-stall] baseline written: ${baselinePath}`);
+}
+
+let exitCode = results.some(r => r.failure) ? 1 : 0;
+if (compareMode) {
+  const baseline = JSON.parse(await readFile(baselinePath, 'utf8'));
+  for (const [beat, s] of Object.entries(summary)) {
+    const b = baseline.summary?.[beat];
+    if (!b || s.totalMs === null) continue;
+    for (const key of ['totalMs', 'largestMs']) {
+      if (s[key] > b[key] * (1 + COMPARE_TOLERANCE)) {
+        console.error(`[boot-stall] REGRESSION ${beat} ${key}: ${s[key]}ms vs baseline ${b[key]}ms`);
+        exitCode = 1;
+      }
+    }
+  }
+}
+process.exit(exitCode);
diff --git a/main/tools/chapter-evidence.mjs b/main/tools/chapter-evidence.mjs
new file mode 100644
index 0000000..d8c617f
--- /dev/null
+++ b/main/tools/chapter-evidence.mjs
@@ -0,0 +1,261 @@
+#!/usr/bin/env node
+// --- Chapter evidence ------------------------------------------------------------------
+//
+// The deterministic adapter for the acceptance workflow's
+// `capture-chapter-boundary-and-av` step, and the tool that makes the final
+// gate reachable by an unattended run: it produces the headed real-GPU
+// evidence the gate demands (continuous video, HUD-suppressed frames, a
+// contact sheet, flicker scalars, a text digest) as a percept
+// `capture-bundle-v1` under <run>/evidence/bundle/, and lists it for the
+// reviewers twin-first.
+//
+//   node tools/chapter-evidence.mjs --chapter ch10 --run <runDir> [--lane movie|manual]
+//        [--beats ch10-cold,ch10-ask] [--video] [--cap-s 150] [--strip-s 4]
+//        [--settle-s 8] [--profile HIGH] [--agent] [--no-build] [--audio a.wav,b.wav]
+//
+// Per beat it opens `?story=<beat>&movie=1&journeyprobe=1`, settles, shoots the
+// opening still at +2 s, then runs one capture session: a coverage strip every
+// --strip-s, a trigger frame the first time each registry checkpoint milestone
+// latches and each required signed-AV anchor activates (the salience signal
+// this game actually has), an adjacent-frame burst on entry and one on the
+// beat's first anchor activation, and stops three seconds after the beat's
+// checkpoint milestone or at --cap-s.
+//
+// Exit 1 on a software renderer, any blank still, or any burst that reads as
+// flicker (flickerRatio > 2.5 AND signFlips > 0.40). The bundle is still
+// written so the defect can be looked at.
+
+import { existsSync, mkdirSync, readFileSync, writeFileSync, statSync } from 'node:fs';
+import { join, resolve, dirname, relative } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { execSync, spawnSync } from 'node:child_process';
+import process from 'node:process';
+import { startParavoxiaPreview } from './lib/previewServer.mjs';
+import {
+  openParavoxia, waitReady, readState, captureSession, composeSheet, writeDigest, writeBundle,
+  CAPTURE_TIER, sha256, probeMedia,
+} from './lib/evidence.mjs';
+
+const HERE = dirname(fileURLToPath(import.meta.url));
+const MAIN = resolve(HERE, '..');
+const ROOT = resolve(MAIN, '..');
+const arg = (name, fallback = null) => {
+  const i = process.argv.indexOf(`--${name}`);
+  return i >= 0 && process.argv[i + 1] !== undefined && !process.argv[i + 1].startsWith('--') ? process.argv[i + 1] : fallback;
+};
+const has = (name) => process.argv.includes(`--${name}`);
+const tag = (m) => console.log(`[chapter-evidence] ${m}`);
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+
+const chapterId = arg('chapter');
+const runDir = arg('run');
+if (!chapterId || !runDir) {
+  console.error('usage: node tools/chapter-evidence.mjs --chapter <id> --run <runDir> [--lane movie|manual] [--beats a,b] [--video]');
+  process.exit(2);
+}
+const lane = arg('lane', 'movie');
+const capS = Number(arg('cap-s', '150'));
+const stripS = Number(arg('strip-s', '4'));
+const settleS = Number(arg('settle-s', '8'));
+const profile = arg('profile', 'HIGH');
+const wantVideo = has('video');
+const useAgent = has('agent');
+const audioFiles = (arg('audio') ? arg('audio').split(',') : []).map((f) => resolve(runDir, f)).filter((f) => existsSync(f));
+// the run's own identity, when this is a governed run dir (the gate binds every artifact to these)
+const readJsonIf = (p) => (existsSync(p) ? JSON.parse(readFileSync(p, 'utf8')) : null);
+const contract = readJsonIf(join(runDir, 'scene-contract.json'));
+const lock = readJsonIf(join(runDir, 'production-lock.json'));
+const contractSha256 = existsSync(join(runDir, 'scene-contract.json')) ? sha256(readFileSync(join(runDir, 'scene-contract.json'))) : null;
+
+// ------------------------------------------------------------- the chapter ---
+const registry = JSON.parse(readFileSync(join(MAIN, 'chapter-registry.json'), 'utf8'));
+const chapters = registry.chapters ?? registry;
+const chapter = (Array.isArray(chapters) ? chapters : Object.values(chapters)).find((c) => c.id === chapterId);
+if (!chapter) { console.error(`chapter ${chapterId} not in chapter-registry.json`); process.exit(2); }
+const journey = JSON.parse(readFileSync(join(MAIN, 'chapter-journey-contract.json'), 'utf8'));
+const jChapters = journey.chapters ?? {};
+const jChapter = Array.isArray(jChapters) ? jChapters.find((c) => c.id === chapterId) : jChapters[chapterId];
+const anchorIds = jChapter?.registryProjection?.requiredSignedAnchorIds ?? [];
+const beats = (arg('beats') ? arg('beats').split(',') : chapter.beats).filter(Boolean);
+const checkpointFor = (beat) => (chapter.checkpoints ?? []).find((c) => c.beat === beat) ?? null;
+const milestoneRefs = (beat) => {
+  const cp = checkpointFor(beat);
+  const refs = [...(cp?.evidenceRefs ?? []), ...(cp?.milestone ? [`milestone:${cp.milestone}`] : [])];
+  return refs.filter((r) => r.startsWith('milestone:')).map((r) => r.slice('milestone:'.length));
+};
+const buildSha = (() => { try { return execSync('git rev-parse --short HEAD', { cwd: ROOT, encoding: 'utf8' }).trim(); } catch { return null; } })();
+
+const bundleDir = resolve(runDir, 'evidence', 'bundle');
+mkdirSync(bundleDir, { recursive: true });
+const videoDir = join(bundleDir, 'video');
+if (wantVideo) mkdirSync(videoDir, { recursive: true });
+
+// ------------------------------------------------------------------ capture ---
+const preview = await startParavoxiaPreview({ build: !has('no-build') && !process.env.PARAVOXIA_URL, log: tag });
+const allFrames = [];
+const allBursts = [];
+const sessions = [];
+const videos = [];
+let nextIndex = 0;
+let clockOffset = 0;
+let renderer = null;
+let lastSheetPage = null;
+let exitCode = 0;
+let sheet = null;
+
+try {
+  for (const beat of beats) {
+    const q = new URLSearchParams({ story: beat, journeyprobe: '1', profile });
+    if (lane === 'movie') q.set('movie', '1');
+    if (useAgent) q.set('agent', '1');
+    const url = `/?${q.toString()}`;
+    tag(`beat ${beat}: ${url}`);
+    const opened = await openParavoxia({
+      url, preview, log: tag,
+      recordVideo: wantVideo ? { dir: videoDir } : null,
+    });
+    renderer = opened.renderer;
+    const { page } = opened;
+    try {
+      await waitReady(page, { settleMs: settleS * 1000 });
+      const entryState = await readState(page);
+      const milestones = milestoneRefs(beat);
+      const exitMilestone = checkpointFor(beat)?.milestone ?? null;
+      const seenMilestones = new Set(entryState.milestones ?? []);
+      const seenAnchors = new Set(entryState.av?.activationHistoryAnchorIds ?? []);
+      let exitAt = null;
+      let climaxBurstAdded = false;
+
+      const session = await captureSession(page, bundleDir, {
+        startIndex: nextIndex, clockOffset, capMs: capS * 1000, stripIntervalS: stripS, log: tag,
+        stills: [{ id: 'opening-2.0s', role: 'still', settleMs: 2000 }],
+        bursts: [{ id: 'entry', from: 3, to: 5.5, perBeat: true }],
+        events: [
+          ...milestones.map((m) => ({ key: `milestone:${m}`, pred: (s) => !seenMilestones.has(m) && (s.milestones ?? []).includes(m) })),
+          ...anchorIds.map((a) => ({ key: `anchor:${a}`, pred: (s) => !seenAnchors.has(a) && (s.av?.activationHistoryAnchorIds ?? []).includes(a) })),
+          { key: 'caption-first', pred: (s) => !!s.caption && s.caption !== entryState.caption },
+          { key: 'objective-change', pred: (s) => s.objectiveId !== entryState.objectiveId },
+        ],
+        onState: (s, clock, addBurst) => {
+          const hist = s.av?.activationHistoryAnchorIds ?? [];
+          if (!climaxBurstAdded && hist.some((a) => anchorIds.includes(a) && !seenAnchors.has(a))) {
+            climaxBurstAdded = true;
+            addBurst(clock, clock + 2.5, `${beat}-climax`);
+          }
+          if (exitMilestone && exitAt == null && (s.milestones ?? []).includes(exitMilestone) && !seenMilestones.has(exitMilestone)) exitAt = clock;
+          if (exitAt != null && clock - exitAt > 3) return 'stop';
+          return null;
+        },
+      });
+      nextIndex = session.nextIndex;
+      clockOffset = session.clockOffset;
+      allFrames.push(...session.frames);
+      allBursts.push(...session.bursts);
+      sessions.push({ id: beat, url, frames: session.frames.length, bursts: session.bursts.length,
+        pageErrors: opened.pageErrors, reachedExit: exitAt != null, completedEvents: session.frames.filter((f) => f.role === 'trigger').map((f) => f.label),
+        note: `${session.frames.length} frames, ${session.bursts.length} bursts, exit milestone ${exitMilestone ?? 'n/a'} ${exitAt != null ? `reached at t=${exitAt.toFixed(1)}s` : 'NOT reached'}; page errors: ${opened.pageErrors.length}` });
+      // the sheet is composed in-page; keep the last live page for it
+      lastSheetPage = page;
+      sheet = await composeSheet(page, bundleDir, allFrames, { title: `${chapterId} ${lane} ${CAPTURE_TIER}` });
+    } finally {
+      const video = wantVideo ? page.video() : null;
+      await opened.context.close().catch(() => {});
+      if (video) {
+        const p = await video.path().catch(() => null);
+        if (p && existsSync(p)) videos.push({ beat, file: relative(bundleDir, p), bytes: statSync(p).size, sha256: sha256(readFileSync(p)) });
+      }
+      await opened.browser.close().catch(() => {});
+    }
+  }
+} finally {
+  preview.stop();
+}
+
+// ------------------------------------------------------------------ outputs ---
+const capture = {
+  tier: CAPTURE_TIER, adapter: renderer, headed: CAPTURE_TIER === 'hardware-high',
+  resolution: { w: 1280, h: 720 }, seed: `${lane}:${profile}`, clock: allFrames[0]?.clock ?? 'wall-since-settle',
+  buildSha, viewport: '1280x720',
+};
+const digest = writeDigest(bundleDir, { subject: { id: `${chapterId}@${lane}` }, capture, frames: allFrames, bursts: allBursts, sessions });
+const manifest = await writeBundle(bundleDir, {
+  subject: { id: `${chapterId}@${lane}`, kind: 'paravoxia-chapter' },
+  capture, frames: allFrames, bursts: allBursts, sheet, digest,
+  provenance: { chapter: chapterId, lane, beats, videos, sessions: sessions.map(({ note, ...s }) => s) },
+});
+
+// reviewer-facing rows: twin first, HUD composite marked audit-only
+const rows = [];
+const mediaRow = (rel, extra) => {
+  const abs = join(bundleDir, rel);
+  return { path: `evidence/bundle/${rel}`, bytes: statSync(abs).size, sha256: sha256(readFileSync(abs)), probe: probeMedia(abs), ...extra };
+};
+for (const f of manifest.frames) {
+  rows.push(mediaRow(f.file, { label: f.label ?? f.role, beat: f.beat, role: f.role, frameIndex: f.frame, storyClockS: f.simTime,
+    capture: 'hud-suppressed frame of record' }));
+}
+for (const f of manifest.frames) {
+  rows.push(mediaRow(f.hudFile, { label: `${f.label ?? f.role}-hud`, beat: f.beat, frameIndex: f.frame,
+    capture: 'hud composite (audit only — not reviewer evidence)' }));
+}
+// The gate's continuous video must carry an audio stream; Playwright records
+// picture only, so the first score render given with --audio is muxed under the
+// first beat's video (picture copied, audio to opus, cut to the shorter track).
+if (videos.length && audioFiles.length) {
+  const v = videos[0];
+  const muxed = v.file.replace(/\.webm$/, '-av.webm');
+  const mux = spawnSync('ffmpeg', ['-y', '-v', 'error', '-i', join(bundleDir, v.file), '-i', audioFiles[0],
+    '-c:v', 'copy', '-c:a', 'libopus', '-shortest', join(bundleDir, muxed)], { encoding: 'utf8' });
+  if (mux.status === 0 && existsSync(join(bundleDir, muxed))) {
+    videos[0] = { ...v, file: muxed, bytes: statSync(join(bundleDir, muxed)).size, sha256: sha256(readFileSync(join(bundleDir, muxed))), audioFrom: relative(runDir, audioFiles[0]) };
+    tag(`continuous video muxed with ${relative(runDir, audioFiles[0])} → ${muxed}`);
+  } else tag(`WARNING: could not mux audio into the continuous video (${mux.stderr?.trim() || 'ffmpeg failed'}); the gate's raw-evidence.video audio requirement will not be met`);
+} else if (videos.length) tag('NOTE: continuous video has no audio track (pass --audio <score.wav> to mux the score render in); the gate requires one');
+const videoRows = videos.map((v) => mediaRow(v.file, { beat: v.beat, container: 'webm', ...(v.audioFrom ? { audioFrom: v.audioFrom } : {}) }));
+const audioRows = audioFiles.map((abs) => ({ path: relative(runDir, abs), bytes: statSync(abs).size, sha256: sha256(readFileSync(abs)), probe: probeMedia(abs), kind: 'score-render' }));
+const raw = {
+  schema: 'paravoxia.rawAudiovisualEvidence.v1',
+  runId: lock?.runId ?? relative(ROOT, resolve(runDir)),
+  contractVersion: contract?.contractVersion ?? null, contractSha256,
+  sourceRevision: lock?.sourceRevision ?? buildSha, workingTree: buildSha,
+  chapter: chapterId, lane, compiledAt: new Date().toISOString(),
+  containsCreativeIntent: false,
+  intentFreeInstructions: 'Open only the files listed here, in this order, and read nothing else first. Rows marked "hud-suppressed frame of record" are the frames to judge; rows marked "audit only" are the same instants with the HUD layer shown and exist for auditors, not reviewers. sheet.png is the chronological contact sheet and its red numbers are the frameIndex values in this list. digest.md answers every timing, order and causality question; frames are for shape, colour, composition and light.',
+  playbackMetadata: {
+    frameSize: '1280x720', frameFormat: 'png', audioFormat: audioRows.length ? 'wav' : null, colourManagement: 'none',
+    renderer, tier: CAPTURE_TIER, headed: capture.headed, clock: capture.clock,
+    instructions: 'View frames at 1280x720, one at a time, in list order; view the contact sheet whole; play the continuous video once before examining frames.',
+  },
+  continuousVideo: videoRows[0] ?? null,
+  additionalVideo: videoRows.slice(1),
+  contactSheet: sheet ? mediaRow('sheet.png', { kind: 'contact-sheet' }) : null,
+  digest: { path: 'evidence/bundle/digest.md', sha256: digest.sha256 },
+  frameStrips: rows,
+  audio: audioRows,
+  bursts: allBursts,
+};
+const rawPath = join(runDir, 'raw-audiovisual-evidence.json');
+const rawTarget = existsSync(rawPath) ? join(runDir, 'raw-audiovisual-evidence.bundle.json') : rawPath;
+writeFileSync(rawTarget, `${JSON.stringify(raw, null, 2)}\n`);
+// registry rows in the gate's entry shape (ref/path/sha256/kind/description/bytes), ready to merge
+// into the run's evidence-registry.json; percept:* refs are what a scorecard cites
+const slug = (p) => p.replace(/^evidence\/bundle\//, '').replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '').toLowerCase();
+const registryRows = [
+  { ref: 'percept:bundle', path: 'evidence/bundle/bundle.json', sha256: sha256(readFileSync(join(bundleDir, 'bundle.json'))), kind: 'artifact', description: 'percept capture-bundle-v1 manifest (hash-bound frames, bursts, sheet, digest)', bytes: statSync(join(bundleDir, 'bundle.json')).size },
+  ...(sheet ? [{ ref: 'capture:contact-sheet', path: 'evidence/bundle/sheet.png', sha256: sheet.sha256, kind: 'frame', description: 'chronological contact sheet; red numbers are frame indices', bytes: statSync(join(bundleDir, 'sheet.png')).size }] : []),
+  { ref: 'percept:digest', path: 'evidence/bundle/digest.md', sha256: digest.sha256, kind: 'document', description: 'temporal digest: beat/objective/caption/anchor timeline and burst scalars', bytes: statSync(join(bundleDir, 'digest.md')).size },
+  ...rows.map((r) => ({ ref: `capture:${slug(r.path)}`, path: r.path, sha256: r.sha256, kind: 'frame', description: r.capture.startsWith('hud composite') ? `HUD composite (audit only) frame ${r.frameIndex}` : `HUD-suppressed frame of record ${r.frameIndex} (${r.label}, ${r.beat})`, bytes: r.bytes })),
+  ...videoRows.map((v) => ({ ref: `capture:${slug(v.path)}`, path: v.path, sha256: v.sha256, kind: 'trace', description: `continuous movie-lane video, beat ${v.beat}`, bytes: v.bytes })),
+];
+writeFileSync(join(bundleDir, 'evidence-registry.bundle.json'), `${JSON.stringify({ schema: 'paravoxia.evidenceRegistry.bundle.v1', generatedAt: new Date().toISOString(), entries: registryRows }, null, 2)}\n`);
+
+// ------------------------------------------------------------------ verdict ---
+const blankStills = manifest.frames.filter((f) => (f.role === 'still' || f.role === 'trigger') && f.stats?.blank);
+const flicker = allBursts.filter((b) => b.flickerRatio > 2.5 && (b.signFlipRatio ?? 0) > 0.4);
+if (CAPTURE_TIER !== 'hardware-high') { tag(`software renderer (${renderer}) — evidence is ${CAPTURE_TIER}, not the delivered look`); exitCode = 1; }
+if (blankStills.length) { tag(`BLANK stills: ${blankStills.map((f) => f.file).join(', ')}`); exitCode = 1; }
+if (flicker.length) { tag(`FLICKER: ${flicker.map((b) => `t=${b.t0}s ratio=${b.flickerRatio} flips=${b.signFlipRatio}`).join('; ')}`); exitCode = 1; }
+tag(`bundle ${bundleDir}: ${manifest.frames.length} frames (${manifest.frames.filter((f) => f.role === 'burst').length} burst), ${allBursts.length} bursts, sheet=${sheet ? sheet.tiles + ' tiles' : 'none'}, videos=${videos.length}, tier=${CAPTURE_TIER}, renderer=${renderer}`);
+tag(`reviewer rows → ${relative(ROOT, rawTarget)}${rawTarget !== rawPath ? ' (existing raw-audiovisual-evidence.json left untouched)' : ''}`);
+for (const s of sessions) tag(`  ${s.id}: ${s.note}`);
+process.exit(exitCode);
diff --git a/main/tools/cockpit-probe.mjs b/main/tools/cockpit-probe.mjs
new file mode 100644
index 0000000..b5f7232
--- /dev/null
+++ b/main/tools/cockpit-probe.mjs
@@ -0,0 +1,146 @@
+// --- The cockpit probe ---------------------------------------------------------------
+//
+// Boots its own dev server on a free port, drops straight into flight (`?fly=1`),
+// and captures the Kestrel flight deck at rest and under boost, alongside the
+// cockpit's draw statistics and a few rAF fps samples. Then it tears the server
+// down again.
+//
+//   node tools/cockpit-probe.mjs                     # 1280x720, ULTRA
+//   node tools/cockpit-probe.mjs out ULTRA 2560 720  # ultrawide, where the
+//                                                    # peripheral MFDs live
+//
+// Two things here are deliberate rather than incidental:
+//
+// * It owns its port. Another project on this machine took a fixed probe port
+//   mid-session and the probe happily measured THAT app — it rendered, it
+//   returned 200, and nothing looked wrong. So this asks for a free port and
+//   then checks the served page is actually Paravoxia before trusting a frame.
+// * It samples fps at the requested resolution rather than a fixed one. The
+//   cockpit is a near-field surface covering most of the screen, so its cost is
+//   fill rate; a 720p sample says nothing about whether it holds up at 1440p.
+//
+// Note that boost samples fly the ship at speed, which streams world chunks —
+// those numbers measure the world as much as the cabin. The at-rest samples are
+// the ones that isolate the cockpit.
+
+import { chromium } from 'playwright-core';
+import { spawn } from 'node:child_process';
+import { createServer } from 'node:net';
+import os from 'node:os';
+import path from 'node:path';
+import fs from 'node:fs';
+
+const outDir = process.argv[2] ?? path.join(os.tmpdir(), 'paravoxia-cockpit');
+const profile = process.argv[3] ?? 'ULTRA';
+const width = Number(process.argv[4] ?? 1280);
+const height = Number(process.argv[5] ?? 720);
+const settleS = Number(process.argv[6] ?? 14);
+
+function freePort() {
+  return new Promise((resolve, reject) => {
+    const server = createServer();
+    server.unref();
+    server.on('error', reject);
+    server.listen(0, '127.0.0.1', () => {
+      const { port } = server.address();
+      server.close(() => resolve(port));
+    });
+  });
+}
+
+async function waitForParavoxia(url, timeoutMs = 60_000) {
+  const deadline = Date.now() + timeoutMs;
+  let lastError = 'no response';
+  while (Date.now() < deadline) {
+    try {
+      const body = await (await fetch(url)).text();
+      // Identity, not liveness: a 200 from somebody else's dev server is exactly
+      // how a probe ends up measuring the wrong program.
+      if (body.includes('<title>Paravoxia</title>')) return;
+      lastError = `served a page that is not Paravoxia (${body.length} bytes)`;
+    } catch (error) {
+      lastError = String(error?.message ?? error);
+    }
+    await new Promise(resolve => setTimeout(resolve, 500));
+  }
+  throw new Error(`Dev server never served Paravoxia at ${url}: ${lastError}`);
+}
+
+fs.mkdirSync(outDir, { recursive: true });
+
+const port = await freePort();
+const url = `http://127.0.0.1:${port}/`;
+const server = spawn('npx', ['vite', '--port', String(port), '--strictPort'], {
+  stdio: 'ignore',
+  // The watcher is off because `npm run dev` exhausts this machine's inotify
+  // limit on the captures tree; the probe only ever loads each module once.
+  env: { ...process.env, PROBE_NO_HMR: '1' }
+});
+
+let browser;
+try {
+  await waitForParavoxia(url);
+  console.log(`[cockpit-probe] ${url} profile=${profile} ${width}x${height}`);
+
+  const pwDir = path.join(os.homedir(), '.cache/ms-playwright');
+  const chromeDir = fs.readdirSync(pwDir)
+    .filter(name => /^chromium-\d+$/.test(name))
+    .sort()
+    .pop();
+  const executablePath = path.join(pwDir, chromeDir, 'chrome-linux/chrome');
+
+  browser = await chromium.launch({
+    executablePath,
+    headless: true,
+    args: [
+      '--enable-unsafe-swiftshader',
+      '--use-gl=angle',
+      '--disable-background-timer-throttling',
+      '--disable-renderer-backgrounding'
+    ]
+  });
+  const page = await browser.newPage({ viewport: { width, height } });
+  page.on('pageerror', error => console.log(`[pageerror] ${error.message}`));
+  page.on('console', message => {
+    if (message.type() === 'error') console.log(`[console.error] ${message.text().slice(0, 600)}`);
+  });
+
+  await page.goto(`${url}?fly=1&systemprobe=1&profile=${profile}`, { waitUntil: 'load' });
+  await page.waitForFunction(() => window.__paravoxiaShipProbe, null, { timeout: 60_000 });
+  await new Promise(resolve => setTimeout(resolve, settleS * 1000));
+
+  const stats = await page.evaluate(() => window.__paravoxiaShipProbe.getCockpitStats());
+  console.log(`[cockpit-probe] draws=${stats.meshes} triangles=${stats.triangles} materials=${stats.materials}`);
+
+  const sample = () => page.evaluate(() => new Promise(resolve => {
+    let frames = 0;
+    const begin = performance.now();
+    const count = () => {
+      frames++;
+      if (performance.now() - begin < 2000) requestAnimationFrame(count);
+      else resolve(Math.round(frames / ((performance.now() - begin) / 1000)));
+    };
+    requestAnimationFrame(count);
+  }));
+
+  await page.screenshot({ path: path.join(outDir, 'cockpit-idle.png') });
+  const rest = [];
+  for (let i = 0; i < 3; i++) rest.push(await sample());
+  console.log(`[cockpit-probe] at rest: [${rest.join(', ')}] fps`);
+
+  await page.mouse.click(Math.round(width / 2), Math.round(height / 2)).catch(() => {});
+  await page.keyboard.down('KeyW');
+  await page.keyboard.down('ShiftLeft');
+  await new Promise(resolve => setTimeout(resolve, 4000));
+  await page.screenshot({ path: path.join(outDir, 'cockpit-boost.png') });
+  const boost = [];
+  for (let i = 0; i < 2; i++) boost.push(await sample());
+  await page.keyboard.up('KeyW');
+  await page.keyboard.up('ShiftLeft');
+  console.log(`[cockpit-probe] under boost: [${boost.join(', ')}] fps (also measures world streaming)`);
+  console.log(`[cockpit-probe] wrote ${outDir}/cockpit-{idle,boost}.png`);
+} finally {
+  if (browser) await browser.close().catch(() => {});
+  server.kill();
+}
+process.exit(0);
diff --git a/main/tools/deploy.mjs b/main/tools/deploy.mjs
new file mode 100644
index 0000000..f515026
--- /dev/null
+++ b/main/tools/deploy.mjs
@@ -0,0 +1,52 @@
+#!/usr/bin/env node
+// --- Deploy through the front door ---------------------------------------------------
+//
+// The ch10 run shipped mid-run from an uncommitted tree because nothing in the
+// governance chain stood between a shell and `firebase deploy`. This wrapper
+// is the front door: it refuses a dirty tree unless told otherwise, runs
+// `npm run verify` (typecheck, tests, gates, build) and only then deploys,
+// recording the exact commit it shipped to .codex/deploys.jsonl.
+//
+//   npm run deploy                       # verify, then firebase deploy --only hosting
+//   npm run deploy -- --allow-dirty      # deploy an uncommitted tree (the ch10 mistake, on purpose)
+//   npm run deploy -- --skip-verify      # owner escape hatch; recorded as such
+//
+// firebase.json's own predeploy hook is a protected path in the chapter
+// contract and changes only on the owner's decision
+// (owner-decision-firebase-predeploy-gate); this wrapper does not depend on it.
+
+import { execSync, spawnSync } from 'node:child_process';
+import { appendFileSync, mkdirSync } from 'node:fs';
+import { join, resolve, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import process from 'node:process';
+
+const MAIN = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const ROOT = resolve(MAIN, '..');
+const has = (f) => process.argv.includes(f);
+const git = (args) => execSync(`git ${args}`, { cwd: ROOT, encoding: 'utf8' }).trim();
+const tag = (m) => console.log(`[deploy] ${m}`);
+
+const sha = git('rev-parse HEAD');
+const branch = git('branch --show-current');
+const dirty = git('status --porcelain').split('\n').filter(Boolean);
+if (dirty.length && !has('--allow-dirty')) {
+  console.error(`[deploy] refusing: ${dirty.length} uncommitted change(s) on ${branch}. Commit, or pass --allow-dirty to ship an uncommitted tree deliberately.`);
+  process.exit(2);
+}
+tag(`${branch} @ ${sha.slice(0, 12)}${dirty.length ? ` (+${dirty.length} uncommitted, --allow-dirty)` : ''}`);
+
+let verify = 'skipped';
+if (!has('--skip-verify')) {
+  tag('verify…');
+  const v = spawnSync('npm', ['run', 'verify'], { cwd: MAIN, stdio: 'inherit' });
+  if (v.status !== 0) { console.error('[deploy] refusing: verify failed'); process.exit(1); }
+  verify = 'passed';
+} else tag('verify SKIPPED (--skip-verify)');
+
+const d = spawnSync('firebase', ['deploy', '--only', 'hosting'], { cwd: ROOT, stdio: 'inherit' });
+const record = { deployedAt: new Date().toISOString(), sha, branch, dirty: dirty.length, verify, exit: d.status ?? 1 };
+mkdirSync(join(ROOT, '.codex'), { recursive: true });
+appendFileSync(join(ROOT, '.codex', 'deploys.jsonl'), `${JSON.stringify(record)}\n`);
+tag(`${d.status === 0 ? 'deployed' : 'FAILED'} — recorded in .codex/deploys.jsonl`);
+process.exit(d.status ?? 1);
diff --git a/main/tools/hit-sync-probe.mjs b/main/tools/hit-sync-probe.mjs
new file mode 100644
index 0000000..8ea425c
--- /dev/null
+++ b/main/tools/hit-sync-probe.mjs
@@ -0,0 +1,235 @@
+#!/usr/bin/env node
+// Stage 3 composed-sync LIVE probe (audio-10x run): boots `?story=<beat>&movie=1`
+// on an ephemeral HMR-off vite server, unlocks audio exactly as fps-score-probe
+// does, and records, per contracted anchor that fires in the beat:
+//   - the HitSchedule (audioTime, armedAt, perfTime, quantumLanded, slackMs, onsetAttackMs),
+//   - the bundle derivation (bundleAt, latencyComp terms and sample-rate key),
+//   - the tick the STATE members ran, the tick the presentation fired, and the
+//     tick the SFX member was posted + the audio time it was scheduled to,
+//   - the rAF frame series around the fire, so the image frame offset against
+//     the audible onset is measured (-1/+2 frame budget),
+//   - a dense frame strip (-3..+3 around the fire) from the CDP screencast with a
+//     burned-in DOM overlay (audioTime, armedAt, bundleAt, latencyCompMs + key,
+//     device/music terms, beatClock≈, sfxAudioTime, ctx.currentTime, perf now).
+//
+//   node tools/hit-sync-probe.mjs <outDir> --beat a1-ramp [--start ch1-anomaly] [--runs 3] [--timeout 120] [--no-strips]
+import fs from 'node:fs';
+import net from 'node:net';
+import os from 'node:os';
+import path from 'node:path';
+import { spawn } from 'node:child_process';
+import { chromium } from 'playwright-core';
+
+const args = process.argv.slice(2);
+const outDir = args.find((a) => !a.startsWith('--'));
+const flag = (n, d) => { const i = args.indexOf(`--${n}`); return i >= 0 && i + 1 < args.length ? args[i + 1] : d; };
+const beat = flag('beat', null);
+// --start: the beat the movie lane boots into; the story then ADVANCES into `beat`
+// on its own, so the target's arming tick happens with the world assembled and
+// the frame loop steady (a deep link straight into the target arms during boot).
+const start = flag('start', beat);
+const runs = Math.max(1, Number(flag('runs', 3)));
+const timeoutS = Number(flag('timeout', 120));
+const strips = !args.includes('--no-strips');
