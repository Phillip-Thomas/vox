+        planetSeed: SOAK_HOME_SEED,
+        archetype: SOAK_HOME_ARCHETYPE,
+        seconds,
+        scenario: 'sandboxDay',
+        script: eraPinnedScript(SOAK_HOME_SEED, seconds, 0, BARE_STORY_HANDOFF_AT_S),
+        storyHandoffBeat: 'ch1-fixed',
