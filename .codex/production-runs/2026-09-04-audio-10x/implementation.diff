index 0000000..557ca65
--- /dev/null
+++ b/main/tools/audio-mood-identity-probe.mjs
@@ -0,0 +1,183 @@
+#!/usr/bin/env node
+// Stage 3 MOODS-as-constraints identity probe (audio-10x run): renders every
+// authored mood entry for MOOD_IDENTITY_SECONDS through the REAL instrument on
+// the score-soak harness and writes one hash line per mood.
+//
+//   node tools/audio-mood-identity-probe.mjs <out.json> [--only name,name]
+//
+// Run once BEFORE an instrument edit and once after; `audio-mood-identity-compare`
+// (inline below via --compare a.json b.json) reports which moods changed.
+import fs from 'node:fs';
+import net from 'node:net';
+import os from 'node:os';
+import path from 'node:path';
+import { spawn } from 'node:child_process';
+import { chromium } from 'playwright-core';
+
+const args = process.argv.slice(2);
+// WAV PCM16 reader (stereo interleaved) → per-channel Int16 arrays.
+function readWavPcm16(file) {
+  const buf = fs.readFileSync(file);
+  const channels = buf.readUInt16LE(22);
+  const sampleRate = buf.readUInt32LE(24);
+  let off = 12;
+  let dataOff = -1;
+  let dataLen = 0;
+  while (off + 8 <= buf.length) {
+    const id = buf.toString('ascii', off, off + 4);
+    const len = buf.readUInt32LE(off + 4);
+    if (id === 'data') { dataOff = off + 8; dataLen = len; break; }
+    off += 8 + len + (len % 2);
+  }
+  const frames = Math.floor(dataLen / 2 / channels);
+  const out = Array.from({ length: channels }, () => new Int16Array(frames));
+  for (let i = 0; i < frames; i++) for (let c = 0; c < channels; c++) out[c][i] = buf.readInt16LE(dataOff + (i * channels + c) * 2);
+  return { channels: out, sampleRate, frames };
+}
+function compareWavDirs(dirA, dirB) {
+  const rows = [];
+  for (const f of fs.readdirSync(dirA).filter((n) => n.endsWith('.wav')).sort()) {
+    const fb = path.join(dirB, f);
+    if (!fs.existsSync(fb)) { rows.push({ name: f.replace(/\.wav$/, ''), missing: true }); continue; }
+    const a = readWavPcm16(path.join(dirA, f));
+    const b = readWavPcm16(fb);
+    const n = Math.min(a.frames, b.frames);
+    let maxLsb = 0, diffSamples = 0, sumSqA = 0, sumSqB = 0, sumSqD = 0, firstDiff = -1;
+    for (let c = 0; c < a.channels.length; c++) {
+      const ca = a.channels[c], cb = b.channels[c];
+      for (let i = 0; i < n; i++) {
+        const d = cb[i] - ca[i];
+        if (d !== 0) { diffSamples++; if (firstDiff < 0 || i < firstDiff) firstDiff = i; }
+        const ad = Math.abs(d); if (ad > maxLsb) maxLsb = ad;
+        sumSqA += ca[i] * ca[i]; sumSqB += cb[i] * cb[i]; sumSqD += d * d;
+      }
+    }
+    const rmsA = Math.sqrt(sumSqA / (n * a.channels.length)) / 32768, rmsB = Math.sqrt(sumSqB / (n * a.channels.length)) / 32768;
+    const rmsD = Math.sqrt(sumSqD / (n * a.channels.length)) / 32768;
+    rows.push({
+      name: f.replace(/\.wav$/, ''), frames: n, maxAbsDeltaLsb: maxLsb, diffSampleFraction: diffSamples / (n * a.channels.length),
+      firstDiffS: firstDiff < 0 ? null : firstDiff / a.sampleRate,
+      rmsDeltaDb: rmsA > 0 ? 20 * Math.log10(rmsB / rmsA) : null,
+      residualDbfs: rmsD > 0 ? 20 * Math.log10(rmsD) : -Infinity,
+      identical: maxLsb === 0
+    });
+  }
+  return rows;
+}
+if (args[0] === '--compare-wav') {
+  const rows = compareWavDirs(args[1], args[2]);
+  const identical = rows.filter((r) => r.identical).length;
+  console.log(JSON.stringify({ before: args[1], after: args[2], moods: rows.length, identical, changed: rows.length - identical,
+    maxAbsDeltaLsb: Math.max(...rows.map((r) => r.maxAbsDeltaLsb ?? 0)),
+    worstResidualDbfs: Math.max(...rows.map((r) => (r.residualDbfs ?? -Infinity))), rows }, null, 2));
+  process.exit(0);
+}
+if (args[0] === '--compare') {
+  const a = JSON.parse(fs.readFileSync(args[1], 'utf8'));
+  const b = JSON.parse(fs.readFileSync(args[2], 'utf8'));
+  let changed = 0;
+  const rows = [];
+  for (const name of Object.keys(a.moods)) {
+    const same = b.moods[name] && a.moods[name].pcmSha256 === b.moods[name].pcmSha256;
+    if (!same) changed++;
+    rows.push({ name, identical: Boolean(same), before: a.moods[name].pcmSha256.slice(0, 16), after: b.moods[name]?.pcmSha256.slice(0, 16) ?? null });
+  }
+  const report = { before: args[1], after: args[2], moods: rows.length, changed, identical: rows.length - changed, rows };
+  console.log(JSON.stringify(report, null, 2));
+  process.exit(0);
+}
+const outFile = args.find((a) => !a.startsWith('--'));
+if (!outFile) {
+  console.error('usage: audio-mood-identity-probe.mjs <out.json> [--only a,b] | --compare a.json b.json');
+  process.exit(2);
+}
+const onlyIdx = args.indexOf('--only');
+const only = onlyIdx >= 0 ? args[onlyIdx + 1].split(',') : null;
+// --wav <dir>: also pull every render's PCM16 WAV into <dir>/<name>.wav (name '/' → '__').
+const wavIdx = args.indexOf('--wav');
+const wavDir = wavIdx >= 0 ? args[wavIdx + 1] : null;
+if (wavDir) fs.mkdirSync(wavDir, { recursive: true });
+async function pullWav(page, bytes, file) {
+  const chunks = [];
+  let offset = 0;
+  while (offset < bytes) {
+    const b64 = await page.evaluate((o) => window.__scoreSoak.wavChunk(o), offset);
+    if (!b64) break;
+    const buf = Buffer.from(b64, 'base64');
+    chunks.push(buf);
+    offset += buf.length;
+  }
+  fs.writeFileSync(file, Buffer.concat(chunks));
+}
+const root = path.dirname(path.dirname(new URL(import.meta.url).pathname));
+
+async function serverUp(port) {
+  try { return (await fetch(`http://localhost:${port}/score-soak.html`)).ok; } catch { return false; }
+}
+let viteProc = null;
+process.once('exit', () => { if (viteProc && !viteProc.killed) viteProc.kill(); });
+async function freshPort() {
+  return await new Promise((resolve, reject) => {
+    const server = net.createServer();
+    server.unref();
+    server.on('error', reject);
+    server.listen(0, '127.0.0.1', () => {
+      const port = server.address().port;
+      server.close((error) => (error ? reject(error) : resolve(port)));
+    });
+  });
+}
+async function startServer(port) {
+  const viteScript = [
+    "import { createServer } from 'vite'",
+    "import react from '@vitejs/plugin-react'",
+    `const server = await createServer({ configFile: false, root: process.cwd(), plugins: [react()], server: { port: ${port}, strictPort: true, hmr: false, watch: null } })`,
+    'await server.listen()',
+    'await new Promise(() => {})'
+  ].join(';');
+  viteProc = spawn(process.execPath, ['--input-type=module', '--eval', viteScript], {
+    cwd: root, stdio: 'ignore', env: { ...process.env, PROBE_NO_HMR: '1' }
+  });
+  for (let i = 0; i < 100; i++) {
+    if (await serverUp(port)) return;
+    await new Promise((r) => setTimeout(r, 300));
+  }
+  throw new Error('vite dev server did not come up');
+}
+
+const pwDir = path.join(os.homedir(), '.cache/ms-playwright');
+const chromeDir = fs.readdirSync(pwDir).filter((d) => /^chromium-\d+$/.test(d)).sort().pop();
+const executablePath = path.join(pwDir, chromeDir, 'chrome-linux/chrome');
+
+const probePort = await freshPort();
+await startServer(probePort);
+const browser = await chromium.launch({
+  executablePath, headless: true,
+  args: ['--enable-unsafe-swiftshader', '--use-gl=angle', '--autoplay-policy=no-user-gesture-required', '--mute-audio']
+});
+let failed = false;
+const summary = { generatedAt: new Date().toISOString(), seconds: null, count: 0, moods: {} };
+try {
+  const page = await browser.newPage();
+  page.setDefaultTimeout(600000);
+  page.on('pageerror', (e) => { failed = true; console.log(`[pageerror] ${e.message}`); });
+  await page.goto(`http://localhost:${probePort}/score-soak.html`, { waitUntil: 'load' });
+  await page.waitForFunction(() => Boolean(window.__scoreSoak), null, { timeout: 20000 });
+  const names = await page.evaluate(() => window.__scoreSoak.moodIdentityNames);
+  summary.count = names.length;
+  for (let i = 0; i < names.length; i++) {
+    if (only && !only.includes(names[i])) continue;
+    const r = await page.evaluate((idx) => window.__scoreSoak.renderMoodIdentity(idx), i);
+    summary.seconds = r.seconds;
+    summary.moods[r.name] = { beat: r.beat, variant: r.variant, pcmSha256: r.pcmSha256, fingerprintSha256: r.fingerprintSha256, smoothness: r.analysis.smoothnessViolations, nan: r.analysis.nanCount, rms: r.analysis.rms, peak: r.analysis.peak };
+    if (wavDir) await pullWav(page, r.wavBytes, path.join(wavDir, `${r.name.replace(/\//g, '__')}.wav`));
+    console.log(`[${String(i + 1).padStart(2)}/${names.length}] ${r.name.padEnd(28)} pcm=${r.pcmSha256.slice(0, 16)} smooth=${r.analysis.smoothnessViolations}`);
+  }
+} finally {
+  await browser.close();
+  if (viteProc && !viteProc.killed) viteProc.kill();
+}
+fs.mkdirSync(path.dirname(outFile), { recursive: true });
+fs.writeFileSync(outFile, JSON.stringify(summary, null, 2));
+console.log(`wrote ${outFile} (${Object.keys(summary.moods).length} moods of ${summary.count})`);
+process.exit(failed ? 1 : 0);
diff --git a/main/tools/audio-param-writes-probe.mjs b/main/tools/audio-param-writes-probe.mjs
new file mode 100644
index 0000000..473560a
--- /dev/null
+++ b/main/tools/audio-param-writes-probe.mjs
@@ -0,0 +1,210 @@
+// audio-10x Stage 2: steady-state AudioParam automation writes per second in the
+// LIVE app (AudioDirector's rAF conductor + both lookahead schedulers), on the
+// real app path rather than the soak harness.
+//
+//   node tools/audio-param-writes-probe.mjs [beat=ch4-vigil] [settleS=8] [samples=3] [--out <json>]
+//
+// Every AudioParam automation method is wrapped by an init script BEFORE any
+// module loads, so every write from every engine is counted (setValueAtTime,
+// linearRampToValueAtTime, exponentialRampToValueAtTime, setTargetAtTime,
+// setValueCurveAtTime, cancelScheduledValues, cancelAndHoldAtTime, and the
+// `.value` setter). The app boots `?story=<beat>&movie=1`, audio is unlocked by
+// dynamic import exactly as fps-score-probe.mjs does, the mix settles, then
+// counts are sampled over 5 s windows. Owns a fresh HMR-off vite server.
+import { chromium } from 'playwright-core';
+import { spawn } from 'node:child_process';
+import os from 'node:os';
+import path from 'node:path';
+import fs from 'node:fs';
+import net from 'node:net';
+
+const args = process.argv.slice(2);
+const positional = args.filter((a) => !a.startsWith('--'));
+const flag = (name, fallback) => {
+  const i = args.indexOf(`--${name}`);
+  return i >= 0 && i + 1 < args.length ? args[i + 1] : fallback;
+};
+const beat = positional[0] ?? 'ch4-vigil';
+const settleS = Math.max(4, Number(positional[1] ?? 8));
+const samples = Math.max(1, Math.floor(Number(positional[2] ?? 3)));
+const outFile = flag('out', null);
+// --trace: attribute writes to their first application stack frame (routing evidence).
+const trace = args.includes('--trace');
+const SAMPLE_WINDOW_MS = 5000;
+const AUDIO_SETTLE_S = 6;
+const root = path.dirname(path.dirname(new URL(import.meta.url).pathname));
+
+async function serverUp(port) {
+  try {
+    return (await fetch(`http://localhost:${port}/`)).ok;
+  } catch {
+    return false;
+  }
+}
+const port = await new Promise((resolve, reject) => {
+  const server = net.createServer();
+  server.unref();
+  server.on('error', reject);
+  server.listen(0, '127.0.0.1', () => {
+    const p = server.address().port;
+    server.close((e) => (e ? reject(e) : resolve(p)));
+  });
+});
+const viteScript = [
+  "import { createServer } from 'vite'",
+  "import react from '@vitejs/plugin-react'",
+  `const server = await createServer({ configFile: false, root: process.cwd(), plugins: [react()], server: { port: ${port}, strictPort: true, hmr: false, watch: null } })`,
+  'await server.listen()',
+  'await new Promise(() => {})'
+].join(';');
+const viteProc = spawn(process.execPath, ['--input-type=module', '--eval', viteScript], {
+  cwd: root,
+  stdio: 'ignore',
+  env: { ...process.env, PROBE_NO_HMR: '1' }
+});
+process.once('exit', () => {
+  if (viteProc && !viteProc.killed) viteProc.kill();
+});
+for (let i = 0; i < 100 && !(await serverUp(port)); i++) await new Promise((r) => setTimeout(r, 300));
+if (!(await serverUp(port))) throw new Error('vite dev server did not come up');
+
+const pwDir = path.join(os.homedir(), '.cache/ms-playwright');
+const chromeDir = fs.readdirSync(pwDir).filter((d) => /^chromium-\d+$/.test(d)).sort().pop();
+const executablePath = path.join(pwDir, chromeDir, 'chrome-linux/chrome');
+const browser = await chromium.launch({
+  executablePath,
+  headless: true,
+  args: ['--enable-unsafe-swiftshader', '--use-gl=angle', '--window-size=1280,720', '--autoplay-policy=no-user-gesture-required', '--mute-audio']
+});
+const page = await browser.newPage({ viewport: { width: 1280, height: 720 } });
+page.on('pageerror', (e) => console.log(`[pageerror] ${e.message}`));
+await page.addInitScript((traceOn) => {
+  const counts = {};
+  const sites = {};
+  const bump = (name) => {
+    counts[name] = (counts[name] ?? 0) + 1;
+    if (traceOn) {
+      const lines = (new Error().stack || '').split('\n').slice(2);
+      const site = lines.find((l) => /\/src\//.test(l) && !/rampParam|audioCore\.ts.*ramp|railTarget/.test(l)) || lines[0] || '?';
+      const key = `${name} @ ${site.trim().replace(/^at /, '').replace(/\?t=\d+/, '').replace(/https?:\/\/[^/]+/, '')}`;
+      sites[key] = (sites[key] ?? 0) + 1;
+    }
+  };
+  const proto = window.AudioParam && window.AudioParam.prototype;
+  if (proto) {
+    for (const name of [
+      'setValueAtTime',
+      'linearRampToValueAtTime',
+      'exponentialRampToValueAtTime',
+      'setTargetAtTime',
+      'setValueCurveAtTime',
+      'cancelScheduledValues',
+      'cancelAndHoldAtTime'
+    ]) {
+      const original = proto[name];
+      if (typeof original !== 'function') continue;
+      proto[name] = function wrapped(...a) {
+        bump(name);
+        return original.apply(this, a);
+      };
+    }
+    const desc = Object.getOwnPropertyDescriptor(proto, 'value');
+    if (desc && desc.set) {
+      Object.defineProperty(proto, 'value', {
+        configurable: true,
+        get: desc.get,
+        set(v) {
+          bump('value=');
+          return desc.set.call(this, v);
+        }
+      });
+    }
+  }
+  window.__voxParamWrites = {
+    counts,
+    sites,
+    snapshot: () => ({ ...counts }),
+    sitesSnapshot: () => ({ ...sites }),
+    total: () => Object.values(counts).reduce((a, b) => a + b, 0)
+  };
+}, trace);
+
+const result = { beat, settleS, samples, samplesTaken: [], summary: null, generatedAt: new Date().toISOString() };
+try {
+  await page.goto(`http://localhost:${port}/?story=${beat}&movie=1`, { waitUntil: 'load' });
+  const t0 = Date.now();
+  let live = false;
+  while ((Date.now() - t0) / 1000 < 90) {
+    const b = await page.evaluate(() => window.__storyBeat ?? null).catch(() => null);
+    if (b === beat) {
+      live = true;
+      break;
+    }
+    await new Promise((r) => setTimeout(r, 300));
+  }
+  console.log(`[probe] beat ${beat} live=${live} at ${((Date.now() - t0) / 1000).toFixed(1)}s`);
+  await new Promise((r) => setTimeout(r, settleS * 1000));
+  const unlocked = await page.evaluate(async () => {
+    const music = await import('/src/audio/musicEngine.ts');
+    const sfx = await import('/src/audio/sfxEngine.ts');
+    const story = await import('/src/story/storyScore.ts');
+    await music.unlockMusicAudio();
+    await sfx.unlockSfxAudio();
+    story.unlockStoryScore();
+    const core = await import('/src/audio/audioCore.ts');
+    return core.peekAudioContext()?.state ?? 'none';
+  });
+  console.log(`[probe] audio context ${unlocked}; settling ${AUDIO_SETTLE_S}s`);
+  await new Promise((r) => setTimeout(r, AUDIO_SETTLE_S * 1000));
+  for (let i = 0; i < samples; i++) {
+    const sample = await page.evaluate(
+      (windowMs) =>
+        new Promise((resolve) => {
+          const before = window.__voxParamWrites.snapshot();
+          const t0 = performance.now();
+          let frames = 0;
+          const tick = () => {
+            frames++;
+            if (performance.now() - t0 < windowMs) requestAnimationFrame(tick);
+            else {
+              const after = window.__voxParamWrites.snapshot();
+              const elapsedS = (performance.now() - t0) / 1000;
+              const perMethod = {};
+              let total = 0;
+              for (const k of new Set([...Object.keys(before), ...Object.keys(after)])) {
+                const d = (after[k] ?? 0) - (before[k] ?? 0);
+                perMethod[k] = Math.round((d / elapsedS) * 10) / 10;
+                total += d;
+              }
+              resolve({ elapsedS, fps: frames / elapsedS, writesPerS: total / elapsedS, perMethodPerS: perMethod });
+            }
+          };
+          requestAnimationFrame(tick);
+        }),
+      SAMPLE_WINDOW_MS
+    );
+    result.samplesTaken.push(sample);
+    console.log(
+      `[sample ${i + 1}/${samples}] writes/s=${sample.writesPerS.toFixed(1)} fps=${sample.fps.toFixed(1)} ` +
+        Object.entries(sample.perMethodPerS)
+          .map(([k, v]) => `${k}=${v}`)
+          .join(' ')
+    );
+  }
+  if (trace) {
+    const sites = await page.evaluate(() => window.__voxParamWrites.sitesSnapshot());
+    const top = Object.entries(sites).sort((a, b) => b[1] - a[1]).slice(0, 24);
+    console.log('[trace] top write sites since page load:');
+    for (const [k, v] of top) console.log(`  ${String(v).padStart(7)}  ${k}`);
+    result.sites = Object.fromEntries(top);
+    result.allSites = sites;
+  }
+  const rates = result.samplesTaken.map((s) => s.writesPerS).sort((a, b) => a - b);
+  const median = rates[Math.floor(rates.length / 2)];
+  result.summary = { medianWritesPerS: median, maxWritesPerS: rates[rates.length - 1], contextState: unlocked, beatLive: live };
+  console.log(`RESULT AudioParam writes/s: median=${median.toFixed(1)} max=${rates[rates.length - 1].toFixed(1)} (target < 60 steady state)`);
+} finally {
+  await browser.close();
+  if (viteProc && !viteProc.killed) viteProc.kill();
+}
+if (outFile) fs.writeFileSync(outFile, JSON.stringify(result, null, 2));
