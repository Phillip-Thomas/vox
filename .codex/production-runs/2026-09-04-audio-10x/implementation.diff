+  style.textContent = 'body *:not([data-vox-keep]) { visibility: hidden !important; } canvas { visibility: visible !important; }';
+  document.head.appendChild(style);
+  return n;
+}
+function pageShowUi() {
+  document.getElementById('vox-hide-ui')?.remove();
+  for (const el of document.querySelectorAll('[data-vox-keep]')) el.removeAttribute('data-vox-keep');
+  return true;
+}
+function pageUiRects() {
+  return [...document.querySelectorAll('body *')]
+    .filter((e) => e.tagName !== 'CANVAS' && e.children.length === 0)
+    .map((e) => { const r = e.getBoundingClientRect();
+      return (r.width > 0 && r.height > 0 && r.bottom > 0 && r.right > 0)
+        ? { tag: e.tagName, text: (e.textContent ?? '').replace(/\s+/g, ' ').trim().slice(0, 48),
+          rect: [Math.round(r.x), Math.round(r.y), Math.round(r.width), Math.round(r.height)] } : null; })
+    .filter(Boolean);
+}
+export const hideUi = (page) => page.evaluate(pageHideUi);
+export const showUi = (page) => page.evaluate(pageShowUi);
+export const uiRects = (page) => page.evaluate(pageUiRects);
+
+// -------------------------------------------------------------- frame stats ---
+/** Luma statistics of a PNG buffer, on the percept `stats` vocabulary. */
+export function frameStats(pngBytes) {
+  const { w, h, rgb } = readPng(pngBytes);
+  const n = w * h;
+  let sum = 0, sumSq = 0, max = 0, bright = 0, clipped = 0, black = 0, satW = 0, sumW = 0;
+  for (let i = 0; i < n; i++) {
+    const r = rgb[i * 3], g = rgb[i * 3 + 1], b = rgb[i * 3 + 2];
+    const L = lum(r, g, b) / 255;
+    sum += L; sumSq += L * L; if (L > max) max = L;
+    if (L > 0.12) bright++;
+    if (r >= 254 || g >= 254 || b >= 254) clipped++;
+    if (L < 0.02) black++;
+    const mx = Math.max(r, g, b), mn = Math.min(r, g, b);
+    if (mx > 0) { satW += (mx - mn) / mx * L; sumW += L; }
+  }
+  const mean = sum / n;
+  const contrast = Math.sqrt(Math.max(0, sumSq / n - mean * mean));
+  return {
+    drawCalls: null,
+    brightRatio: Number((bright / n).toFixed(4)),
+    meanLuma: Number(mean.toFixed(4)),
+    maxLuma: Number(max.toFixed(4)),
+    contrast: Number(contrast.toFixed(4)),
+    clipped: Number((clipped / n).toFixed(5)),
+    nearBlack: Number((black / n).toFixed(4)),
+    colorfulness: sumW > 1e-6 ? Number((satW / sumW).toFixed(4)) : 0,
+    // the blank verdict frame-defect-scan.mjs used (std < 2/255) or a near-dark frame
+    blank: contrast < 2 / 255 || max < 0.12,
+    meanLuma255: Number((mean * 255).toFixed(2)),
+  };
+}
+
+// ------------------------------------------------------------- burst scalars ---
+// Ported from Paraform's judge-capture.mjs. Consecutive frames reduce to
+// per-pixel luma deltas at 320x180: smooth motion accumulates (adjacent delta
+// ~ net drift per frame, flickerRatio ~ 1); oscillation cancels (large
+// adjacent deltas, near-zero net, flickerRatio >> 1, signFlips -> 0.5).
+function pageBurstReset() { window.__voxBurst = { first: null, prev: null, prevDelta: null }; }
+async function pageBurstStep(b64) {
+  const W = 320; const H = 180; const MOVE = 0.02;
+  const blob = await (await fetch('data:image/png;base64,' + b64)).blob();
+  const bmp = await createImageBitmap(blob);
+  const canvas = new OffscreenCanvas(W, H);
+  const g = canvas.getContext('2d');
+  g.imageSmoothingEnabled = false;
+  g.drawImage(bmp, 0, 0, W, H);
+  const d = g.getImageData(0, 0, W, H).data;
+  const luma = new Float32Array(W * H);
+  for (let i = 0, p = 0; i < d.length; i += 4, p++) luma[p] = (0.2126 * d[i] + 0.7152 * d[i + 1] + 0.0722 * d[i + 2]) / 255;
+  const s = window.__voxBurst;
+  if (!s.first) { s.first = luma; s.prev = luma; s.prevDelta = null; return { first: true }; }
+  const n = luma.length; const delta = new Float32Array(n);
+  let sum = 0, changed = 0, flips = 0, flipDenom = 0, vsFirstSum = 0;
+  for (let p = 0; p < n; p++) {
+    const dl = luma[p] - s.prev[p]; delta[p] = dl; const a = Math.abs(dl);
+    sum += a; if (a > MOVE) changed++;
+    if (s.prevDelta) { const pd = s.prevDelta[p]; if (Math.abs(pd) > MOVE && a > MOVE) { flipDenom++; if (pd * dl < 0) flips++; } }
+    vsFirstSum += Math.abs(luma[p] - s.first[p]);
+  }
+  s.prev = luma; s.prevDelta = delta;
+  return { adjDelta: sum / n, changedRatio: changed / n, signFlipRatio: flipDenom ? flips / flipDenom : null, vsFirst: vsFirstSum / n };
+}
+export const burstReset = (page) => page.evaluate(pageBurstReset);
+export const burstStep = (page, pngBytes) => page.evaluate(pageBurstStep, pngBytes.toString('base64'));
+
+/** Finalize one burst's samples into the scalars the digest prints. */
+export function summarizeBurst(range, samples, dtMs) {
+  const pairs = samples.filter((s) => !s.first);
+  if (pairs.length < 2) return null;
+  const avg = (v) => v.reduce((a, b) => a + b, 0) / v.length;
+  const meanAdjDelta = avg(pairs.map((s) => s.adjDelta));
+  const netDeltaPerFrame = pairs[pairs.length - 1].vsFirst / pairs.length;
+  const flips = pairs.map((s) => s.signFlipRatio).filter((v) => v != null);
+  return {
+    t0: Number(range.t0.toFixed(3)), frameStart: range.frameStart, frameEnd: range.frameEnd,
+    frames: range.frameIdx, dtMs: Number(dtMs.toFixed(1)),
+    meanAdjDelta: Number(meanAdjDelta.toFixed(5)),
+    netDeltaPerFrame: Number(netDeltaPerFrame.toFixed(5)),
+    flickerRatio: Number((meanAdjDelta / Math.max(netDeltaPerFrame, 1e-4)).toFixed(2)),
+    signFlipRatio: flips.length ? Number(avg(flips).toFixed(3)) : null,
+    changedRatio: Number(avg(pairs.map((s) => s.changedRatio)).toFixed(3)),
+    // luminance pop — frame-defect-scan.mjs's |Δmean| > 40 on the 0..255 scale
+    pops: pairs.filter((s) => s.pop === true).length,
+  };
+}
+
+// ----------------------------------------------------------- capture session ---
+/**
+ * Shoot one page for a while. Every frame is a twin (hud/ + frames/), stamped
+ * with the state read BEFORE the shutter opened.
+ *
+ *   targets   [{ id, at }]           story-clock seconds; shot once when reached
+ *   bursts    [{ from, to }]         story-clock windows shot every loop pass
+ *   triggers  [{ key, pred(state), before, after, delay, onlyAfter }]  in order
+ *   events    [{ key, pred(state) }]     unordered; each fires once, shot as a trigger frame
+ *   onState(state, clock, addBurst(from, to, id))  may return 'stop'
+ *   stripIntervalS                   coverage floor (0 disables)
+ *   stills    [{ id, settleMs }]     long-settle heroes taken first, in order
+ *   capMs / stopWhen(state)          end conditions
+ */
+export async function captureSession(page, dir, opts = {}) {
+  const {
+    targets = [], bursts = [], triggers = [], events = [], stripIntervalS = 4, stills = [],
+    capMs = 120_000, stopWhen = null, onState = null, startIndex = 0, pollMs = 150, log = console.log,
+  } = opts;
+  mkdirSync(join(dir, 'frames'), { recursive: true });
+  mkdirSync(join(dir, 'hud'), { recursive: true });
+  const frames = [];
+  const burstRecords = [];
+  let index = startIndex;
+  const t0 = Date.now();
+  // the autopilot beat clock restarts at every beat entry; keep simTime monotone
+  // by carrying the previous beat's span forward as an offset
+  let clockOffset = opts.clockOffset ?? 0; let lastRaw = null; let maxRaw = 0;
+  const clockOf = (state) => {
+    if (state.autopilot?.clock == null) return (Date.now() - t0) / 1000;
+    const raw = Number(state.autopilot.clock);
+    if (lastRaw != null && raw < lastRaw - 0.5) { clockOffset += maxRaw; maxRaw = 0; }
+    lastRaw = raw; maxRaw = Math.max(maxRaw, raw);
+    return clockOffset + raw;
+  };
+  const beatClockOf = (state) => (state.autopilot?.clock != null ? Number(state.autopilot.clock) : null);
+  const clockKind = (state) => (state.autopilot?.clock != null ? 'autopilot-beat-clock' : 'wall-since-settle');
+
+  const shoot = async (role, label, state, { burstRange = null, pngOverride = null } = {}) => {
+    const t = clockOf(state);
+    const name = `f${String(index).padStart(4, '0')}_t${t.toFixed(2)}s_${label}.png`;
+    const hudPng = pngOverride ?? await page.screenshot();
+    await hideUi(page);
+    const twinPng = await page.screenshot();
+    await showUi(page);
+    writeFileSync(join(dir, 'hud', name), hudPng);
+    writeFileSync(join(dir, 'frames', name), twinPng);
+    const stats = frameStats(twinPng);
+    const rec = {
+      index, file: `frames/${name}`, hudFile: `hud/${name}`, role, label,
+      frame: index, simTime: Number(t.toFixed(3)), clock: clockKind(state),
+      beat: state.beat ?? null, objectiveId: state.objectiveId ?? null, caption: state.caption ?? null,
+      anchorId: state.av?.anchorId ?? null, milestones: state.milestones?.length ?? null,
+      sha256: sha256(twinPng), hudSha256: sha256(hudPng), stats,
+      stateReadOrder: 'state-before-shutter',
+    };
+    if (burstRange) {
+      const sample = await burstStep(page, twinPng);
+      if (!sample.first && burstRange.samples.length) {
+        const prevMean = burstRange.samples[burstRange.samples.length - 1].mean255;
+        sample.pop = Math.abs(stats.meanLuma255 - prevMean) > 40;
+      }
+      sample.mean255 = stats.meanLuma255;
+      burstRange.samples.push(sample);
+      burstRange.frameIdx.push(index);
+      burstRange.lastWall = Date.now();
+    }
+    frames.push(rec);
+    index++;
+    log?.(`  [${name}] ${role} beat=${rec.beat} clock=${rec.clock} blank=${stats.blank}`);
+    return rec;
+  };
+
+  // hero stills first: long settles, then the twin
+  for (const still of stills) {
+    if (still.settleMs) await sleep(still.settleMs);
+    const state = await readState(page);
+    await shoot(still.role ?? 'still', still.id, state);
+  }
+
+  const pending = targets.map((x) => ({ ...x, taken: false }));
+  const mkWindow = (b) => ({ ...b, active: false, samples: [], frameIdx: [], t0: b.from, firstWall: null, lastWall: null });
+  const windows = bursts.map(mkWindow);
+  const addBurst = (from, to, id) => { windows.push(mkWindow({ from, to, id })); };
+  const fired = new Set();
+  const deadline = Date.now() + capMs;
+  let lastStrip = -1e9;
+  let ti = 0;
+  let prevShot = null; let prevState = null;
+
+  while (Date.now() < deadline) {
+    const state = await readState(page).catch(() => null);
+    if (!state) { await sleep(pollMs); continue; }
+    const clock = clockOf(state);
+    if (onState) { const r = onState(state, clock, addBurst); if (r === 'stop') break; }
+
+    // unordered one-shot events (milestone latches, anchor activations, caption changes)
+    let firedNow = false;
+    for (const ev of events) {
+      if (fired.has(ev.key)) continue;
+      let hit = false;
+      try { hit = !!ev.pred(state, clock); } catch { hit = false; }
+      if (!hit) continue;
+      fired.add(ev.key);
+      await shoot('trigger', ev.key, state);
+      firedNow = true;
+      break;
+    }
+    if (firedNow) continue;
+
+    // ordered triggers, with the retroactive before-frame
+    const trig = triggers[ti];
+    if (trig) {
+      if (trig.delay) {
+        await sleep(trig.delay);
+        const s = await readState(page);
+        await shoot('trigger', trig.key, s);
+        ti++; prevShot = null; prevState = null;
+        continue;
+      }
+      if (trig.pred(state, clock)) {
+        if (trig.before && prevShot) {
+          await shoot('trigger', `${trig.key}-before`, prevState, { pngOverride: prevShot });
+        }
+        if (!trig.onlyAfter) await shoot('trigger', trig.before ? `${trig.key}-at` : trig.key, state);
+        if (trig.after) {
+          await sleep(trig.after);
+          const s2 = await readState(page);
+          await shoot('trigger', trig.onlyAfter ? trig.key : `${trig.key}-after`, s2);
+        }
+        ti++; prevShot = null; prevState = null;
+        continue;
+      }
+    }
+
+    const due = pending.find((x) => !x.taken && clock >= x.at);
+    const beatClock = beatClockOf(state) ?? clock;
+    // a per-beat window that has run past its end on this beat is finished for this beat
+    for (const w of windows) if (w.perBeat && w.active && w.activeBeat === state.beat && beatClock > w.to) w.doneForBeat = state.beat;
+    const win = windows.find((w) => (w.perBeat ? beatClock : clock) >= w.from && (w.perBeat ? beatClock : clock) <= w.to && !(w.perBeat && w.doneForBeat === state.beat));
+    if (due) {
+      due.taken = true;
+      await shoot('keyframe', due.id, state);
+    } else if (win) {
+      if (!win.active || (win.perBeat && win.activeBeat !== state.beat)) {
+        if (win.active && win.samples.length >= 3) { const done = summarizeBurst(win, win.samples, win.lastWall && win.firstWall ? (win.lastWall - win.firstWall) / Math.max(1, win.samples.length - 1) : 0); if (done) burstRecords.push({ ...done, beat: win.activeBeat }); }
+        win.active = true; win.activeBeat = state.beat; win.frameStart = index; win.firstWall = Date.now(); win.samples = []; win.frameIdx = []; win.t0 = clock; await burstReset(page);
+      }
+      await shoot('burst', `burst-${win.id ?? Math.round(win.from)}`, state, { burstRange: win });
+      win.frameEnd = index - 1;
+      lastStrip = clock;
+    } else if (stripIntervalS > 0 && clock - lastStrip >= stripIntervalS) {
+      lastStrip = clock;
+      await shoot('temporal', 'strip', state);
+    } else {
+      // keep a before-frame for the next trigger without writing it
+      if (trig?.before) { prevShot = await page.screenshot(); prevState = state; }
+      await sleep(pollMs);
+    }
+    if (stopWhen && stopWhen(state, clock)) break;
+    if (ti >= triggers.length && pending.every((x) => x.taken) && windows.every((w) => clock > w.to) && stripIntervalS === 0) break;
+  }
+
+  for (const w of windows) {
+    if (w.samples.length < 3) continue;
+    const dtMs = w.lastWall && w.firstWall && w.samples.length > 1 ? (w.lastWall - w.firstWall) / (w.samples.length - 1) : 0;
+    const rec = summarizeBurst(w, w.samples, dtMs);
+    if (rec) burstRecords.push({ ...rec, beat: w.activeBeat ?? null });
+  }
+  return {
+    frames, bursts: burstRecords, nextIndex: index, clockOffset: clockOffset + maxRaw,
+    unmetTargets: pending.filter((x) => !x.taken).map((x) => x.id),
+    completedTriggers: ti, allTriggersHit: ti === triggers.length,
+  };
+}
+
+// ----------------------------------------------------------------- the sheet ---
+/** runs in the page: chronological tiles, timestamp+beat top-left, red frame index bottom-right. */
+async function pageComposeSheet({ tiles, meta }) {
+  const cols = Math.ceil(Math.sqrt(tiles.length));
+  const rows = Math.ceil(tiles.length / cols);
+  const M = 8; const HEADER = 34;
+  const W = cols * (meta.tileW + M) + M;
+  const H = HEADER + rows * (meta.tileH + M) + M;
+  const canvas = document.createElement('canvas');
+  canvas.width = W; canvas.height = H;
+  const g = canvas.getContext('2d');
+  g.fillStyle = '#101018'; g.fillRect(0, 0, W, H);
+  g.fillStyle = '#cfd4ff'; g.font = '16px monospace';
+  g.fillText(`${meta.title}  ${tiles.length} moments, chronological — red number = frame index`, M, 22);
+  for (let i = 0; i < tiles.length; i++) {
+    const img = new Image();
+    img.src = 'data:image/png;base64,' + tiles[i].png;
+    await img.decode();
+    const cx = M + (i % cols) * (meta.tileW + M);
+    const cy = HEADER + M + Math.floor(i / cols) * (meta.tileH + M);
+    g.drawImage(img, cx, cy, meta.tileW, meta.tileH);
+    g.font = '13px monospace';
+    const label = `t=${tiles[i].t.toFixed(2)}s ${tiles[i].label ?? ''}`.trim();
+    g.fillStyle = 'rgba(0,0,0,0.65)'; g.fillRect(cx + 4, cy + 4, g.measureText(label).width + 10, 19);
+    g.fillStyle = '#ffffff'; g.fillText(label, cx + 9, cy + 18);
+    // NumPro: red, bottom-right, modest — bigger or centered hurts
+    g.font = 'bold 26px monospace';
+    const idx = String(tiles[i].idx);
+    const iw = g.measureText(idx).width;
+    g.fillStyle = 'rgba(0,0,0,0.55)'; g.fillRect(cx + meta.tileW - iw - 16, cy + meta.tileH - 32, iw + 12, 28);
+    g.fillStyle = '#ff3b30'; g.fillText(idx, cx + meta.tileW - iw - 10, cy + meta.tileH - 10);
+  }
+  return canvas.toDataURL('image/png').split(',')[1];
+}
+
+/** Compose sheet.png from the frames of record (never burst or strip frames). */
+export async function composeSheet(page, dir, frames, { title = 'paravoxia', tileW = 480, tileH = 270 } = {}) {
+  const tiles = frames
+    .filter((f) => f.role !== 'burst' && f.role !== 'temporal' && !f.stats?.blank)
+    .map((f) => ({ png: readFileSync(join(dir, f.file)).toString('base64'), t: f.simTime, label: [f.beat, f.label].filter(Boolean).join(' '), idx: f.index }));
+  if (!tiles.length) return null;
+  const b64 = await page.evaluate(pageComposeSheet, { tiles, meta: { title, tileW, tileH } });
+  const bytes = Buffer.from(b64, 'base64');
+  writeFileSync(join(dir, 'sheet.png'), bytes);
+  return { file: 'sheet.png', tileW, tileH, tiles: tiles.length, sha256: sha256(bytes) };
+}
+
+// ---------------------------------------------------------------- the digest ---
+/** digest.md — the text channel: beat timeline, milestones, captions, bursts. */
+export function writeDigest(dir, { subject, capture, frames, bursts, sessions = [] }) {
+  const L = [];
+  L.push(`# digest — ${subject.id}`, '');
+  L.push('All timing, order, frequency and causality questions are answered HERE; frames are for shape, color, composition, light.', '');
+  L.push(`Capture: ${capture.tier} (${capture.adapter}), ${capture.headed ? 'headed' : 'headless'}, ${capture.resolution.w}x${capture.resolution.h}, clock=${capture.clock}, build=${capture.buildSha ?? 'n/a'}`, '');
+  L.push('## Beat timeline (story clock, seconds)');
+  let lastBeat = null;
+  for (const f of frames) {
+    if (f.beat !== lastBeat) { L.push(`- t=${f.simTime.toFixed(2)}s beat=${f.beat ?? 'null'} (frame ${f.index})`); lastBeat = f.beat; }
+  }
+  L.push('', '## Objective / caption changes');
+  let lastObj = null, lastCap = null;
+  for (const f of frames) {
+    if (f.objectiveId !== lastObj) { L.push(`- t=${f.simTime.toFixed(2)}s objective=${f.objectiveId ?? 'none'} (frame ${f.index})`); lastObj = f.objectiveId; }
+    if (f.caption !== lastCap && f.caption) { L.push(`- t=${f.simTime.toFixed(2)}s caption="${f.caption.slice(0, 80)}" (frame ${f.index})`); lastCap = f.caption; }
+  }
+  L.push('', '## Signed-AV anchors');
+  let lastAnchor = null;
+  for (const f of frames) if (f.anchorId !== lastAnchor) { L.push(`- t=${f.simTime.toFixed(2)}s anchor=${f.anchorId ?? 'none'} (frame ${f.index})`); lastAnchor = f.anchorId; }
+  L.push('', `## Frames: ${frames.length} (${frames.filter((f) => f.stats?.blank).length} blank)`);
+  L.push('Captured-frame telemetry (idx | t | role | label | beat | meanLuma | blank):');
+  for (const f of frames) L.push(`  ${f.index} | ${f.simTime.toFixed(2)} | ${f.role} | ${f.label} | ${f.beat ?? 'null'} | ${f.stats.meanLuma} | ${f.stats.blank}`);
+  L.push('', '## Adjacent-frame bursts (consecutive frames at the capture cadence, at declared hotspots)');
+  if (!bursts.length) L.push('(no bursts captured — flicker and frame-to-frame smoothness are UNMEASURED; do not assume smooth)');
+  L.push('Smooth motion: adjacent delta ~ net drift per frame (flickerRatio near 1). Oscillation/flicker: large adjacent deltas that cancel (high ratio + high signFlips).');
+  for (const b of bursts) {
+    const klass = b.flickerRatio > 2.5 && (b.signFlipRatio ?? 0) > 0.4 ? 'FLICKER' : b.flickerRatio > 2.5 || (b.signFlipRatio ?? 0) > 0.4 ? 'suspect' : 'smooth';
+    L.push(`BURST @t=${b.t0.toFixed(2)}s (frames ${b.frameStart}-${b.frameEnd}, ${b.dtMs.toFixed(0)}ms apart): meanAdjDelta=${b.meanAdjDelta.toFixed(4)} netPerFrame=${b.netDeltaPerFrame.toFixed(4)} flickerRatio=${b.flickerRatio.toFixed(1)} signFlips=${b.signFlipRatio == null ? 'n/a' : b.signFlipRatio.toFixed(2)} changed=${b.changedRatio.toFixed(2)} pops=${b.pops} → ${klass}`);
+  }
+  for (const s of sessions) if (s.note) L.push('', `## ${s.id}`, s.note);
+  const text = L.join('\n') + '\n';
+  writeFileSync(join(dir, 'digest.md'), text);
+  return { file: 'digest.md', sha256: sha256(text) };
+}
+
+// -------------------------------------------------------------- media probe ---
+/** ffprobe a file into exactly the shape creative-triad-gate.mjs probeMedia() records. */
+export function probeMedia(filePath) {
+  const result = spawnSync('ffprobe', ['-v', 'error',
+    '-show_entries', 'format=format_name,duration:stream=codec_type,codec_name,width,height,sample_rate,channels',
+    '-of', 'json', filePath], { encoding: 'utf8' });
+  if (result.status !== 0) return null;
+  let parsed;
+  try { parsed = JSON.parse(result.stdout); } catch { return null; }
+  const video = (parsed.streams || []).find((st) => st.codec_type === 'video');
+  const audio = (parsed.streams || []).find((st) => st.codec_type === 'audio');
+  const duration = Number(parsed.format?.duration);
+  return {
+    formatName: parsed.format?.format_name || 'unknown',
+    durationSeconds: Number.isFinite(duration) ? Number(duration.toFixed(3)) : 0,
+    video: video ? { codec: video.codec_name, width: video.width, height: video.height } : null,
+    audio: audio ? { codec: audio.codec_name, sampleRate: Number(audio.sample_rate), channels: audio.channels } : null,
+  };
+}
+
+// ---------------------------------------------------------------- the bundle ---
+let perceptBundle = null;
+async function loadPercept() {
+  if (perceptBundle) return perceptBundle;
+  const p = join(PERCEPT_DIR, 'core', 'bundle.mjs');
+  if (!existsSync(p)) throw new Error(`percept not found at ${PERCEPT_DIR} (set PERCEPT_DIR)`);
+  perceptBundle = await import(pathToFileURL(p).href);
+  return perceptBundle;
+}
+
+/** Write bundle.json (percept capture-bundle-v1) and validate it against the files on disk. */
+export async function writeBundle(dir, { subject, capture, frames, bursts = [], sheet = null, digest = null, provenance = {} }) {
+  const { canonicalBundleSha256, validateBundle } = await loadPercept();
+  const manifest = {
+    schema: 'capture-bundle-v1',
+    subject: { id: subject.id, kind: subject.kind ?? 'paravoxia-chapter', prompt: subject.prompt ?? null },
+    capture: {
+      lane: 'external',
+      tier: capture.tier, adapter: capture.adapter, headed: capture.headed,
+      resolution: capture.resolution, seed: String(capture.seed ?? 'default'),
+      deterministic: false, motionRequired: true, clock: capture.clock,
+      buildSha: capture.buildSha ?? null, viewport: capture.viewport ?? null,
+      loop: { looping: false, periodSeconds: null },
+    },
+    build: { compileOk: true, runtimeOk: true },
+    frames: frames.map((f) => ({
+      file: f.file,
+      // percept's role vocabulary is temporal|keyframe|boot|seam-pre|seam-post|burst; stills and
+      // trigger frames are the keyframes here, and the vox role rides beside for the digest
+      role: f.role === 'still' || f.role === 'trigger' ? 'keyframe' : f.role, voxRole: f.role,
+      ...(f.label && f.role !== 'temporal' ? { label: f.label } : {}),
+      frame: f.frame, simTime: f.simTime, salience: f.role === 'still' || f.role === 'keyframe' || f.role === 'trigger' ? 1 : f.role === 'temporal' ? 0.5 : 0,
+      sha256: f.sha256, stats: f.stats, beat: f.beat, hudFile: f.hudFile,
+    })).sort((a, b) => a.frame - b.frame),
+    ...(bursts.length ? { bursts } : {}),
+    ...(sheet ? { sheet } : {}),
+    ...(digest ? { digest } : {}),
+    provenance: { generator: 'paravoxia-chapter-evidence@v1', generatedAt: new Date().toISOString(), ...provenance },
+  };
+  // percept requires non-decreasing simTime; sort by frame index already does when the clock is monotone,
+  // but a wall clock that reset between sessions must not break the contract
+  let last = -Infinity;
+  for (const f of manifest.frames) { if (f.simTime < last) f.simTime = last; last = f.simTime; }
+  manifest.provenance.bundleSha256 = canonicalBundleSha256(manifest);
+  writeFileSync(join(dir, 'bundle.json'), `${JSON.stringify(manifest, null, 2)}\n`);
+  const validity = validateBundle(manifest, { baseDir: dir });
+  if (!validity.ok) throw new Error(`bundle invalid: ${validity.detail}`);
+  return manifest;
+}
diff --git a/main/tools/lib/pixel-laws.mjs b/main/tools/lib/pixel-laws.mjs
new file mode 100644
index 0000000..85c95b5
--- /dev/null
+++ b/main/tools/lib/pixel-laws.mjs
@@ -0,0 +1,302 @@
+// --- Pixel laws -----------------------------------------------------------------------
+//
+// Dependency-free PNG inflate/unfilter and the measurement functions the ch10
+// draft-v9 laws were written in (hue separation over connected components with
+// the cockpit mask excluded; point-source classification by angular extent; band
+// occupancy; border ring). Moved verbatim from
+// .codex/production-runs/2026-08-11-ch10-station-introduction/ch10-v9-frame-analysis.mjs
+// so every run measures with the same functions. They measure the delivered
+// frame — the HUD-suppressed twin — never a re-render.
+import fs from 'node:fs';
+import zlib from 'node:zlib';
+
+// ------------------------------------------------------------------ PNG read
+export function readPng(file) {
+  const buf = Buffer.isBuffer(file) ? file : fs.readFileSync(file);
+  let p = 8, w = 0, h = 0, bitDepth = 8, colorType = 6, interlace = 0;
+  const idat = [];
+  while (p < buf.length) {
+    const len = buf.readUInt32BE(p);
+    const type = buf.toString('ascii', p + 4, p + 8);
+    const data = buf.subarray(p + 8, p + 8 + len);
+    if (type === 'IHDR') {
+      w = data.readUInt32BE(0); h = data.readUInt32BE(4);
+      bitDepth = data[8]; colorType = data[9]; interlace = data[12];
+    } else if (type === 'IDAT') idat.push(data);
+    else if (type === 'IEND') break;
+    p += 12 + len;
+  }
+  if (bitDepth !== 8 || interlace !== 0) throw new Error(`unsupported png ${bitDepth}/${interlace}`);
+  const channels = colorType === 6 ? 4 : colorType === 2 ? 3 : colorType === 0 ? 1 : 0;
+  if (!channels) throw new Error(`unsupported colorType ${colorType}`);
+  const raw = zlib.inflateSync(Buffer.concat(idat));
+  const stride = w * channels;
+  const out = new Uint8Array(w * h * 3);
+  const prev = new Uint8Array(stride);
+  const cur = new Uint8Array(stride);
+  let rp = 0;
+  for (let y = 0; y < h; y++) {
+    const f = raw[rp++];
+    raw.copy(cur, 0, rp, rp + stride); rp += stride;
+    for (let i = 0; i < stride; i++) {
+      const a = i >= channels ? cur[i - channels] : 0;
+      const b = prev[i];
+      const c = i >= channels ? prev[i - channels] : 0;
+      let v = cur[i];
+      if (f === 1) v += a;
+      else if (f === 2) v += b;
+      else if (f === 3) v += (a + b) >> 1;
+      else if (f === 4) {
+        const pa = Math.abs(b - c), pb = Math.abs(a - c), pc = Math.abs(a + b - 2 * c);
+        v += (pa <= pb && pa <= pc) ? a : (pb <= pc ? b : c);
+      }
+      cur[i] = v & 0xff;
+    }
+    for (let x = 0; x < w; x++) {
+      const s = x * channels, d = (y * w + x) * 3;
+      out[d] = cur[s]; out[d + 1] = channels === 1 ? cur[s] : cur[s + 1];
+      out[d + 2] = channels === 1 ? cur[s] : cur[s + 2];
+    }
+    prev.set(cur);
+  }
+  return { w, h, rgb: out };
+}
+
+export const lum = (r, g, b) => 0.2126 * r + 0.7152 * g + 0.0722 * b;
+export function hsv(r, g, b) {
+  const R = r / 255, G = g / 255, B = b / 255;
+  const mx = Math.max(R, G, B), mn = Math.min(R, G, B), d = mx - mn;
+  let hh = 0;
+  if (d > 1e-6) {
+    if (mx === R) hh = ((G - B) / d) % 6;
+    else if (mx === G) hh = (B - R) / d + 2;
+    else hh = (R - G) / d + 4;
+    hh *= 60; if (hh < 0) hh += 360;
+  }
+  return { h: hh, s: mx > 0 ? d / mx : 0, v: mx };
+}
+
+// ---------------------------------------------------------- connected labels
+export function components(mask, w, h, minPx) {
+  const seen = new Uint8Array(w * h);
+  const out = [];
+  const stack = new Int32Array(w * h);
+  for (let i = 0; i < w * h; i++) {
+    if (!mask[i] || seen[i]) continue;
+    let sp = 0; stack[sp++] = i; seen[i] = 1;
+    const px = [];
+    while (sp > 0) {
+      const q = stack[--sp]; px.push(q);
+      const x = q % w, y = (q / w) | 0;
+      for (let dy = -1; dy <= 1; dy++) for (let dx = -1; dx <= 1; dx++) {
+        const nx = x + dx, ny = y + dy;
+        if (nx < 0 || ny < 0 || nx >= w || ny >= h) continue;
+        const n = ny * w + nx;
+        if (mask[n] && !seen[n]) { seen[n] = 1; stack[sp++] = n; }
+      }
+    }
+    if (px.length >= minPx) out.push(px);
+  }
+  return out;
+}
+
+export function describe(px, w, rgb) {
+  let minX = 1e9, maxX = -1, minY = 1e9, maxY = -1, sx = 0, sy = 0;
+  let peak = -1, peakAt = px[0], sumH = 0, sumS = 0, n = 0;
+  for (const q of px) {
+    const x = q % w, y = (q / w) | 0;
+    if (x < minX) minX = x; if (x > maxX) maxX = x;
+    if (y < minY) minY = y; if (y > maxY) maxY = y;
+    sx += x; sy += y;
+    const r = rgb[q * 3], g = rgb[q * 3 + 1], b = rgb[q * 3 + 2];
+    const L = lum(r, g, b);
+    if (L > peak) { peak = L; peakAt = q; }
+    const c = hsv(r, g, b); sumH += c.h; sumS += c.s; n++;
+  }
+  return { areaPx: px.length, bbox: [minX, minY, maxX - minX + 1, maxY - minY + 1],
+    extentPx: Math.max(maxX - minX + 1, maxY - minY + 1),
+    centroid: [Number((sx / px.length).toFixed(1)), Number((sy / px.length).toFixed(1))],
+    peakLuminance: Number(peak.toFixed(1)),
+    peakAt: [peakAt % w, (peakAt / w) | 0],
+    meanHueDeg: Number((sumH / n).toFixed(1)), meanSaturation: Number((sumS / n).toFixed(3)) };
+}
+
+// ------------------------------------------------------------------- masks
+export function unpackMask(b64, w, h) {
+  if (!b64) return null;
+  const bytes = Buffer.from(b64, 'base64');
+  const m = new Uint8Array(w * h);
+  // The GL read is bottom-left origin; the PNG is top-left. Flip in place.
+  for (let i = 0; i < w * h; i++) {
+    const bit = (bytes[i >> 3] >> (i & 7)) & 1;
+    if (!bit) continue;
+    const x = i % w, y = (i / w) | 0;
+    m[(h - 1 - y) * w + x] = 1;
+  }
+  return m;
+}
+
+// ------------------------------------------------------------------ analyses
+export const WARM = (c) => (c.h <= 70 || c.h >= 330) && c.s >= 0.18 && c.v >= 0.12;
+export const COOLMAG = (c) => c.h > 250 && c.h < 330;
+
+export function hueLaw(img, cockpitMask, label) {
+  const { w, h, rgb } = img;
+  const inAperture = new Uint8Array(w * h);
+  let apPx = 0;
+  for (let i = 0; i < w * h; i++) {
+    if (cockpitMask && cockpitMask[i]) continue;
+    inAperture[i] = 1; apPx++;
+  }
+  const warm = new Uint8Array(w * h);
+  let warmPx = 0, coolPx = 0, neutralLit = 0;
+  for (let i = 0; i < w * h; i++) {
+    if (!inAperture[i]) continue;
+    const c = hsv(rgb[i * 3], rgb[i * 3 + 1], rgb[i * 3 + 2]);
+    if (c.v < 0.12) continue;
+    if (WARM(c)) { warm[i] = 1; warmPx++; }
+    else if (COOLMAG(c)) coolPx++;
+    else neutralLit++;
+  }
+  const comps = components(warm, w, h, 12).map(px => describe(px, w, rgb))
+    .sort((a, b) => b.areaPx - a.areaPx);
+  // Brightest value anywhere in the aperture, and the cockpit-adjacency of each
+  // warm cluster: a cluster whose dilated ring lands on cockpit-mask pixels is
+  // cockpit-rigid furniture, not a sky body.
+  let apPeak = -1, apPeakAt = null;
+  for (let i = 0; i < w * h; i++) {
+    if (!inAperture[i]) continue;
+    const L = lum(rgb[i * 3], rgb[i * 3 + 1], rgb[i * 3 + 2]);
+    if (L > apPeak) { apPeak = L; apPeakAt = [i % w, (i / w) | 0]; }
+  }
+  if (cockpitMask) for (const c of comps) {
+    const [bx, by, bw, bh] = c.bbox;
+    let ring = 0, onCockpit = 0;
+    for (let y = by - 3; y <= by + bh + 2; y++) for (let x = bx - 3; x <= bx + bw + 2; x++) {
+      if (x < 0 || y < 0 || x >= w || y >= h) continue;
+      if (x >= bx && x < bx + bw && y >= by && y < by + bh) continue;
+      ring++; if (cockpitMask[y * w + x]) onCockpit++;
+    }
+    c.cockpitRingFraction = ring ? Number((onCockpit / ring).toFixed(3)) : null;
+  }
+  return { label, aperturePixels: apPx, cockpitMaskApplied: !!cockpitMask,
+    aperturePeakLuminance: Number(apPeak.toFixed(1)), aperturePeakAt: apPeakAt,
+    warmPixelsInAperture: warmPx, coolMagentaPixelsInAperture: coolPx,
+    neutralLitPixelsInAperture: neutralLit,
+    warmClusters: comps.length, clusters: comps.slice(0, 8) };
+}
+
+export function skyMask(img, pitchDeg, fovVDeg) {
+  // A light source above the horizon is a SKY source. The mask is geometric,
+  // not a colour guess: for a roll-free surface camera (the shipped free-look
+  // keeps the horizon level) the ray through each pixel has a closed-form
+  // altitude, so "above the horizon" is derivable from the recorded pitch and
+  // lens alone and does not depend on where anything happens to sit.
+  const { w, h } = img;
+  const p = (pitchDeg * Math.PI) / 180;
+  const tV = Math.tan((fovVDeg * Math.PI) / 180 / 2);
+  const tH = tV * (w / h);
+  const m = new Uint8Array(w * h);
+  let n = 0;
+  for (let y = 0; y < h; y++) {
+    const ndcY = 1 - (2 * (y + 0.5)) / h;
+    for (let x = 0; x < w; x++) {
+      const ndcX = (2 * (x + 0.5)) / w - 1;
+      const rx = ndcX * tH, ry = ndcY * tV;
+      // frame: worldUp=(0,1,0); F=(0,sin p,cos p); U=(0,cos p,-sin p); R=(1,0,0)
+      const dy = ry * Math.cos(p) + Math.sin(p);
+      const dz = -ry * Math.sin(p) + Math.cos(p);
+      const len = Math.hypot(rx, dy, dz);
+      if (dy / len > 0) { m[y * w + x] = 1; n++; }
+    }
+  }
+  return { mask: m, skyPixels: n, pitchDeg, fovVDeg };
+}
+
+export function pointSourceLaw(img, st0Px, sky) {
+  const { w, h, rgb } = img;
+  const scale = 1280 / w;
+  // ST-0's own peak, measured at its PROJECTED pixel rather than by hoping a
+  // threshold finds it: a 2.4-device-pixel quad can sit below any global cut.
+  let st0Peak = -1, st0PeakAt = null, st0Above60 = 0;
+  const R = 6;
+  for (let dy = -R; dy <= R; dy++) for (let dx = -R; dx <= R; dx++) {
+    const x = st0Px[0] + dx, y = st0Px[1] + dy;
+    if (x < 0 || y < 0 || x >= w || y >= h) continue;
+    const i = (y * w + x) * 3;
+    const L = lum(rgb[i], rgb[i + 1], rgb[i + 2]);
+    if (L >= 60) st0Above60++;
+    if (L > st0Peak) { st0Peak = L; st0PeakAt = [x, y]; }
+  }
+  // ST-0's extent, from its own half-peak contour in the same window.
+  let ex0 = 1e9, ex1 = -1, ey0 = 1e9, ey1 = -1, half = st0Peak * 0.5;
+  for (let dy = -R; dy <= R; dy++) for (let dx = -R; dx <= R; dx++) {
+    const x = st0Px[0] + dx, y = st0Px[1] + dy;
+    if (x < 0 || y < 0 || x >= w || y >= h) continue;
+    const i = (y * w + x) * 3;
+    if (lum(rgb[i], rgb[i + 1], rgb[i + 2]) >= half) {
+      if (x < ex0) ex0 = x; if (x > ex1) ex1 = x;
+      if (y < ey0) ey0 = y; if (y > ey1) ey1 = y;
+    }
+  }
+  const st0Extent = ex1 >= 0 ? Math.max(ex1 - ex0 + 1, ey1 - ey0 + 1) : 0;
+  // Every other lit thing ABOVE THE HORIZON, classified by extent first.
+  const bright = new Uint8Array(w * h);
+  let n = 0;
+  for (let i = 0; i < w * h; i++) {
+    if (!sky.mask[i]) continue;
+    const L = lum(rgb[i * 3], rgb[i * 3 + 1], rgb[i * 3 + 2]);
+    if (L >= 60) { bright[i] = 1; n++; }
+  }
+  const comps = components(bright, w, h, 1).map(px => describe(px, w, rgb));
+  for (const c of comps) c.extentPxAt1280 = Number((c.extentPx * scale).toFixed(2));
+  const isSt0 = (c) => Math.hypot(c.centroid[0] - st0Px[0], c.centroid[1] - st0Px[1]) <= 4;
+  const points = comps.filter(c => c.extentPxAt1280 <= 8 && !isSt0(c))
+    .sort((a, b) => b.peakLuminance - a.peakLuminance);
+  const discs = comps.filter(c => c.extentPxAt1280 > 8 && !isSt0(c))
+    .sort((a, b) => b.peakLuminance - a.peakLuminance);
+  return { skyPixels: sky.skyPixels, pitchDeg: sky.pitchDeg, fovVDeg: sky.fovVDeg,
+    litSkyPixels: n, skySources: comps.length,
+    pointSources: points.length, discSources: discs.length,
+    st0ProjectedPx: st0Px, st0PeakLuminance: Number(st0Peak.toFixed(1)),
+    st0PeakAt: st0PeakAt, st0PixelsAbove60: st0Above60,
+    st0ExtentPx: st0Extent, st0ExtentPxAt1280: Number((st0Extent * scale).toFixed(2)),
+    brightestPointSource: points[0] ?? null,
+    brightestDisc: discs[0] ?? null,
+    st0BeatsBrightestPointSource: points[0] ? st0Peak > points[0].peakLuminance : true,
+    st0BelowBrightestDisc: discs[0] ? st0Peak < discs[0].peakLuminance : null,
+    topPointSources: points.slice(0, 8), topDiscs: discs.slice(0, 4) };
+}
+
+export function bandOccupancy(img, mask) {
+  // "terrain horizon and the hearth emissive cluster occupy the bottom 20%"
+  const { w, h, rgb } = img;
+  const y0 = Math.floor(h * 0.8);
+  let lit = 0, warm = 0, total = 0, peak = -1, peakAt = null;
+  for (let y = y0; y < h; y++) for (let x = 0; x < w; x++) {
+    const i = y * w + x; total++;
+    const c = hsv(rgb[i * 3], rgb[i * 3 + 1], rgb[i * 3 + 2]);
+    const L = lum(rgb[i * 3], rgb[i * 3 + 1], rgb[i * 3 + 2]);
+    if (c.v >= 0.06) lit++;
+    if (WARM(c) && c.v >= 0.15) warm++;
+    if (L > peak) { peak = L; peakAt = [x, y]; }
+  }
+  void mask;
+  return { bandTopY: y0, bandPixels: total, litPixels: lit,
+    litFraction: Number((lit / total).toFixed(4)),
+    warmPixels: warm, warmFraction: Number((warm / total).toFixed(4)),
+    peakLuminance: Number(peak.toFixed(1)), peakAt };
+}
+
+export function borderRing(img, ringPx = 2) {
+  const { w, h, rgb } = img;
+  let peak = -1, sum = 0, n = 0, peakAt = null;
+  const touch = (x, y) => { const i = (y * w + x) * 3;
+    const L = lum(rgb[i], rgb[i + 1], rgb[i + 2]);
+    if (L > peak) { peak = L; peakAt = [x, y]; } sum += L; n++; };
+  for (let y = 0; y < h; y++) for (let k = 0; k < ringPx; k++) { touch(k, y); touch(w - 1 - k, y); }
+  for (let x = 0; x < w; x++) for (let k = 0; k < ringPx; k++) { touch(x, k); touch(x, h - 1 - k); }
+  return { ringPx, samples: n, peakLuminance: Number(peak.toFixed(1)),
+    meanLuminance: Number((sum / n).toFixed(2)), peakAt };
+}
+
diff --git a/main/tools/lib/previewServer.mjs b/main/tools/lib/previewServer.mjs
new file mode 100644
index 0000000..e8dca51
--- /dev/null
+++ b/main/tools/lib/previewServer.mjs
@@ -0,0 +1,150 @@
+// --- Self-served Paravoxia preview for probes --------------------------------------
+//
+// Every browser probe that measures the game must serve the game itself and
+// prove it is measuring the right program. On 2026-09-04 a probe pointed at a
+// fixed port measured a DIFFERENT PROJECT after that port was taken over: it
+// returned 200, rendered a real app, and nothing looked wrong. So this picks a
+// free port and refuses to hand back a URL until the page served there carries
+// `<title>Paravoxia</title>`.
+//
+//   const preview = await startParavoxiaPreview({ build: true });
+//   try { ... probe against preview.url ... } finally { preview.stop(); }
+
+import { spawn } from 'node:child_process';
+import { createServer } from 'node:net';
+import process from 'node:process';
+
+export function freePort() {
+  return new Promise((resolve, reject) => {
+    const server = createServer();
+    server.unref();
+    server.on('error', reject);
+    server.listen(0, '127.0.0.1', () => {
+      const { port } = server.address();
+      server.close(() => resolve(port));
+    });
+  });
+}
+
+export async function waitForParavoxia(url, timeoutMs = 60_000) {
+  const deadline = Date.now() + timeoutMs;
+  let lastError = 'no response';
+  while (Date.now() < deadline) {
+    try {
+      const response = await fetch(url);
+      const body = await response.text();
+      if (body.includes('<title>Paravoxia</title>')) return;
+      lastError = `served a page that is not Paravoxia (${body.length} bytes)`;
+    } catch (error) {
+      lastError = String(error?.message ?? error);
+    }
+    await new Promise(resolve => setTimeout(resolve, 500));
+  }
+  throw new Error(`Preview server never served Paravoxia at ${url}: ${lastError}`);
+}
+
+export function run(command, args, env = {}) {
+  return new Promise((resolve, reject) => {
+    const child = spawn(command, args, { stdio: 'inherit', env: { ...process.env, ...env } });
+    child.on('error', reject);
+    child.on('exit', code => resolve(code ?? 1));
+  });
+}
+
+/**
+ * Build (optionally), start `vite preview` on a free port, verify identity, and
+ * return `{ url, port, stop }`. Honours `PARAVOXIA_URL` as an override for
+ * callers that deliberately point at an already-running server — the identity
+ * check still runs against it.
+ */
+export async function startParavoxiaPreview({ build = true, log = console.log } = {}) {
+  if (process.env.PARAVOXIA_URL) {
+    const url = process.env.PARAVOXIA_URL;
+    await waitForParavoxia(url, 15_000);
+    log(`[preview] using ${url} (identity confirmed)`);
+    return { url, port: null, stop() {} };
+  }
+  if (build) {
+    log('[preview] building…');
+    const code = await run('npm', ['run', 'build']);
+    if (code !== 0) throw new Error(`build failed (${code})`);
+  }
+  const port = await freePort();
+  const url = `http://127.0.0.1:${port}/`;
+  // Spawn vite's own binary in its OWN PROCESS GROUP. The previous shape —
+  // `npx vite preview` — meant `child.kill()` killed the npx wrapper and left
+  // the real vite process alive: six orphaned previews were found after one
+  // run of probes, on a machine already under memory pressure. Killing the
+  // group (negative pid) takes the whole tree down.
+  const viteBin = new URL('../../node_modules/vite/bin/vite.js', import.meta.url).pathname;
+  const child = spawn(process.execPath, [viteBin, 'preview', '--port', String(port), '--strictPort'], {
+    stdio: 'ignore',
+    env: process.env,
+    detached: true
+  });
+  try {
+    await waitForParavoxia(url);
+  } catch (error) {
+    child.kill('SIGTERM');
+    throw error;
+  }
+  log(`[preview] serving Paravoxia at ${url}`);
+  // A probe that crashes or is killed must not leave the server behind: nine
+  // orphaned previews were found running after a session of probe failures.
+  const stop = () => {
+    if (child.killed) return;
+    try { process.kill(-child.pid, 'SIGTERM'); } catch { child.kill('SIGTERM'); }
+  };
+  process.once('exit', stop);
+  for (const signal of ['SIGINT', 'SIGTERM', 'SIGHUP']) {
+    process.once(signal, () => { stop(); process.exit(130); });
+  }
+  return { url, port, stop };
+}
+
+/**
+ * Chromium launch args shared by every probe on this machine.
+ *
+ * `--use-gl=angle` is load-bearing. Without it, headless Chromium on this box
+ * fell back to SwiftShader and a cold-boot profile showed a 20-24 SECOND
+ * `(program)` block — synchronous software shader compilation — that the real
+ * GPU never produces. That number looked like an application bug for an hour.
+ * `assertHardwareGl` below is the guard: a probe must know what rendered it.
+ */
+export const CHROMIUM_ARGS = [
+  '--no-sandbox',
+  '--disable-dev-shm-usage',
+  '--ignore-gpu-blocklist',
+  '--enable-webgl',
+  '--use-gl=angle',
+  '--enable-unsafe-swiftshader',
+  '--autoplay-policy=no-user-gesture-required',
+  '--mute-audio',
+  '--disable-background-timer-throttling',
+  '--disable-renderer-backgrounding'
+];
+
+export function chromePath() {
+  return process.env.CHROME_PATH ?? '/snap/bin/chromium';
+}
+
+/**
+ * Read the WebGL renderer string from a page and refuse to proceed on a
+ * software renderer unless `PARAVOXIA_ALLOW_SWIFTSHADER=1`. Measurements taken
+ * on SwiftShader are measurements of SwiftShader.
+ */
+export async function assertHardwareGl(page, log = console.log) {
+  const renderer = await page.evaluate(() => {
+    const canvas = document.createElement('canvas');
+    const gl = canvas.getContext('webgl2') ?? canvas.getContext('webgl');
+    if (!gl) return null;
+    const info = gl.getExtension('WEBGL_debug_renderer_info');
+    return info ? gl.getParameter(info.UNMASKED_RENDERER_WEBGL) : gl.getParameter(gl.RENDERER);
+  });
+  log(`[gl] renderer: ${renderer}`);
+  const software = !renderer || /swiftshader|software|llvmpipe/i.test(renderer);
+  if (software && process.env.PARAVOXIA_ALLOW_SWIFTSHADER !== '1') {
+    throw new Error(`Software WebGL renderer (${renderer}); set PARAVOXIA_ALLOW_SWIFTSHADER=1 to measure it anyway`);
+  }
+  return renderer;
+}
diff --git a/main/tools/mood-voicing-evidence.ts b/main/tools/mood-voicing-evidence.ts
new file mode 100644
index 0000000..967415a
--- /dev/null
+++ b/main/tools/mood-voicing-evidence.ts
@@ -0,0 +1,92 @@
+// Stage 3 MOODS-as-constraints evidence (pure): for every authored mood entry,
+// the literal progression versus the brain voicing under the entry's policy —
+// per-change max voice displacement before/after, pitch-class superset, bass =
+// root, tight-interval preservation, and the a4 order. Run with vite-node:
+//   npx vite-node tools/mood-voicing-evidence.ts > evidence/stage-3/mood-voicing.json
+import {
+  chordPitchClasses,
+  deriveMoodConstraint,
+  resolveMoodVoicingSequence,
+  tightIntervals,
+  voiceDisplacement
+} from '../src/audio/generative/moodConstraint.ts';
+import {
+  listStoryScoreMoodInventory,
+  MOOD_DEFAULT_VOICING,
+  resolveMoodVoicingPolicy
+} from '../src/story/storyScore.ts';
+
+const PAD_VOICES = 4;
+const rows = listStoryScoreMoodInventory().map((entry) => {
+  const policy = resolveMoodVoicingPolicy(entry.beat);
+  const literalC = deriveMoodConstraint(entry.mood, 0, 'literal', PAD_VOICES);
+  const brainC = deriveMoodConstraint(entry.mood, 0, policy, PAD_VOICES);
+  // Two full cycles: the wrap (last → first) is a change the live scheduler makes.
+  const literal = resolveMoodVoicingSequence(literalC, 2);
+  const voiced = resolveMoodVoicingSequence(brainC, 2);
+  const perChange = literal.slice(1).map((_, k) => {
+    const i = k;
+    const j = k + 1;
+    return {
+      from: i,
+      to: j,
+      literalMax: voiceDisplacement(literal[i].slice(1, PAD_VOICES), literal[j].slice(1, PAD_VOICES)).max,
+      brainMax: voiceDisplacement(voiced[i].slice(1, PAD_VOICES), voiced[j].slice(1, PAD_VOICES)).max,
+      literalTotal: voiceDisplacement(literal[i].slice(1, PAD_VOICES), literal[j].slice(1, PAD_VOICES)).total,
+      brainTotal: voiceDisplacement(voiced[i].slice(1, PAD_VOICES), voiced[j].slice(1, PAD_VOICES)).total
+    };
+  });
+  const pcsKept = voiced.every((v, i) => chordPitchClasses(v).join(',') === chordPitchClasses(literal[i]).join(','));
+  const bassKept = voiced.every((v, i) => v[0] === literal[i][0]);
+  const tightKept = voiced.every((v, i) =>
+    tightIntervals(v.slice(0, PAD_VOICES)).join(',') === tightIntervals(literal[i].slice(0, PAD_VOICES)).join(',')
+  );
+  const changed = voiced.some((v, i) => v.join(',') !== literal[i].join(','));
+  const chords = literalC.chordSequence.length;
+  return {
+    name: entry.name,
+    beat: entry.beat,
+    policy,
+    effectivePolicy: brainC.voicingPolicy,
+    brainGuard: brainC.brainGuard,
+    chords,
+    changed,
+    maxVoiceDisplacementBefore: Math.max(0, ...perChange.map((c) => c.literalMax)),
+    maxVoiceDisplacementAfter: Math.max(0, ...perChange.map((c) => c.brainMax)),
+    totalDisplacementBefore: perChange.reduce((a, c) => a + c.literalTotal, 0),
+    totalDisplacementAfter: perChange.reduce((a, c) => a + c.brainTotal, 0),
+    neverWorsePerChange: perChange.every((c) => c.brainMax <= c.literalMax),
+    pitchClassSetKept: pcsKept,
+    bassRootKept: bassKept,
+    tightIntervalsKept: tightKept,
+    literal,
+    voiced,
+    perChange
+  };
+});
+
+const progressionRows = rows.filter((r) => r.chords > 1);
+const brainRows = progressionRows.filter((r) => r.policy === 'brain');
+const guarded = brainRows.filter((r) => r.effectivePolicy === 'literal');
+const summary = {
+  generatedAt: new Date().toISOString(),
+  defaultPolicy: MOOD_DEFAULT_VOICING,
+  moods: rows.length,
+  withProgression: progressionRows.length,
+  brainVoiced: brainRows.length,
+  changedByBrain: brainRows.filter((r) => r.changed).length,
+  demotedByGainGuard: guarded.map((r) => ({ name: r.name, reason: r.brainGuard })),
+  literalOrOverride: rows.length - brainRows.length,
+  allPitchClassSetsKept: rows.every((r) => r.pitchClassSetKept),
+  allBassRootsKept: rows.every((r) => r.bassRootKept),
+  allTightIntervalsKept: rows.every((r) => r.tightIntervalsKept),
+  maxVoiceDisplacementBefore: Math.max(0, ...progressionRows.map((r) => r.maxVoiceDisplacementBefore)),
+  maxVoiceDisplacementAfter: Math.max(0, ...progressionRows.map((r) => r.maxVoiceDisplacementAfter)),
+  meanMaxDisplacementBefore: progressionRows.reduce((a, r) => a + r.maxVoiceDisplacementBefore, 0) / Math.max(1, progressionRows.length),
+  meanMaxDisplacementAfter: progressionRows.reduce((a, r) => a + r.maxVoiceDisplacementAfter, 0) / Math.max(1, progressionRows.length),
+  neverWorse: progressionRows.every((r) => r.neverWorsePerChange),
+  totalDisplacementBefore: progressionRows.reduce((a, r) => a + r.totalDisplacementBefore, 0),
+  totalDisplacementAfter: progressionRows.reduce((a, r) => a + r.totalDisplacementAfter, 0),
+  rows
+};
+process.stdout.write(JSON.stringify(summary, null, 2));
