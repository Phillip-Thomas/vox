        {
          "markerLabel": "POND RESPONSE · RESOLVED",
          "workOrder": [
            "REMAIN WITH THE RESONANCE.",
            "LET THE STRUCTURE SETTLE."
          ]
        }
      ],
      "captions": [
        "(it does not wake hungry. it wakes listening.)",
        "(you lower it. the world supplies no order.)",
        "(it cuts. the world supplies no order.)",
        "(the world supplies no order. direction was yours.)",
        "(the pond answers in structure, not instruction.)"
      ],
      "captionSelectionNote": "The three middle captions are exclusive branches on the recorded first-direction choice."
    },
    "B2_ch6-dive": {
      "entryCaption": "(the repaired tool has marked something beneath the water.)",
      "completionCaption": "(returned with breath. returned with a way to leave.)"
    },
    "B3_ch7-reconstruct_and_board": {
      "entryCaptionReconstruct": "(repair is not return.)",
      "wreckRelayLine": {
        "channel": "auditBand",
        "header": "WRECK RELAY",
        "text": "HULL AT SITE 7C-θ · FILED: TOTAL LOSS · FILE CLOSED"
      },
      "M1Caption": "the wreck that brought me here will leave here. i will build the leaving.",
      "auditNetworkAtCalibration": {
        "channel": "auditBand",
        "header": "AUDIT NETWORK",
        "text": "UNSCHEDULED HULL · SITE 7C-θ · INTEREST RAISED"
      },
      "postCalibrationCaptions": [
        "nothing has asked yet. something has started paying attention.",
        "the scar remains. now it can carry me."
      ],
      "entryCaptionBoard": "(the wreck is waiting for an owner.)"
    },
    "B4_ch8-launch_crossing_landfall": {
      "launchCaptionsInSlotOrder": [
        "the pond answered every time i asked. i am leaving anyway — that is what the answers were for.",
        "hold it. this is the only order left, and i am the one giving it.",
        "the site gets small. the tree does not. i keep finding it.",
        "i came down this line without being asked. i am going back up it on purpose."
      ],
      "auditNetworkStack": [
        "AUTOMATED CONTACT · SITE 7C-θ · HULL LOGGED: DESTROYED",
        "REGISTRY QUERY · STATE DESIGNATION.",
        "NO DESIGNATION RETURNED.",
        "CONTACT LOGGED."
      ],
      "postStackCaptions": [
        "they asked for a designation. what i have is not one.",
        "nothing answers. the query does not close."
      ],
      "crossingEntryCaption": "(there is another world here. it was always here.)",
      "landfallCaption": "(a world does not begin when you see it. it begins when it holds your weight.)"
    },
