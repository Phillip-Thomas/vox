        "text": "AN AUDITOR HAS BEEN DISPATCHED TO ASSESS SITE LOSS."
      },
      {
        "seq": 2,
        "channel": "system",
        "text": "REMAIN AT THE WRECK. DO NOT PRODUCE. DO NOT CONSUME. DO NOT OBSERVE."
      },
      {
        "seq": 3,
        "channel": "system",
        "text": "SLEEP IS SCHEDULED AT DARK. COMPLIANCE WILL BE VERIFIED."
      },
      {
        "seq": 4,
        "channel": "caption",
        "text": "they schedule the dark now. last night the dark was mine."
      },
      {
        "seq": 5,
        "channel": "caption",
        "text": "rest. it is ordered. i would have anyway."
      }
    ],
    "A2_arrival_ch4-arrival_timeline_ordered": [
