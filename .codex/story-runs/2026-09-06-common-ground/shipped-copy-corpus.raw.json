        "seq": 1,
        "atSeconds": 7,
        "channel": "caption",
        "text": "someone is coming out of the sunrise. someone else exists."
      },
      {
        "seq": 2,
        "atSeconds": 20,
        "channel": "caption",
        "text": "he walks like the feed looks. straight lines."
      },
      {
        "seq": 3,
        "atSeconds": 31,
        "channel": "auditBand",
        "header": "W-7744 · FIELD AUDIT",
        "speaker": "W-7744",
        "text": "WORKER W-7743. YOU ARE FOUND."
      },
      {
        "seq": 4,
        "atSeconds": 34.5,
        "channel": "auditBand",
        "header": "W-7744 · FIELD AUDIT",
        "speaker": "W-7744",
        "text": "THIS SITE REPORTS ZERO PRODUCTIVITY FOR TWO CYCLES. EXPLAIN NOTHING. I WILL SEE FOR MYSELF."
      },
      {
        "seq": 5,
        "atSeconds": 39.2,
        "channel": "caption",
        "text": "for a blink i borrowed his seeing. slabs. flat light. i lived there."
      },
      {
        "seq": 6,
