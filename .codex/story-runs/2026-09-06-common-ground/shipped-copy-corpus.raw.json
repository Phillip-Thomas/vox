        {
          "markerLabel": "W-7744 FIELD PACK · REPAIR MAW",
          "workOrder": [
            "REMAIN AT THE OPEN FIELD PACK.",
            "HOLD POSITION UNTIL THE MAW REPAIR COMPLETES."
          ]
        },
        {
          "markerLabel": "REPAIRED MAW · LISTEN",
          "workOrder": [
            "REMAIN WITH THE REPAIRED MAW.",
            "WAIT. LISTEN BEFORE ASSIGNING IT A PURPOSE."
