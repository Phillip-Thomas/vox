        {
          "markerLabel": "POND RESPONSE · ATTEND",
          "workOrder": [
            "FOLLOW THE RESPONSE TO THE DRY SHORE.",
            "WATCH IT, OR [F] ATTEND THE POND RESPONSE."
          ]
