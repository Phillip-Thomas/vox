{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paravoxia.local/schemas/paravoxia-scene-contract.schema.json",
  "title": "Paravoxia Scene Contract v1",
  "description": "The signed cross-domain implementation handoff for one Paravoxia scene or bounded scene delta.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sceneId",
    "contractVersion",
    "status",
    "production",
    "scope",
    "story",
    "syncAnchors",
    "cinematography",
    "palette",
    "shots",
    "score",
    "variants",
    "performance",
    "reset",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "paravoxia.sceneContract.v1"
    },
    "sceneId": {
      "$ref": "#/$defs/stableId"
    },
    "contractVersion": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "status": {
      "enum": [
        "draft",
        "candidate",
        "frozen",
        "superseded"
      ]
    },
    "supersedesVersion": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "production": {
      "$ref": "#/$defs/production"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "story": {
      "$ref": "#/$defs/story"
    },
    "syncAnchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/syncAnchor"
      }
    },
    "cinematography": {
      "$ref": "#/$defs/cinematography"
    },
    "palette": {
      "$ref": "#/$defs/palette"
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/shot"
      }
    },
    "score": {
      "$ref": "#/$defs/score"
    },
    "variants": {
      "$ref": "#/$defs/variants"
    },
    "performance": {
      "$ref": "#/$defs/performance"
    },
    "reset": {
      "$ref": "#/$defs/reset"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "refList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "authorityRefs",
        "productionLockRef",
        "mutationBoundary",
        "allowedPaths",
        "protectedPaths",
        "ownerDecisionRefs",
        "canonicalPreviewUrl"
      ],
      "properties": {
        "mode": {
          "enum": [
            "delta",
            "scene",
            "chapter",
            "flagship"
          ]
        },
        "authorityRefs": {
          "$ref": "#/$defs/refList"
        },
        "productionLockRef": {
          "$ref": "#/$defs/ref"
        },
        "mutationBoundary": {
          "enum": [
            "planning-only",
            "bounded-runtime",
            "full-scene-runtime"
          ]
        },
        "allowedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "protectedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "ownerDecisionRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "canonicalPreviewUrl": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "uri"
            }
          ]
        },
        "frozenAt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "beats",
        "shippedReferenceRefs",
        "priorEvidenceRefs",
        "targetDevices",
        "targetQualityTiers",
        "nonGoals"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "beats": {
          "$ref": "#/$defs/refList"
        },
        "shippedReferenceRefs": {
          "$ref": "#/$defs/refList"
        },
        "priorEvidenceRefs": {
          "$ref": "#/$defs/refList"
        },
        "targetDevices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "desktop",
              "mobile",
              "tablet"
            ]
          }
        },
        "targetQualityTiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "high",
              "medium",
              "low",
              "potato"
            ]
          }
        },
        "nonGoals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentRef",
        "purpose",
        "emotionalBefore",
        "emotionalAfter",
        "intendedAmbiguity",
        "nonNegotiableCanon",
        "realityStageCeiling",
        "characterDynamics",
        "revealLedger",
        "events",
        "agencyWindows"
      ],
      "properties": {
        "intentRef": {
          "$ref": "#/$defs/ref"
        },
        "purpose": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "emotionalBefore": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "emotionalAfter": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "intendedAmbiguity": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "nonNegotiableCanon": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "realityStageCeiling": {
          "$ref": "#/$defs/realityStage"
        },
        "characterDynamics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/characterDynamic"
          }
        },
        "revealLedger": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/revealEntry"
          }
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/storyEvent"
          }
        },
        "agencyWindows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/agencyWindow"
          }
        }
      }
    },
    "characterDynamic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "characterRef",
        "desire",
        "opposition",
        "tactic",
        "beliefBefore",
        "beliefAfter",
        "playerVisibleEvidenceRefs",
        "revealRefs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "characterRef": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "desire": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "opposition": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "tactic": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "beliefBefore": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "beliefAfter": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "playerVisibleEvidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "revealRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "revealEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "levelBefore",
        "levelAfter",
        "setupRefs",
        "payoffRefs",
        "playerEvidence",
        "protectedQuestion"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "subject": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "levelBefore": {
          "$ref": "#/$defs/revealLevel"
        },
        "levelAfter": {
          "$ref": "#/$defs/revealLevel"
        },
        "setupRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "payoffRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "playerEvidence": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "protectedQuestion": {
          "type": "boolean"
        }
      }
    },
    "revealLevel": {
      "enum": [
        "author-only",
        "contracted-future",
        "player-visible",
        "player-inference",
        "protected-open",
        "resolved"
      ]
    },
    "storyEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "beat",
        "anchorRef",
        "event",
        "playerAction",
        "stateBeforeRefs",
        "stateAfterRefs",
        "causeRefs",
        "payoffRefs",
        "revealRefs",
        "informationRevealed",
        "acceptanceCriterion"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "beat": {
          "$ref": "#/$defs/ref"
        },
        "anchorRef": {
          "$ref": "#/$defs/stableId"
        },
        "event": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "playerAction": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stateBeforeRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "stateAfterRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "causeRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "payoffRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "revealRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "informationRevealed": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "acceptanceCriterion": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "agencyWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "startAnchorRef",
        "endAnchorRef",
        "movement",
        "look",
        "interaction",
        "agencyType",
        "mandatoryPath",
        "fallbackAllowed",
        "fallbackSemantics",
        "fallbackCountsAsNarrativeAcceptance",
        "rescueAllowed",
        "rescueSemantics",
        "rescueCountsAsNarrativeAcceptance",
        "motivation",
        "handBack",
        "pauseBehavior",
        "focusLossBehavior",
        "replayBehavior",
        "mobileBehavior",
        "reducedMotionBehavior"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "startAnchorRef": {
          "$ref": "#/$defs/stableId"
        },
        "endAnchorRef": {
          "$ref": "#/$defs/stableId"
        },
        "movement": {
          "$ref": "#/$defs/controlAuthority"
        },
        "look": {
          "$ref": "#/$defs/controlAuthority"
        },
        "interaction": {
          "$ref": "#/$defs/controlAuthority"
        },
        "agencyType": {
          "$ref": "#/$defs/agencyType"
        },
        "mandatoryPath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fallbackAllowed": {
          "type": "boolean"
        },
        "fallbackSemantics": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fallbackCountsAsNarrativeAcceptance": {
          "const": false
        },
        "rescueAllowed": {
          "type": "boolean"
        },
        "rescueSemantics": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rescueCountsAsNarrativeAcceptance": {
          "const": false
        },
        "motivation": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "handBack": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "pauseBehavior": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "focusLossBehavior": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "replayBehavior": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "mobileBehavior": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reducedMotionBehavior": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "agencyType": {
      "enum": [
        "choice",
        "authored-rite",
        "mandatory-action",
        "observation"
      ]
    },
    "controlAuthority": {
      "enum": [
        "player",
        "director",
        "blended",
        "disabled"
      ]
    },
    "syncAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "beat",
        "order",
        "event",
        "source",
        "story",
        "score",
        "cinematography",
        "acceptanceCriterion"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "beat": {
          "$ref": "#/$defs/ref"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "event": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source": {
          "enum": [
            "story-event",
            "player-action",
            "camera-event",
            "score-event",
            "runtime-event"
          ]
        },
        "story": {
          "$ref": "#/$defs/storyAnchorRelation"
        },
        "score": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scoreAnchorRelation"
          }
        },
        "cinematography": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/cinematographyAnchorRelation"
          }
        },
        "acceptanceCriterion": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "storyAnchorRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventRef",
        "relation",
        "offsetMs"
      ],
      "properties": {
        "eventRef": {
          "$ref": "#/$defs/stableId"
        },
        "relation": {
          "$ref": "#/$defs/anchorRelation"
        },
        "offsetMs": {
          "type": "number"
        }
      }
    },
    "scoreAnchorRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cueRef",
        "relation",
        "offsetMs",
        "musicalIntent"
      ],
      "properties": {
        "cueRef": {
          "$ref": "#/$defs/stableId"
        },
        "relation": {
          "$ref": "#/$defs/anchorRelation"
        },
        "offsetMs": {
          "type": "number"
        },
        "musicalIntent": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "cinematographyAnchorRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shotRef",
        "relation",
        "offsetMs",
        "visualIntent"
      ],
      "properties": {
        "shotRef": {
          "$ref": "#/$defs/stableId"
        },
        "relation": {
          "$ref": "#/$defs/anchorRelation"
        },
        "offsetMs": {
          "type": "number"
        },
        "visualIntent": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "anchorRelation": {
      "enum": [
        "at",
        "before",
        "after",
        "through",
        "until"
      ]
    },
    "cinematography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "treatmentRef",
        "thesis",
        "currentCutRefs",
        "adjacentSceneRefs",
        "cameraLineage",
        "paletteRef",
        "shotOrder"
      ],
      "properties": {
        "treatmentRef": {
          "$ref": "#/$defs/ref"
        },
        "thesis": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "currentCutRefs": {
          "$ref": "#/$defs/refList"
        },
        "adjacentSceneRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "cameraLineage": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/cameraAuthority"
          }
        },
        "paletteRef": {
          "$ref": "#/$defs/stableId"
        },
        "shotOrder": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "sourceRefs",
        "semanticRoles",
        "continuityRefs",
        "focalAccent",
        "anomaly"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "family": {
          "enum": [
            "phosphor-transit",
            "regulation-mono",
            "chroma-breach",
            "embodied-noon",
            "fire-night",
            "material-dawn",
            "audit-return",
            "planet-derived"
          ]
        },
        "sourceRefs": {
          "$ref": "#/$defs/refList"
        },
        "semanticRoles": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/paletteRole"
          }
        },
        "continuityRefs": {
          "$ref": "#/$defs/refList"
        },
        "focalAccent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "roleRef",
            "scarcityIntent"
          ],
          "properties": {
            "roleRef": {
              "$ref": "#/$defs/stableId"
            },
            "scarcityIntent": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        "anomaly": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "brokenRule",
                "storyReason"
              ],
              "properties": {
                "brokenRule": {
                  "$ref": "#/$defs/nonEmptyString"
                },
                "storyReason": {
                  "$ref": "#/$defs/nonEmptyString"
                }
              }
            }
          ]
        }
      }
    },
    "paletteRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "valueRef",
        "usage"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "role": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "valueRef": {
          "$ref": "#/$defs/ref"
        },
        "hex": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          ]
        },
        "usage": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "beat",
        "startAnchorRef",
        "endAnchorRef",
        "focalHierarchy",
        "cameraAuthority",
        "framing",
        "lens",
        "motion",
        "transition",
        "paletteRef",
        "effects",
        "agency",
        "variantRefs",
        "resetRef",
        "evidenceRefs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "beat": {
          "$ref": "#/$defs/ref"
        },
        "startAnchorRef": {
          "$ref": "#/$defs/stableId"
        },
        "endAnchorRef": {
          "$ref": "#/$defs/stableId"
        },
        "focalHierarchy": {
          "$ref": "#/$defs/focalHierarchy"
        },
        "cameraAuthority": {
          "$ref": "#/$defs/cameraAuthority"
        },
        "framing": {
          "$ref": "#/$defs/framing"
        },
        "lens": {
          "$ref": "#/$defs/lens"
        },
        "motion": {
          "$ref": "#/$defs/cameraMotion"
        },
        "transition": {
          "$ref": "#/$defs/transition"
        },
        "paletteRef": {
          "$ref": "#/$defs/stableId"
        },
        "effects": {
          "$ref": "#/$defs/effects"
        },
        "agency": {
          "$ref": "#/$defs/shotAgency"
        },
        "variantRefs": {
          "$ref": "#/$defs/refList"
        },
        "resetRef": {
          "$ref": "#/$defs/stableId"
        },
        "evidenceRefs": {
          "$ref": "#/$defs/refList"
        }
      }
    },
    "focalHierarchy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary",
        "allowedAmbiguity",
        "subjectOccupancyIntent",
        "horizonIntent",
        "negativeSpaceIntent"
      ],
      "properties": {
        "primary": {
