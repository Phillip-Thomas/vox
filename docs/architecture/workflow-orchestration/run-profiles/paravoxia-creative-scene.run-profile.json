{
  "schema": "terra.runProfile.v1",
  "identity": { "slug": "paravoxia-creative-scene", "name": "Paravoxia Creative Scene", "version": "v1" },
  "domain": "audiovisual_game_direction",
  "mode": "three_director_scene",
  "executionBudget": {
    "tier": "standard",
    "maxModelCalls": 28,
    "maxPatchLoops": 3,
