    "categoryFloor": 4.3,
    "stagedGate": "final",
    "humanTasteApproval": { "required": false, "requiresHeadedRealGpuEvidence": false, "cannotBeInferredFromModelReview": true },
    "publishRequiresSeparateDecision": true
  },
  "autonomousLoopPolicy": {
    "enabled": true,
    "routeOpenDefectsToOwningLane": true,
    "stopWhenScoreStallsForLoops": 2,
