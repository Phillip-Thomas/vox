{
  "schema": "terra.runProfile.v1",
  "identity": { "slug": "paravoxia-story-reconciliation", "name": "Paravoxia Existing Story Reconciliation", "version": "v1" },
  "domain": "story_authority_and_plot_development",
  "mode": "three_director_story_reconciliation",
  "executionBudget": {
    "tier": "deep",
    "maxModelCalls": 32,
    "maxPatchLoops": 3,
    "maxIndependentReviewPasses": 2,
    "preferDeterministicChecksBeforeModelCritique": true,
    "spendMostModelTokensOnBlindReadDirectorsAndCohesionJudge": true
  },
  "exploration": {
    "depth": 3,
    "minimumDirections": 2,
    "requireCurrentAuthority": true,
    "requireRuntimeAndCopyInventory": true,
    "requireBlindReaderIsolation": true,
    "requireIndependentDirectorTreatments": true,
    "requireDistinctCorrectionTheses": true
  },
  "approval": {
    "weightedScoreThreshold": 4.7,
    "categoryFloor": 4.25,
    "stagedGate": "final",
    "ownerDecisionRequiredFor": ["copy_change", "canon_change", "scope_expansion", "open_ontology_resolution", "material_taste_tie"],
    "publishRequiresSeparateDecision": true
  },
  "autonomousLoopPolicy": {
    "enabled": true,
    "routeOpenDefectsToOwningLane": true,
    "maxDocumentationRepairLoops": 3,
    "creativeIntentChangeReopensThreeDirectorCycle": true,
    "runtimeMutationAllowed": false
  },
  "requiredEvidence": [
    "production-lock",
    "story-correction-brief",
    "runtime-story-inventory",
    "shipped-copy-corpus",
    "shipped-audio-baseline",
    "source-of-truth-map",
    "naive-reader-report",
    "canon-audit",
    "contradiction-report",
    "chapter-story-treatment",
    "score-story-treatment",
    "cinematography-story-treatment",
    "chapter-peer-notes",
    "score-peer-notes",
    "cinematography-peer-notes",
    "chapter-reconciliation",
    "score-reconciliation",
    "cinematography-reconciliation",
    "director-notes",
    "chapter-story-signoff",
    "score-story-signoff",
    "cinematography-story-signoff",
    "director-signoffs",
    "owner-story-decision",
    "dissent-register",
    "canon-decision-register",
    "story-authority-candidate",
    "implementation-diff",
    "validation-report",
    "check-results",
    "documentation-audit",
    "alignment-report",
    "cohesion-judge-report",
    "critic-report",
    "defects",
    "final-scorecard",
    "run-summary",
    "lessons-learned"
  ],
  "checkpointPolicy": {
    "checkpointAfterEveryMaterialIteration": true,
    "preserveBlindFirstReport": true,
    "preserveDirectorFirstWave": true,
    "preserveSupersededAuthorityCandidates": true,
    "resumableArtifacts": true
  }
}
