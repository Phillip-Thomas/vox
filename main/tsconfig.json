{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["@react-three/fiber", "three"],
    "allowJs": true,
    "esModuleInterop": true
  },
  "include": ["src/main.tsx", "src/**/*.test.ts", "src/**/*.test.tsx", "src/types.d.ts", "src/audio/soak/soakPage.ts"]
}
